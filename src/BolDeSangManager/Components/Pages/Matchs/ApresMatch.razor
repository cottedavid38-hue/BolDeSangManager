@page "/matchs/{Id:int}/apres-match"
@rendermode InteractiveServer
@attribute [Authorize]
@inject MatchService MatchService
@inject TeamService TeamService
@inject StaffService StaffService
@inject AuthenticationStateProvider AuthProvider
@inject BolDeSangManager.Services.IAuthorizationService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject LeagueNotificationService Notifications
@implements IDisposable

<PageTitle>Après-match — BolDeSang Manager</PageTitle>

@if (_match is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else if (_equipe is null)
{
    <MudAlert Severity="Severity.Error">
        Vous ne participez pas à ce match ou il n'est pas en phase d'après-match.
    </MudAlert>
}
else if (DejaValide())
{
    @if (_match?.Feuille?.CorrigeeLe is DateTime corrigee)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.EditNote">
            Feuille corrigée par un commissaire le
            @corrigee.ToLocalTime().ToString("dd/MM/yyyy à HH'h'mm").
        </MudAlert>
    }
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.CheckCircle">
        Vous avez déjà validé votre après-match.
        @if (_match.Statut == MatchStatus.Termine)
        {
            <span> Le match est maintenant <b>terminé</b>.</span>
        }
        else
        {
            <span> En attente de l'autre coach.</span>
        }
    </MudAlert>
    <MudButton Href="/matchs" Variant="Variant.Text" Class="mt-3">← Retour aux matchs</MudButton>
}
else
{
@if (_match?.Feuille?.ConfirmeeParCommissaireLe is DateTime confirmeeParComm)
        {
            @* Le coach n'a rien confirmé : sans ce bandeau, il découvre un
               après-match ouvert sans savoir pourquoi, et peut croire que
               l'adversaire a validé un score qu'il n'a jamais vu. *@
            <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.Shield">
                <b>Ce match a été confirmé par @_match.Feuille.ConfirmeeParCommissaire</b>,
                commissaire de la ligue, le
                @confirmeeParComm.ToLocalTime().ToString("dd/MM/yyyy à HH'h'mm"),
                sans attendre la confirmation de l'adversaire. Le résultat est définitif —
                contactez le commissaire s'il vous semble incorrect.
            </MudAlert>
        }

@if (_match?.Feuille?.CorrigeeLe is DateTime corrigeeLe)
        {
            @* Le coach arrive souvent par la liste des matchs, sans avoir lu son
               mail : sans ce bandeau, il retrouve un après-match vierge et croit
               à un bug — ou refait des choix en ignorant que les premiers ont
               été annulés. *@
            <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.EditNote">
                <b>Cette feuille a été corrigée par un commissaire</b>
                le @corrigeeLe.ToLocalTime().ToString("dd/MM/yyyy à HH'h'mm").
                @if (ScoreAChange())
                {
                    <span>
                        Le score est passé de
                        <b>@_match.Feuille.ScoreAvantCorrectionDomicile – @_match.Feuille.ScoreAvantCorrectionExterieur</b>
                        à
                        <b>@_match.Feuille.TouchdownsDomicile – @_match.Feuille.TouchdownsExterieur</b>.
                    </span>
                }
                <br />
                Vos choix d'après-match précédents ont été <b>annulés</b> et l'PSP dépensée
                vous a été rendue : refaites vos améliorations et vos recrutements.
                @if (!string.IsNullOrWhiteSpace(_match.Feuille.NotesCommissaire))
                {
                    <br />
                    <span>Note du commissaire : <i>@_match.Feuille.NotesCommissaire</i></span>
                }
            </MudAlert>
        }

    <MudText Typo="Typo.h5" Color="Color.Error" Class="mb-1"><b>Après-match</b></MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        @DisplayHelpers.RondeLabelCourt(_match.Ronde) —
        @_match.Division?.League?.Nom
    </MudText>

    <!-- Résultat + gains -->
    <MudPaper Elevation="2" Class="pa-3 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <div>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Résultat</MudText>
                <MudText Typo="Typo.h6">
                    <b>@_match.EquipeDomicile?.Nom</b>
                    <span style="color:var(--mud-palette-error)"> @_match.Feuille?.TouchdownsDomicile – @_match.Feuille?.TouchdownsExterieur </span>
                    <b>@_match.EquipeExterieur?.Nom</b>
                </MudText>
            </div>
            <div>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Votre équipe</MudText>
                <MudText Typo="Typo.h6"><b>@_equipe.Nom</b></MudText>
                <MudText Typo="Typo.body2">
                    Trésorerie : <b style="color:var(--mud-palette-success)">@_equipe.Tresorerie.ToString("N0") po</b>
                    <span class="ml-3">Relances : <b>@_equipe.NombreRelances@(_typeRelances?.MaxLigue is int mx ? $"/{mx}" : "")</b></span>
                </MudText>
            </div>
        </MudStack>
    </MudPaper>

    <!-- Section 1 : Compétences -->
    @if (_ameliorations.Any())
    {
        <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-left:4px solid #ff9800">
            <MudText Typo="Typo.subtitle1" Class="mb-1">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Warning" Class="mr-1" />
                <b>Améliorations disponibles</b>
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                Le coach choisit l'PSP dépensée pour chaque compétence, dans la limite de l'PSP disponible du joueur.
                Principale +20 000 po de valeur, secondaire +40 000 po.
            </MudText>
            @foreach (var a in _ameliorations)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-2">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudText><b>@a.NomJoueur</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @a.NomPoste — <b>@a.PspTotal PSP</b> disponibles
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect Value="a.SkillId" T="int?" Label="Compétence"
                                       ValueChanged="@(v => ChoisirCompetence(a, v))"
                                       Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                                <MudSelectItem T="int?" Value="@((int?)null)">— Aucune —</MudSelectItem>
                                @foreach (var c in Proposees(a))
                                {
                                    <MudSelectItem T="int?" Value="@((int?)c.Skill.Id)">
                                        @Etiquette(c)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudCheckBox @bind-Value="a.HorsAcces" Size="Size.Small" Dense="true"
                                         Color="Color.Warning"
                                         Label="Autoriser hors accès du poste" />
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudNumericField @bind-Value="a.PspDepensee" Label="PSP dépensée"
                                             Min="0" Max="@a.PspTotal"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Disabled="@(a.SkillId is null)"
                                             HelperText="@(a.SkillId is null ? null : $"reste {a.PspTotal - a.PspDepensee}")" />
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            @if (a.SkillId is not null)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(a.EstPrincipale ? Color.Warning : Color.Default)"
                                         Icon="@(a.EstPrincipale ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)">
                                    @(a.EstPrincipale ? "Principale" : "Secondaire") @LibelleHausse(a.EstPrincipale, EstEliteChoisie(a))
                                </MudChip>
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </MudPaper>
    }

    <!-- Section 2 : Recruter un joueur -->
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-1">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Class="mr-1" />
            <b>Recruter un joueur</b>
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
            Trésorerie disponible : <b>@_equipe.Tresorerie.ToString("N0") po</b>
        </MudText>
        @foreach (var pos in _postesDisponibles)
        {
            var count = _equipe.Joueurs.Count(j => !j.EstMort && !j.EstRetraite && j.PlayerPositionId == pos.Id);
            var complet = count >= pos.QuantiteMax;
            var insuffisant = _equipe.Tresorerie < pos.Cout;
            <MudPaper Outlined="true" Class="pa-2 mb-2"
                     Style="@($"opacity:{(complet || insuffisant ? "0.5" : "1")}")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <div style="flex:1; min-width:100px">
                        <MudText Typo="Typo.body2"><b>@pos.Nom</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @pos.Cout.ToString("N0") po &nbsp;·&nbsp; @count/@pos.QuantiteMax
                        </MudText>
                    </div>
                    <MudTextField @bind-Value="@_nomsRecruté[pos.Id]" Placeholder="Nom (optionnel)"
                                 Variant="Variant.Text" Margin="Margin.Dense" Style="min-width:120px; flex:1"
                                 Disabled="@(complet || insuffisant)" />
                    <MudNumericField @bind-Value="@_numerosRecruté[pos.Id]" Min="1" Max="99"
                                   Label="#" Variant="Variant.Text" Margin="Margin.Dense" Style="width:56px"
                                   Disabled="@(complet || insuffisant)" />
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                 Size="Size.Small"
                                 Color="@(!complet && !insuffisant ? Color.Primary : Color.Default)"
                                 Disabled="@(complet || insuffisant)"
                                 OnClick="@(() => AjouterRecrue(pos))"
                                 title="@(insuffisant ? "Fonds insuffisants" : complet ? "Limite atteinte" : "Recruter")" />
                </MudStack>
            </MudPaper>
        }

        @* ── Recrutement gratuit (« Maîtres de la Non-Vie ») ───────────────
           Section distincte du recrutement payant ci-dessus : ces postes sont
           offerts par une règle spéciale, la trésorerie n'entre pas en jeu. *@
        @if (_postesGratuits.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-1">Recrutement gratuit</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                @if (_limiteGratuite > 0)
                {
                    <text>Accordé par une règle spéciale. @_gratuitesUtilisees/@_limiteGratuite utilisée@(_limiteGratuite > 1 ? "s" : "") pour ce match.</text>
                }
                else
                {
                    <text>Accordé par une règle spéciale de l'équipe. Sans coût.</text>
                }
            </MudText>

            @* Droit epuise : on garde la section visible (le coach doit voir
               qu'il a bien utilise sa recrue) mais les boutons sont eteints. *@
            @if (_droitGratuitEpuise)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    <MudText Typo="Typo.caption">
                        Recrue offerte déjà utilisée pour ce match. Les joueurs
                        supplémentaires se recrutent normalement, ci-dessus.
                    </MudText>
                </MudAlert>
            }

            @foreach (var pos in _postesGratuits)
            {
                var countG = _equipe.Joueurs.Count(j => !j.EstMort && !j.EstRetraite && j.PlayerPositionId == pos.Id);
                // Bloque si le poste est plein OU si le droit du match est consommé.
                var completG = countG >= pos.QuantiteMax || _droitGratuitEpuise;
                <MudPaper Outlined="true" Class="pa-2 mb-2" Style="@($"opacity:{(completG ? "0.5" : "1")}")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <div style="flex:1; min-width:100px">
                            <MudText Typo="Typo.body2"><b>@pos.Nom</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Gratuit &nbsp;·&nbsp; @countG/@pos.QuantiteMax
                            </MudText>
                        </div>
                        <MudTextField @bind-Value="@_nomsGratuit[pos.Id]" Placeholder="Nom (optionnel)"
                                     Variant="Variant.Text" Margin="Margin.Dense" Style="min-width:120px; flex:1"
                                     Disabled="@completG" />
                        <MudNumericField @bind-Value="@_numerosGratuit[pos.Id]" Min="1" Max="99"
                                       Label="#" Variant="Variant.Text" Margin="Margin.Dense" Style="width:56px"
                                       Disabled="@completG" />
                        <MudIconButton Icon="@Icons.Material.Filled.CardGiftcard"
                                     Size="Size.Small"
                                     Color="@(!completG ? Color.Success : Color.Default)"
                                     Disabled="@completG"
                                     OnClick="@(() => RecruterGratuit(pos))"
                                     title="@(_droitGratuitEpuise ? "Recrue offerte déjà utilisée pour ce match"
                                              : completG ? "Limite du poste atteinte" : "Recruter gratuitement")" />
                    </MudStack>
                </MudPaper>
            }
        }

        @if (_recrutesEnAttente.Any())
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-2 d-block">
                <b>En attente de confirmation :</b>
                @foreach (var r in _recrutesEnAttente)
                {
                    <span> @r.Nom (@r.PositionNom, @r.Cout.ToString("N0") po)</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                 Color="Color.Error" OnClick="@(() => _recrutesEnAttente.Remove(r))" />
                }
            </MudText>
        }
    </MudPaper>

    <!-- Section 3 : Relances -->
    @if (_typeRelances is not null && _equipe.NombreRelances < _plafondRelances)
    {
        var coutRelance = (_equipe.TeamType?.CoutRelance ?? 50_000) * 2;
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-1">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Color="Color.Secondary" Class="mr-1" />
                <b>Acheter des @(_typeRelances.Nom.ToLowerInvariant())</b>
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                Coût en ligue : @coutRelance.ToString("N0") po chacune (double du tarif normal) &nbsp;·&nbsp;
                Actuellement @_equipe.NombreRelances, @(_typeRelances.MaxLigue is int m ? $"max {m}" : "sans plafond")
            </MudText>
            @if (!string.IsNullOrWhiteSpace(_typeRelances.Description))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block" Style="line-height:1.35">
                    @_typeRelances.Description
                </MudText>
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudNumericField @bind-Value="_nouvellesRelances" Min="0"
                               Max="@(Math.Min(_plafondRelances - _equipe.NombreRelances, (int)(_equipe.Tresorerie / coutRelance)))"
                               Label="Relances à acheter" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Style="width:160px" />
                @if (_nouvellesRelances > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning">
                        Coût total : <b>@((_nouvellesRelances * coutRelance).ToString("N0")) po</b>
                    </MudText>
                }
            </MudStack>
        </MudPaper>
    }

    <!-- Bouton de validation -->
    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-2">
        <MudButton Href="/matchs" Variant="Variant.Text">Annuler</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                  StartIcon="@Icons.Material.Filled.CheckCircle"
                  Disabled="@_saving" OnClick="Valider">
            @(_saving ? "Validation..." : "Valider mon après-match")
        </MudButton>
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }

    Match? _match;
    Team? _equipe;
    bool _estDomicile;
    List<Skill> _skills = [];
    List<PlayerPosition> _postesDisponibles = [];
    List<AmeliorationData> _ameliorations = [];
    List<RecrueData> _recrutesEnAttente = [];

    // Recrutement gratuit (« Maîtres de la Non-Vie »). Appliqué IMMÉDIATEMENT,
    // pas mis en attente comme les recrues payantes : il n'y a rien à financer,
    // donc rien à arbitrer au moment de valider.
    List<PlayerPosition> _postesGratuits = [];

    // Plafond de recrues offertes par phase d'apres-match (1 dans le LRB,
    // reglable par race) et nombre deja consomme POUR CE MATCH.
    int _limiteGratuite;
    int _gratuitesUtilisees;
    bool _droitGratuitEpuise => _limiteGratuite > 0 && _gratuitesUtilisees >= _limiteGratuite;
    Dictionary<int, string> _nomsGratuit = [];
    Dictionary<int, int> _numerosGratuit = [];
    Dictionary<int, string> _nomsRecruté = [];
    Dictionary<int, int> _numerosRecruté = [];
    int _nouvellesRelances;
    bool _saving;

    /// <summary>
    /// Définition « Relances » de la ligue. Le plafond n'est plus codé en dur :
    /// il vient des règles, et peut être absent (aucune limite).
    /// </summary>
    LeagueStaffType? _typeRelances;

    /// <summary>Plafond effectif, très grand quand la ligue n'en impose aucun.</summary>
    int _plafondRelances => _typeRelances?.MaxLigue ?? int.MaxValue;
    string _userId = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

        _match = await MatchService.GetMatchAsync(Id);
        if (_match is null) return;

        // Abonnement AVANT les retours anticipés (statut, droits, équipe) :
        // placé en fin de méthode il aurait été sauté dès qu'un coach n'est pas
        // en phase d'après-match, et le temps réel n'aurait jamais servi ici.
        Notifications.MatchModifie += SurMatchModifieAsync;

        if (_match.Statut != MatchStatus.ValidationCompetences) return;

        bool estDom = _match.EquipeDomicile?.CoachId == _userId;
        bool estExt = _match.EquipeExterieur?.CoachId == _userId;
        // ⚠️ Le rôle "Commissaire" n'existe plus (DbSeeder le migre vers "Admin") :
        // IsInRole("Commissaire") renvoyait toujours false, donc aucun commissaire
        // ne pouvait dépanner un après-match. PeutGererLigueAsync est le vrai test.
        bool estCommissaire = _match.Division is not null
            && await Auth.PeutGererLigueAsync(_userId, _match.Division.LeagueId);

        if (!estDom && !estExt && !estCommissaire) return;

        _estDomicile = estDom || (!estExt && estCommissaire);
        var teamId = _estDomicile ? _match.EquipeDomicileId : _match.EquipeExterieurId;
        _equipe = await TeamService.GetEquipeAsync(teamId);
        if (_equipe is not null)
        {
            var staffLigue = await StaffService.GetStaffLigueAsync(_equipe.LeagueId, actifsSeulement: true);
            _typeRelances = staffLigue.FirstOrDefault(s => s.Nom == StaffService.NomRelances);
        }
        if (_equipe is null) return;

        // R7 : uniquement les compétences de la version de règles de la ligue
        _skills = await TeamService.GetCompetencesAsync(
            rulesVersionId: _match.Division?.League?.RulesVersionId);

        // Barème d'amélioration de la version : coûts en PSP proposés et hausses
        // de valeur affichées. Résolu ici pour que les libellés soient justes
        // même si l'association a ajusté son barème.
        _bareme = BaremeAmelioration.DeVersion(_match.Division?.League?.RulesVersion);
        _postesDisponibles = await TeamService.GetPostesDisponiblesAsync(_equipe.TeamTypeId);

        // Postes offerts par une règle spéciale de la race. Liste vide dans la
        // très grande majorité des cas : la section n'apparaît alors même pas.
        _postesGratuits = await TeamService.GetPostesRecrutementGratuitAsync(_equipe.Id);
        _limiteGratuite = await TeamService.LimiteRecruesGratuitesAsync(_equipe.Id);
        _gratuitesUtilisees = await TeamService.RecruesGratuitesUtiliseesAsync(_equipe.Id, Id);
        foreach (var p in _postesGratuits)
        {
            _nomsGratuit.TryAdd(p.Id, "");
            _numerosGratuit.TryAdd(p.Id, 1);
        }

        _ameliorations = _match.Feuille?.RecordsJoueurs
            .Where(r => r.TeamPlayer is not null
                     && r.EstCoteDomicile == _estDomicile
                     && r.TeamPlayer.PointsStarPlayer > 0)
            .OrderByDescending(r => r.TeamPlayer!.PointsStarPlayer)
            .Select(r => new AmeliorationData
            {
                TeamPlayerId = r.TeamPlayerId,
                NomJoueur    = r.TeamPlayer!.Nom,
                NomPoste     = r.TeamPlayer.PlayerPosition?.Nom ?? "",
                PspTotal     = r.TeamPlayer.PointsStarPlayer,
                Acces        = r.TeamPlayer.PlayerPosition?.AccesCategories?.ToList() ?? [],
                // Le coût proposé dépend du rang : la 6e amélioration coûte
                // beaucoup plus cher que la 1re (LRB, Tableau des Améliorations).
                RangProchaineAmelioration = r.TeamPlayer.Improvements.Count + 1,
            })
            .ToList() ?? [];

        foreach (var pos in _postesDisponibles)
        {
            _nomsRecruté[pos.Id] = "";
            var nextNum = _equipe.Joueurs.Any(j => !j.EstMort && !j.EstRetraite)
                ? _equipe.Joueurs.Where(j => !j.EstMort && !j.EstRetraite).Max(j => j.Numero) + 1
                : 1;
            _numerosRecruté[pos.Id] = Math.Min(nextNum, 99);
        }
    }

    /// <summary>
    /// Réagit à une action de l'AUTRE coach sur ce match.
    ///
    /// ⚠️ On ne recharge PAS l'écran : cette page porte une saisie en cours
    /// (PSP dépensés, recrutements, relances) qu'un rechargement effacerait.
    /// On ne réagit qu'au seul changement qui rend l'écran caduc — le passage
    /// à « Terminé » — et on redirige alors vers le détail du match.
    /// </summary>
    /// <summary>Le score a-t-il changé lors de la dernière correction ?</summary>
    bool ScoreAChange() =>
        _match?.Feuille is { } f
        && (f.ScoreAvantCorrectionDomicile != f.TouchdownsDomicile
         || f.ScoreAvantCorrectionExterieur != f.TouchdownsExterieur);

    private async Task SurMatchModifieAsync(int matchId)
    {
        if (matchId != Id) return;

        // GetMatchFraisAsync : le DbContext vit aussi longtemps que l'onglet,
        // sans vidage du cache EF on relirait l'ancien statut.
        var frais = await MatchService.GetMatchFraisAsync(Id);
        if (frais?.Statut != MatchStatus.Termine) return;

        await InvokeAsync(() =>
        {
            Snackbar.Add("L'adversaire a validé : le match est terminé.", Severity.Success);
            Nav.NavigateTo($"/matchs/{Id}/detail");
        });
    }

    public void Dispose() => Notifications.MatchModifie -= SurMatchModifieAsync;

    /// <summary>
    /// Libellé d'une compétence dans la liste (R7). MudSelect ne rend pas
    /// correctement les MudListSubheader dans son popover : on porte donc
    /// l'information de groupe directement dans le texte de l'item.
    /// </summary>
    /// <summary>
    /// Étiquette d'un item de la liste. `Etiquette` est appelée depuis le rendu :
    /// elle ne peut pas être statique puisqu'elle interpole le barème résolu.
    /// </summary>
    string Etiquette(AccesCompetencesHelpers.CompetenceProposee c)
    {
        var cat = c.Skill.SkillCategoryDef?.Nom ?? "?";
        var elite = c.Skill.EstElite ? " ⭐" : "";
        // Hausse interpolée depuis le barème de la version, jamais écrite en dur :
        // une ligue au barème ajusté verrait sinon un montant faux.
        var marque = c.HorsAcces
            ? "⚠ hors accès"
            : $"{(c.EstPrincipale ? "principal" : "secondaire")} {LibelleHausse(c.EstPrincipale, c.Skill.EstElite)}";
        return $"{c.Skill.Nom}{elite}  —  {cat} · {marque}";
    }

    // R7 — listes proposées, calculées hors du rendu du MudSelect
    List<AccesCompetencesHelpers.CompetenceProposee> Proposees(AmeliorationData a) =>
        AccesCompetencesHelpers.Filtrer(_skills, a.Acces, a.HorsAcces);

    List<AccesCompetencesHelpers.CompetenceProposee> Principales(AmeliorationData a) =>
        Proposees(a).Where(c => !c.HorsAcces && c.EstPrincipale).ToList();

    List<AccesCompetencesHelpers.CompetenceProposee> Secondaires(AmeliorationData a) =>
        Proposees(a).Where(c => !c.HorsAcces && !c.EstPrincipale).ToList();

    List<AccesCompetencesHelpers.CompetenceProposee> HorsAcces(AmeliorationData a) =>
        Proposees(a).Where(c => c.HorsAcces).ToList();

    /// <summary>
    /// Sélection d'une compétence (R7) : le caractère principal / secondaire est
    /// <b>déduit</b> des accès du poste, il n'est plus coché à la main. Une
    /// compétence prise hors accès compte comme secondaire (hausse +40k).
    /// </summary>
    void ChoisirCompetence(AmeliorationData a, int? skillId)
    {
        a.SkillId = skillId;

        if (skillId is null) { a.EstPrincipale = false; return; }

        var skill = _skills.FirstOrDefault(s => s.Id == skillId.Value);
        a.EstPrincipale = skill is not null
                       && AccesCompetencesHelpers.EstAccesPrincipal(skill, a.Acces);

        // Coût PROPOSÉ par le barème de la version, jamais imposé : le coach
        // corrige à la main, comme pour l'PSP de la feuille de match.
        //
        // ⚠️ On ne réécrit que si le coach n'a pas déjà saisi une valeur qui
        // DIVERGE de la proposition : sinon changer de compétence écraserait sa
        // correction, et « pincer » toutes les lignes les figerait toutes.
        var proposition = CoutPropose(a);
        if (a.PspDepensee == 0 || a.PspDepensee == a.DernierePropositon)
            a.PspDepensee = Math.Min(proposition, a.PspTotal);

        a.DernierePropositon = proposition;
    }

    /// <summary>
    /// Coût en PSP proposé pour la PROCHAINE amélioration de ce joueur : il
    /// dépend du RANG (nombre d'améliorations déjà prises + 1) et du type.
    /// </summary>
    int CoutPropose(AmeliorationData a)
    {
        var type = a.EstPrincipale
            ? ImprovementType.SelectionPrimaire
            : ImprovementType.SelectionSecondaire;

        return _bareme.CoutPsp(type, a.RangProchaineAmelioration);
    }

    /// <summary>La compétence choisie est-elle marquée « Élite » ?</summary>
    bool EstEliteChoisie(AmeliorationData a) =>
        a.SkillId is int id && _skills.FirstOrDefault(s => s.Id == id)?.EstElite == true;

    /// <summary>
    /// Barème d'amélioration de la version de règles de la ligue : hausses de
    /// valeur et coûts en PSP. Résolu une fois au chargement.
    ///
    /// ⚠️ Sert à INTERPOLER les libellés (« principal +20k ») plutôt que de les
    /// écrire en dur : dès que le barème devient configurable, un texte figé
    /// ment au coach. Même règle que les bandeaux du barème de PSP.
    /// </summary>
    BaremeAmelioration _bareme = BaremeAmelioration.ParDefaut();

    /// <summary>Hausse de valeur affichée pour une compétence, selon son accès.</summary>
    string LibelleHausse(bool estPrincipale, bool estElite)
    {
        var type = estPrincipale ? ImprovementType.SelectionPrimaire : ImprovementType.SelectionSecondaire;
        var montant = _bareme.Hausse(type, null, estElite);
        return $"+{montant / 1000}k";
    }

    bool DejaValide() => _match?.Feuille is { } f
        && (_estDomicile ? f.ApresMatchDomicileValide : f.ApresMatchExterieurValide);

    /// <summary>
    /// Recrutement gratuit, appliqué immédiatement. Le service revalide
    /// l'éligibilité du poste : l'écran propose, il ne fait pas autorité.
    /// </summary>
    async Task RecruterGratuit(PlayerPosition pos)
    {
        if (_equipe is null) return;
        try
        {
            var numero = _numerosGratuit.GetValueOrDefault(pos.Id, 1);
            var nom = _nomsGratuit.GetValueOrDefault(pos.Id, "");

            // On passe le match : c'est lui qui porte le droit a la recrue.
            await TeamService.RecruterJoueurGratuitAsync(_equipe.Id, pos.Id, nom, numero, Id);

            _nomsGratuit[pos.Id] = "";
            _numerosGratuit[pos.Id] = Math.Min(numero + 1, 99);

            // On relit l'équipe : le compteur du poste et la VEA doivent
            // refléter la base, pas un état devinné côté écran.
            _equipe = await TeamService.GetEquipeAsync(_equipe.Id);
            _gratuitesUtilisees = await TeamService.RecruesGratuitesUtiliseesAsync(_equipe!.Id, Id);
            Snackbar.Add($"{pos.Nom} recruté gratuitement", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    void AjouterRecrue(PlayerPosition pos)
    {
        if (_equipe is null) return;
        var nom = _nomsRecruté.GetValueOrDefault(pos.Id, "");
        var numero = _numerosRecruté.GetValueOrDefault(pos.Id, 1);
        _recrutesEnAttente.Add(new RecrueData
        {
            PositionId  = pos.Id,
            PositionNom = pos.Nom,
            Cout        = pos.Cout,
            Nom         = string.IsNullOrWhiteSpace(nom) ? $"#{numero}" : nom,
            Numero      = numero
        });
        // Mise à jour du prochain numéro
        _numerosRecruté[pos.Id] = Math.Min(numero + 1, 99);
        _nomsRecruté[pos.Id] = "";
    }

    async Task Valider()
    {
        if (_equipe is null || _match is null) return;
        _saving = true;
        try
        {
            var competences = _ameliorations
                .Where(a => a.SkillId.HasValue)
                .Select(a => (a.TeamPlayerId, a.SkillId!.Value, a.EstPrincipale, a.PspDepensee))
                .ToList();

            var nouveauxJoueurs = _recrutesEnAttente
                .Select(r => (r.PositionId, r.Nom, r.Numero))
                .ToList();

            await MatchService.ValiderApresMatchCoachAsync(
                Id, _equipe.Id,
                competences,
                nouveauxJoueurs,
                _nouvellesRelances,
                TeamService);

            Snackbar.Add("Après-match validé !", Severity.Success);
            Nav.NavigateTo("/matchs");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    static string CategorieLabel(SkillCategory c) => c switch
    {
        SkillCategory.Agilite   => "Agilité (A)",
        SkillCategory.Force     => "Force (F)",
        SkillCategory.Generale  => "Générale (G)",
        SkillCategory.Mutation  => "Mutation (M)",
        SkillCategory.Passe     => "Passe (P)",
        SkillCategory.Scelerate => "Scélérate (S)",
        _                       => c.ToString()
    };

    sealed class AmeliorationData
    {
        public int    TeamPlayerId { get; set; }
        public string NomJoueur   { get; set; } = "";
        public string NomPoste    { get; set; } = "";
        public int    PspTotal    { get; set; }
        public int?   SkillId     { get; set; }
        /// <summary>Déduit des accès du poste depuis R7 — plus coché à la main.</summary>
        public bool   EstPrincipale { get; set; } = true;
        /// <summary>Accès de catégorie du poste du joueur (R7).</summary>
        public List<PlayerPositionCategoryAccess> Acces { get; set; } = [];
        /// <summary>Case « hors accès » : réaffiche toutes les compétences (R7).</summary>
        public bool   HorsAcces   { get; set; }
        /// <summary>PSP que le coach choisit de dépenser pour cette amélioration (R4).</summary>
        public int    PspDepensee  { get; set; }

        /// <summary>
        /// Rang de la PROCHAINE amélioration de ce joueur (1 = première).
        /// Détermine le coût proposé : le LRB rend chaque amélioration plus
        /// chère que la précédente.
        /// </summary>
        public int    RangProchaineAmelioration { get; set; } = 1;

        /// <summary>
        /// Dernier coût proposé par le barème. Sert à distinguer « le coach n'a
        /// pas touché au champ » de « il a corrigé volontairement » : sans ce
        /// témoin, changer de compétence écraserait une correction manuelle.
        /// </summary>
        public int    DernierePropositon { get; set; }
    }

    sealed class RecrueData
    {
        public int    PositionId  { get; set; }
        public string PositionNom { get; set; } = "";
        public int    Cout        { get; set; }
        public string Nom         { get; set; } = "";
        public int    Numero      { get; set; }
    }
}
