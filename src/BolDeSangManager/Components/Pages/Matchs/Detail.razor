@page "/matchs/{Id:int}/detail"
@rendermode InteractiveServer
@attribute [Authorize]
@inject MatchService MatchService
@inject TeamService TeamService
@inject AuthenticationStateProvider AuthProvider
@inject BolDeSangManager.Services.IAuthorizationService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject LeagueNotificationService Notifications
@implements IDisposable

<PageTitle>Résultat du match — BolDeSang Manager</PageTitle>

<style>
    /* Mêmes cartes de saisie que Matchs/Feuille.razor : deux colonnes au doigt,
       quatre sur grand écran. */
    .stat-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px }
    @@media (min-width:960px) { .stat-grid { grid-template-columns:repeat(3,1fr) } }
    .stat-block { text-align:center; background:rgba(255,255,255,0.04); border-radius:8px; padding:8px 4px }
</style>

@if (_match is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else
{
    <!-- En-tête -->
    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Error"><b>Résultat du match</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @_match.Division?.League?.Nom —
                @(_match.Ronde >= 100 ? $"Play-off T{_match.Ronde - 99}" : $"Ronde {_match.Ronde}")
            </MudText>
        </div>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (_estCoachDuMatch && (_match.Statut == MatchStatus.Programme || _match.Statut == MatchStatus.AJouer || _match.Statut == MatchStatus.FeuilleEnSaisie))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.EditNote"
                           Href="@($"/matchs/{_match.Id}/feuille")">
                    Saisir la feuille
                </MudButton>
            }
            @if (_estCommissaire && _match.Feuille is not null)
            {
                <MudButton Variant="@(_modeEdition ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="ToggleEdition">
                    @(_modeEdition ? "Annuler" : "Éditer la feuille")
                </MudButton>
            }
            <MudChip T="string" Color="@MatchColor(_match.Statut)" Size="Size.Small">
                @MatchLabel(_match.Statut)
            </MudChip>
        </MudStack>
    </MudStack>

    <!-- Score -->
    @* Responsive (R9f) : en xs=5/2/5 la colonne centrale ne fait que 56px
       sur un écran de 360px — le score « 2 – 1 » en Typo.h4 s'y empile
       verticalement sur 126px de haut et le nom du coach se coupe.
       Sur téléphone on passe donc en pleine largeur : les deux équipes
       côte à côte (xs=6) et le score sur sa propre ligne en dessous. *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudGrid Class="score-grid">
            <MudItem xs="6" sm="5" Class="text-center">
                <MudText Typo="Typo.subtitle1"><b>@_match.EquipeDomicile?.Nom</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @DisplayHelpers.NomCoach(_match.EquipeDomicile?.Coach)
                </MudText>
            </MudItem>
            <MudItem xs="6" sm="5" Class="text-center score-away">
                <MudText Typo="Typo.subtitle1"><b>@_match.EquipeExterieur?.Nom</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @DisplayHelpers.NomCoach(_match.EquipeExterieur?.Coach)
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="2" Class="text-center score-value">
                <MudText Typo="Typo.h4" Color="Color.Error">
                    <b>@_match.ScoreDomicile – @_match.ScoreExterieur</b>
                </MudText>
                @if (_match.DateJouee.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @_match.DateJouee.Value.ToLocalTime().ToString("dd/MM/yyyy")
                    </MudText>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_match.Feuille is null)
    {
        <MudAlert Severity="Severity.Info">La feuille de match n'a pas encore été saisie.</MudAlert>
    }
    else if (_modeEdition)
    {
        <!-- ═══ MODE ÉDITION ═══ -->
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            L'édition recalcule intégralement les stats d'équipes, PSP et blessures à partir des nouvelles données.
        </MudAlert>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            PSP : TD=@_baremeXp.ParTouchdown pts | Passe=@_baremeXp.ParPasse pt | Interception=@_baremeXp.ParInterception pts | Élimination=@_baremeXp.ParElimination pts@(_baremeXp.ParDeviation > 0 ? $" | Déviation={_baremeXp.ParDeviation} pts" : "")@(_baremeXp.ParAgression > 0 ? $" | Agression={_baremeXp.ParAgression} pts" : "") | @DisplayHelpers.LabelMvp=@_baremeXp.BonusMvp pts
        </MudText>

        @*
            Cartes à steppers, identiques à la saisie initiale (Matchs/Feuille.razor).
            Une MudTable était illisible ici : 11 colonnes ne tiennent pas sur un
            écran de téléphone, et le nom du joueur s'affichait lettre par lettre
            en vertical. Le même rendu aux deux endroits évite au commissaire de
            réapprendre un écran.
        *@

        <!-- ─── Équipe domicile ─── -->
        <MudText Typo="Typo.subtitle1" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" Class="mr-1"/>
            <b>@_match.EquipeDomicile?.Nom</b>
        </MudText>
        <SelecteurJoueurMatch Disponibles="_dispoDomicile" OnAjouter="AjouterDomicile" />

        @foreach (var r in _editDomicile)
        {
            @CarteJoueur(r, true)
        }
        @if (_editDomicile.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block"
                     Style="opacity:0.6;font-style:italic">
                Aucun joueur sur la feuille — ajoutez ceux qui ont des stats à saisir.
            </MudText>
        }

        <!-- ─── Équipe extérieure ─── -->
        <MudText Typo="Typo.subtitle1" Class="mb-2 mt-4">
            <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Size="Size.Small" Class="mr-1"/>
            <b>@_match.EquipeExterieur?.Nom</b>
        </MudText>
        <SelecteurJoueurMatch Disponibles="_dispoExterieur" OnAjouter="AjouterExterieur" />

        @foreach (var r in _editExterieur)
        {
            @CarteJoueur(r, false)
        }
        @if (_editExterieur.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block"
                     Style="opacity:0.6;font-style:italic">
                Aucun joueur sur la feuille — ajoutez ceux qui ont des stats à saisir.
            </MudText>
        }

        <!-- Récap gains -->
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3"><b>Gains post-match</b></MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">@_match.EquipeDomicile?.Nom</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                        TDs : <b>@_editTdDom</b> — estimation : @_estimGainsDom.ToString("N0") po
                    </MudText>
                    <MudNumericField @bind-Value="_editGainsDom" Label="Gains (po)"
                                     Variant="Variant.Outlined" Class="mt-1" Min="0" Max="1000000" />
                    <MudNumericField @bind-Value="_editVarFansDom" Label="Variation fans dévoués"
                                     Variant="Variant.Outlined" Class="mt-2" Min="-3" Max="3" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">@_match.EquipeExterieur?.Nom</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                        TDs : <b>@_editTdExt</b> — estimation : @_estimGainsExt.ToString("N0") po
                    </MudText>
                    <MudNumericField @bind-Value="_editGainsExt" Label="Gains (po)"
                                     Variant="Variant.Outlined" Class="mt-1" Min="0" Max="1000000" />
                    <MudNumericField @bind-Value="_editVarFansExt" Label="Variation fans dévoués"
                                     Variant="Variant.Outlined" Class="mt-2" Min="-3" Max="3" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_ligueAvecPaliers)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudNumericField T="int?" @bind-Value="_editNombreDeTours"
                                 Label="Nombre de tours joués" Min="1" Max="50"
                                 Variant="Variant.Outlined"
                                 HelperText="Le barème de cette ligue change les points à partir d'un certain tour. Non renseigné, ce match compte avec les points de base." />
            </MudPaper>
        }

        <MudTextField @bind-Value="_editNotes" Label="Notes du commissaire" Lines="2"
                      Variant="Variant.Outlined" Class="mb-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="ToggleEdition">Annuler</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@_saving" OnClick="SauvegarderEdition">
                @(_saving ? "Enregistrement..." : "Enregistrer les modifications")
            </MudButton>
        </MudStack>
    }
    else
    {
        <!-- ═══ MODE LECTURE ═══ -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="1" Class="pa-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-1"><b>@_match.EquipeDomicile?.Nom</b></MudText>
                    <MudText>TDs : <b>@_match.Feuille.TouchdownsDomicile</b></MudText>
                    <MudText>Éliminations : <b>@_match.Feuille.EliminationsDomicile</b></MudText>
                    <MudText>Gains : <b>@_match.Feuille.GainsDomicile.ToString("N0") po</b></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="1" Class="pa-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-1"><b>@_match.EquipeExterieur?.Nom</b></MudText>
                    <MudText>TDs : <b>@_match.Feuille.TouchdownsExterieur</b></MudText>
                    <MudText>Éliminations : <b>@_match.Feuille.EliminationsExterieur</b></MudText>
                    <MudText>Gains : <b>@_match.Feuille.GainsExterieur.ToString("N0") po</b></MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @foreach (var (nomEquipe, domicile) in new[] {
            (_match.EquipeDomicile?.Nom ?? "", true),
            (_match.EquipeExterieur?.Nom ?? "", false) })
        {
            var records = _match.Feuille.RecordsJoueurs
                .Where(r => r.EstCoteDomicile == domicile)
                .OrderByDescending(r => r.PspGagnes)
                .ToList();

            if (!records.Any()) continue;

            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2"><b>@nomEquipe</b></MudText>
            <MudTable Items="@records" Dense="true" Elevation="1" Class="mb-2">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Joueur</MudTh>
                    <MudTh>Poste</MudTh>
                    <MudTh Style="text-align:center">TDs</MudTh>
                    <MudTh Style="text-align:center">Passes</MudTh>
                    <MudTh Style="text-align:center">Int</MudTh>
                    <MudTh Style="text-align:center">Élim</MudTh>
                    <MudTh Style="text-align:center">Dév</MudTh>
                    <MudTh Style="text-align:center">Agr</MudTh>
                    <MudTh Style="text-align:center">@DisplayHelpers.LabelMvp</MudTh>
                    <MudTh Style="text-align:center">PSP</MudTh>
                    <MudTh>Blessure</MudTh>
                </HeaderContent>
                <RowTemplate Context="r">
                    <MudTd DataLabel="N°">@r.TeamPlayer?.Numero</MudTd>
                    <MudTd DataLabel="Joueur"><b>@r.TeamPlayer?.Nom</b></MudTd>
                    <MudTd DataLabel="Poste"><MudText Typo="Typo.caption">@r.TeamPlayer?.PlayerPosition?.Nom</MudText></MudTd>
                    <MudTd DataLabel="TDs" Style="text-align:center">@r.Touchdowns</MudTd>
                    <MudTd DataLabel="Passes" Style="text-align:center">@r.Passes</MudTd>
                    <MudTd DataLabel="Interceptions" Style="text-align:center">@r.Interceptions</MudTd>
                    <MudTd DataLabel="Éliminations" Style="text-align:center">@r.EliminationsInfligees</MudTd>
                    <MudTd DataLabel="Déviations" Style="text-align:center">@r.Deviations</MudTd>
                    <MudTd DataLabel="Agressions" Style="text-align:center">@r.Agressions</MudTd>
                    <MudTd DataLabel="@DisplayHelpers.LabelMvp" Style="text-align:center">@(r.EstMVP ? "★" : "")</MudTd>
                    <MudTd DataLabel="PSP" Style="text-align:center">
                        @if (r.PspGagnes > 0)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(r.PspGagnes >= 6 ? Color.Warning : Color.Default)">
                                @r.PspGagnes
                            </MudChip>
                        }
                        else { <span>0</span> }
                    </MudTd>
                    <MudTd DataLabel="Blessure">@BlessureLabel(r.Blessure, r.StatAffectee)</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (!string.IsNullOrWhiteSpace(_match.Feuille.NotesCommissaire))
        {
            <MudPaper Elevation="1" Class="pa-3 mt-3">
                <MudText Typo="Typo.subtitle2" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Note" Size="Size.Small" Class="mr-1" />
                    <b>Notes du commissaire</b>
                </MudText>
                <MudText Typo="Typo.body2">@_match.Feuille.NotesCommissaire</MudText>
            </MudPaper>
        }

        @* « ✓ Validée » retiré avec la validation commissaire : le drapeau
           ValideParCommissaire reste en base (jamais de suppression de colonne)
           et dans les exports, mais il n'est plus jamais mis à vrai. *@
        @* Trace d'une confirmation d'autorité : sans elle, un match confirmé
           par le commissaire est indiscernable d'un match confirmé par
           l'adversaire, et le coach croit que celui-ci a validé le résultat. *@
        @if (_match.Feuille.ConfirmeeParCommissaireLe is DateTime confirmeeLe)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3" Icon="@Icons.Material.Filled.Shield" Dense="true">
                Feuille confirmée par <b>@_match.Feuille.ConfirmeeParCommissaire</b>,
                commissaire de la ligue, le
                @confirmeeLe.ToLocalTime().ToString("dd/MM/yyyy à HH'h'mm")
                — sans attendre la confirmation de l'adversaire.
            </MudAlert>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 d-block">
            Saisie le @_match.Feuille.SaisiLe.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </MudText>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    Match? _match;
    bool _estCommissaire;
    bool _estCoachDuMatch;
    bool _modeEdition;
    bool _saving;

    List<PlayerEditData> _editDomicile = [];
    List<PlayerEditData> _editExterieur = [];
    int? _mvpDomId;
    int? _mvpExtId;
    /// <summary>
    /// Gains RÉELLEMENT enregistrés, saisis à la main — comme sur la feuille
    /// initiale. `CalculerGains` ne fournit qu'une estimation affichée à côté :
    /// la recette dépend de l'affluence, que l'application ne connaît pas.
    /// </summary>
    int _editGainsDom;
    int _editGainsExt;

    int _editVarFansDom;
    int _editVarFansExt;
    string _editNotes = "";
    int? _editNombreDeTours;

    /// <summary>
    /// Joueurs de chaque équipe pas encore présents sur la feuille. Alimente le
    /// sélecteur d'ajout : un joueur oublié à la saisie doit pouvoir être ajouté
    /// après coup, sinon ses actions n'entrent jamais ni dans son PSP ni dans le
    /// classement.
    /// </summary>
    List<SelecteurJoueurMatch.JoueurDisponible> _dispoDomicile = [];
    List<SelecteurJoueurMatch.JoueurDisponible> _dispoExterieur = [];

    /// <summary>Barème de PSP de la ligue, pour l'aide de saisie (valeurs configurables).</summary>
    BaremePsp _baremeXp = BaremePsp.ParDefaut(GameType.BloodBowl);

    /// <summary>La ligue accorde-t-elle des points selon le tour atteint ?</summary>
    bool _ligueAvecPaliers;

    int _editTdDom    => _editDomicile.Sum(r => r.Touchdowns);
    int _editTdExt    => _editExterieur.Sum(r => r.Touchdowns);
    int _estimGainsDom => MatchService.CalculerGains(_editTdDom, _editTdExt,
        _match?.EquipeDomicile?.FansDevoues ?? 0, _match?.EquipeExterieur?.FansDevoues ?? 0).gainsDomicile;
    int _estimGainsExt => MatchService.CalculerGains(_editTdDom, _editTdExt,
        _match?.EquipeDomicile?.FansDevoues ?? 0, _match?.EquipeExterieur?.FansDevoues ?? 0).gainsExterieur;

    protected override async Task OnInitializedAsync()
    {
        _match = await MatchService.GetMatchAsync(Id);

        // Barème de PSP et paliers de points de la ligue : ils pilotent l'aide de
        // saisie et l'affichage du champ « nombre de tours ».
        _baremeXp = BaremePsp.DeLigue(_match?.Division?.League,
            _match?.Division?.League?.Game?.Type ?? GameType.BloodBowl);
        _ligueAvecPaliers = _match?.Division?.League?.PaliersPoints.Count > 0;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

        // ⚠️ Ne PAS tester le rôle "Commissaire" : DbSeeder l'a supprimé (migré vers
        // "Admin"). Le test IsInRole("Commissaire") renvoyait donc toujours false et
        // « Éditer la feuille » n'était visible pour PERSONNE, admin compris.
        // PeutGererLigueAsync couvre Admin + GrandCommissaire + CommissaireDeLigue.
        _estCommissaire = _match?.Division is not null
            && await Auth.PeutGererLigueAsync(userId, _match.Division.LeagueId);

        _estCoachDuMatch = _match?.EquipeDomicile?.CoachId == userId
                        || _match?.EquipeExterieur?.CoachId == userId;

        // #2 mode brouillard : le masquage doit tenir côté serveur, pas seulement
        // dans la liste des matchs — sinon l'URL directe contourne la règle.
        if (_match is not null && !_estCommissaire && !_estCoachDuMatch)
        {
            var ligue = _match.Division?.League;
            if (ligue is { ModeBrouillard: true })
            {
                var matchsLigue = await MatchService.GetMatchsLigueAsync(ligue.Id);
                var mesEquipes = matchsLigue
                    .SelectMany(m => new[] { m.EquipeDomicile, m.EquipeExterieur })
                    .Where(e => e is not null && e.CoachId == userId)
                    .Select(e => e!.Id)
                    .ToHashSet();

                if (!BrouillardHelpers.EstVisible(_match, matchsLigue, mesEquipes,
                        modeBrouillard: true, estCommissaire: false))
                {
                    Snackbar.Add("Ce match n'est pas encore visible (mode brouillard).", Severity.Info);
                    Nav.NavigateTo($"/ligues/{ligue.Id}");
                    return;
                }
            }
        }

        // Temps réel : écran de consultation pure, aucune saisie à préserver.
        Notifications.MatchModifie += SurMatchModifieAsync;
    }

    /// <summary>
    /// Recharge le match quand l'autre coach ou le commissaire agit dessus
    /// (confirmation de feuille, après-match, validation, correction).
    /// </summary>
    private async Task SurMatchModifieAsync(int matchId)
    {
        if (matchId != Id) return;

        await InvokeAsync(async () =>
        {
            // ignorerCache via GetMatchFraisAsync : le DbContext vit aussi
            // longtemps que l'onglet, EF rendrait sinon l'instance périmée.
            _match = await MatchService.GetMatchFraisAsync(Id);
            StateHasChanged();
        });
    }

    public void Dispose() => Notifications.MatchModifie -= SurMatchModifieAsync;

    async Task ToggleEdition()
    {
        _modeEdition = !_modeEdition;
        if (_modeEdition) await InitEditionAsync();
    }

    async Task InitEditionAsync()
    {
        if (_match?.Feuille is null) return;
        var records = _match.Feuille.RecordsJoueurs.ToList();

        _editDomicile = records.Where(r => r.EstCoteDomicile)
            .OrderBy(r => r.TeamPlayer?.Numero ?? 0)
            .Select(ToEditData).ToList();

        _editExterieur = records.Where(r => !r.EstCoteDomicile)
            .OrderBy(r => r.TeamPlayer?.Numero ?? 0)
            .Select(ToEditData).ToList();

        _mvpDomId = records.FirstOrDefault(r =>  r.EstCoteDomicile && r.EstMVP)?.TeamPlayerId;
        _mvpExtId = records.FirstOrDefault(r => !r.EstCoteDomicile && r.EstMVP)?.TeamPlayerId;
        _editGainsDom = _match.Feuille.GainsDomicile;
        _editGainsExt = _match.Feuille.GainsExterieur;
        _editVarFansDom = _match.Feuille.VariationFansDomicile;
        _editVarFansExt = _match.Feuille.VariationFansExterieur;
        _editNotes = _match.Feuille.NotesCommissaire ?? "";
        _editNombreDeTours = _match.Feuille.NombreDeTours;

        // PSP : on ne « pince » que les lignes dont la valeur en base DIVERGE du
        // barème — celles-là ont été forcées à la main et doivent le rester.
        // Pincer toutes les lignes les empêcherait de suivre les steppers.
        foreach (var r in _editDomicile.Concat(_editExterieur))
        {
            var stockee = records.First(x => x.TeamPlayerId == r.TeamPlayerId
                                          && x.EstCoteDomicile == r.EstCoteDomicile).PspGagnes;
            if (stockee != PspCalcules(r)) r.PspSaisie = stockee;
        }

        // Joueurs proposables à l'ajout : le roster MOINS ceux déjà sur la
        // feuille. Les morts et retraités sont exclus, comme à la saisie.
        _dispoDomicile  = await ChargerDisponiblesAsync(_match.EquipeDomicileId,  _editDomicile);
        _dispoExterieur = await ChargerDisponiblesAsync(_match.EquipeExterieurId, _editExterieur);
    }

    async Task<List<SelecteurJoueurMatch.JoueurDisponible>> ChargerDisponiblesAsync(
        int equipeId, List<PlayerEditData> dejaPresents)
    {
        var equipe = await TeamService.GetEquipeAsync(equipeId);
        if (equipe is null) return [];

        var presents = dejaPresents.Select(r => r.TeamPlayerId).ToHashSet();

        return [.. equipe.Joueurs
            .Where(j => !j.EstMort && !j.EstRetraite && !presents.Contains(j.Id))
            .OrderBy(j => j.Numero)
            .Select(j => new SelecteurJoueurMatch.JoueurDisponible(
                j.Id, j.Numero, j.Nom, j.PlayerPosition?.Nom ?? ""))];
    }

    static PlayerEditData ToEditData(MatchPlayerRecord r) => new()
    {
        TeamPlayerId          = r.TeamPlayerId,
        Numero                = r.TeamPlayer?.Numero ?? 0,
        NomJoueur             = r.TeamPlayer?.Nom ?? "",
        EstCoteDomicile       = r.EstCoteDomicile,
        Touchdowns            = r.Touchdowns,
        Passes                = r.Passes,
        Interceptions         = r.Interceptions,
        EliminationsInfligees = r.EliminationsInfligees,
        Deviations            = r.Deviations,
        Agressions            = r.Agressions,
        Blessure              = r.Blessure,
        StatAffectee          = r.StatAffectee,
    };

    /// <summary>
    /// Un joueur = une carte, avec des steppers +/− plutôt que des champs numériques
    /// dans une table à 11 colonnes. Rendu identique à la saisie initiale.
    /// </summary>
    RenderFragment CarteJoueur(PlayerEditData r, bool domicile) =>
        @<MudPaper Elevation="1" Class="mb-2"
                   Style="@($"border-left:3px solid var(--mud-palette-{(domicile ? "primary" : "text-secondary")})")">
            <div class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-2">
                    <div>
                        <MudText Style="line-height:1.3">
                            <span style="color:var(--mud-palette-text-secondary);font-size:0.8rem">#@r.Numero</span>
                            <b style="margin-left:5px">@r.NomJoueur</b>
                        </MudText>
                    </div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudIconButton Icon="@(EstMvp(r, domicile) ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                       Color="@(EstMvp(r, domicile) ? Color.Warning : Color.Default)"
                                       Size="Size.Medium" title="@($"Désigner comme {DisplayHelpers.LabelMvpLong}")"
                                       OnClick="@(() => BasculerMvp(r, domicile))" />
                        <MudText Typo="Typo.caption"
                                 Color="@(EstMvp(r, domicile) ? Color.Warning : Color.Secondary)"
                                 Style="cursor:pointer"
                                 @onclick="@(() => BasculerMvp(r, domicile))">
                            @DisplayHelpers.LabelMvp
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       Color="Color.Error" title="Retirer ce joueur de la feuille"
                                       OnClick="@(() => RetirerLigne(r))" />
                    </MudStack>
                </MudStack>

                <div class="stat-grid">
                    @StatBlock("TOUCHDOWNS", r.Touchdowns, v => r.Touchdowns = Math.Max(0, r.Touchdowns + v))
                    @StatBlock("PASSES", r.Passes, v => r.Passes = Math.Max(0, r.Passes + v))
                    @StatBlock("INTERCEPTIONS", r.Interceptions, v => r.Interceptions = Math.Max(0, r.Interceptions + v))
                    @StatBlock("ÉLIMINATIONS", r.EliminationsInfligees, v => r.EliminationsInfligees = Math.Max(0, r.EliminationsInfligees + v))
                    @StatBlock("DÉVIATIONS", r.Deviations, v => r.Deviations = Math.Max(0, r.Deviations + v))
                    @StatBlock("AGRESSIONS", r.Agressions, v => r.Agressions = Math.Max(0, r.Agressions + v))
                </div>

                @PspSection(r)

                <div style="border-top:1px solid rgba(255,255,255,0.08);margin-top:8px;padding-top:8px">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudSelect @bind-Value="r.Blessure" T="InjuryType?" Label="Blessure"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:190px">
                            <MudSelectItem T="InjuryType?" Value="@((InjuryType?)null)">Aucune</MudSelectItem>
                            <MudSelectItem T="InjuryType?" Value="@((InjuryType?)InjuryType.ManqueSuivant)">Rate prochain match</MudSelectItem>
                            <MudSelectItem T="InjuryType?" Value="@((InjuryType?)InjuryType.BlessurePersistante)">Blessure persistante</MudSelectItem>
                            <MudSelectItem T="InjuryType?" Value="@((InjuryType?)InjuryType.RetraiteTemporaire)">Retraite temporaire</MudSelectItem>
                            <MudSelectItem T="InjuryType?" Value="@((InjuryType?)InjuryType.Mort)">Mort</MudSelectItem>
                        </MudSelect>

                        @if (r.Blessure == InjuryType.BlessurePersistante)
                        {
                            <MudSelect @bind-Value="r.StatAffectee" T="AffectedStat?" Label="Caractéristique"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px">
                                <MudSelectItem T="AffectedStat?" Value="@((AffectedStat?)AffectedStat.Mouvement)">Mouvement</MudSelectItem>
                                <MudSelectItem T="AffectedStat?" Value="@((AffectedStat?)AffectedStat.Force)">Force</MudSelectItem>
                                <MudSelectItem T="AffectedStat?" Value="@((AffectedStat?)AffectedStat.Agilite)">Agilité</MudSelectItem>
                                <MudSelectItem T="AffectedStat?" Value="@((AffectedStat?)AffectedStat.CapacitePasse)">CP</MudSelectItem>
                                <MudSelectItem T="AffectedStat?" Value="@((AffectedStat?)AffectedStat.Armure)">Armure</MudSelectItem>
                            </MudSelect>
                        }
                    </MudStack>
                </div>
            </div>
        </MudPaper>;

    /// <summary>PSP proposée par le barème de la ligue pour ce joueur.</summary>
    int PspCalcules(PlayerEditData r) =>
        _baremeXp.Calculer(r.Touchdowns, r.Passes, r.Interceptions, r.EliminationsInfligees,
                           EstMvp(r, r.EstCoteDomicile), r.Deviations, r.Agressions);

    /// <summary>PSP retenue : la saisie manuelle si elle existe, sinon le calcul.</summary>
    int PspDe(PlayerEditData r) => r.PspSaisie ?? PspCalcules(r);

    /// <summary>
    /// Champ d'PSP manuel, identique à celui de la saisie initiale : le barème n'est
    /// qu'une PROPOSITION, c'est la valeur affichée ici qui est persistée.
    /// Tant que le commissaire n'y touche pas, elle suit les steppers ; dès qu'il
    /// la force, elle reste figée et l'écart au barème est signalé.
    /// </summary>
    RenderFragment PspSection(PlayerEditData r)
    {
        int calc  = PspCalcules(r);
        int val   = PspDe(r);
        int ecart = val - calc;
        return @<div style="border-top:1px solid rgba(255,255,255,0.08);margin-top:8px;padding-top:8px">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.MilitaryTech" Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.caption"><b>PSP</b></MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    @if (ecart != 0)
                    {
                        @* title HTML et non MudTooltip : celui-ci casse le circuit
                           Blazor dans une page InteractiveServer. *@
                        <span title="@($"Barème : {calc} PSP")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                     Style="height:18px;font-size:10px">
                                @(ecart > 0 ? "+" : "")@ecart
                            </MudChip>
                        </span>
                    }
                    <MudNumericField T="int" Value="val" Min="0" Max="99"
                                     ValueChanged="@(v => r.PspSaisie = v)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Style="width:90px" />
                    @if (r.PspSaisie is not null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small"
                                       title="Revenir à la valeur du barème"
                                       OnClick="@(() => r.PspSaisie = null)" />
                    }
                </MudStack>
            </MudStack>
        </div>;
    }

    RenderFragment StatBlock(string label, int value, Action<int> delta) =>
        @<div class="stat-block">
            <div style="font-size:0.62rem;letter-spacing:0.07em;color:var(--mud-palette-text-secondary);margin-bottom:6px">@label</div>
            <div style="display:flex;align-items:center;justify-content:center;gap:2px">
                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                               Variant="Variant.Outlined" OnClick="@(() => delta(-1))" />
                <span style="min-width:32px;text-align:center;font-size:1.6rem;font-weight:bold;line-height:1">@value</span>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                               Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => delta(1))" />
            </div>
        </div>;

    bool EstMvp(PlayerEditData r, bool domicile) =>
        r.TeamPlayerId == (domicile ? _mvpDomId : _mvpExtId);

    /// <summary>Un seul MVP par équipe : re-cliquer sur le même le retire.</summary>
    void BasculerMvp(PlayerEditData r, bool domicile)
    {
        if (domicile) _mvpDomId = _mvpDomId == r.TeamPlayerId ? null : r.TeamPlayerId;
        else          _mvpExtId = _mvpExtId == r.TeamPlayerId ? null : r.TeamPlayerId;
    }

    void AjouterDomicile(SelecteurJoueurMatch.JoueurDisponible p)
    {
        _dispoDomicile.Remove(p);
        _editDomicile.Add(new PlayerEditData
        {
            TeamPlayerId = p.Id, Numero = p.Numero,
            NomJoueur = p.Nom, EstCoteDomicile = true
        });
        _editDomicile = [.. _editDomicile.OrderBy(r => r.Numero)];
    }

    void AjouterExterieur(SelecteurJoueurMatch.JoueurDisponible p)
    {
        _dispoExterieur.Remove(p);
        _editExterieur.Add(new PlayerEditData
        {
            TeamPlayerId = p.Id, Numero = p.Numero,
            NomJoueur = p.Nom, EstCoteDomicile = false
        });
        _editExterieur = [.. _editExterieur.OrderBy(r => r.Numero)];
    }

    /// <summary>
    /// Retire une ligne de la feuille et rend le joueur au sélecteur. Le service
    /// supprime puis réécrit toutes les lignes : une ligne retirée ici disparaît
    /// donc réellement, avec son PSP et sa blessure.
    /// </summary>
    void RetirerLigne(PlayerEditData r)
    {
        var joueur = new SelecteurJoueurMatch.JoueurDisponible(r.TeamPlayerId, r.Numero, r.NomJoueur, "");

        if (r.EstCoteDomicile)
        {
            _editDomicile.Remove(r);
            if (_mvpDomId == r.TeamPlayerId) _mvpDomId = null;
            _dispoDomicile = [.. _dispoDomicile.Append(joueur).OrderBy(p => p.Numero)];
        }
        else
        {
            _editExterieur.Remove(r);
            if (_mvpExtId == r.TeamPlayerId) _mvpExtId = null;
            _dispoExterieur = [.. _dispoExterieur.Append(joueur).OrderBy(p => p.Numero)];
        }
    }

    async Task SauvegarderEdition()
    {
        if (_match?.Feuille is null) return;
        _saving = true;
        try
        {
            var feuilleModifiee = new MatchSheet
            {
                TouchdownsDomicile    = _editTdDom,
                TouchdownsExterieur   = _editTdExt,
                EliminationsDomicile  = _editDomicile.Sum(r => r.EliminationsInfligees),
                EliminationsExterieur = _editExterieur.Sum(r => r.EliminationsInfligees),
                GainsDomicile         = _editGainsDom,
                GainsExterieur        = _editGainsExt,
                VariationFansDomicile  = _editVarFansDom,
                VariationFansExterieur = _editVarFansExt,
                NotesCommissaire       = _editNotes,
                NombreDeTours          = _ligueAvecPaliers ? _editNombreDeTours : _match.Feuille.NombreDeTours,
            };

            var records = _editDomicile.Concat(_editExterieur).Select(r => new MatchPlayerRecord
            {
                TeamPlayerId          = r.TeamPlayerId,
                EstCoteDomicile       = r.EstCoteDomicile,
                Touchdowns            = r.Touchdowns,
                Passes                = r.Passes,
                Interceptions         = r.Interceptions,
                EliminationsInfligees = r.EliminationsInfligees,
                Deviations            = r.Deviations,
                Agressions            = r.Agressions,
                PspGagnes             = PspDe(r),
                EstMVP                = ( r.EstCoteDomicile && r.TeamPlayerId == _mvpDomId)
                                     || (!r.EstCoteDomicile && r.TeamPlayerId == _mvpExtId),
                Blessure     = r.Blessure,
                StatAffectee = r.Blessure == InjuryType.BlessurePersistante ? r.StatAffectee : null,
            }).ToList();

            await MatchService.ModifierFeuilleAsync(Id, feuilleModifiee, records);
            _match = await MatchService.GetMatchAsync(Id);
            _modeEdition = false;
            Snackbar.Add("Feuille modifiée avec succès.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    static string BlessureLabel(InjuryType? type, AffectedStat? stat) => type switch
    {
        InjuryType.ManqueSuivant      => "Rate prochain match",
        InjuryType.BlessurePersistante => $"Séquelle : {stat?.ToString() ?? "?"}",
        InjuryType.RetraiteTemporaire  => "Retraite",
        InjuryType.Mort                => "Mort",
        _                              => "—"
    };

    sealed class PlayerEditData
    {
        public int TeamPlayerId { get; set; }
        public int Numero { get; set; }
        public string NomJoueur { get; set; } = "";
        public bool EstCoteDomicile { get; set; }
        public int Touchdowns { get; set; }
        public int Passes { get; set; }
        public int Interceptions { get; set; }
        public int EliminationsInfligees { get; set; }
        public int Deviations { get; set; }
        public int Agressions { get; set; }

        /// <summary>
        /// PSP forcée par le commissaire. null = suivre le barème, qui se
        /// recalcule alors quand on touche aux steppers.
        /// </summary>
        public int? PspSaisie { get; set; }

        public InjuryType? Blessure { get; set; }
        public AffectedStat? StatAffectee { get; set; }
    }
}
