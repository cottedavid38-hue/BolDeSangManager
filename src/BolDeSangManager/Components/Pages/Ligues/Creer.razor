@page "/ligues/creer"
@page "/ligues/{Id:int}/modifier"
@rendermode InteractiveServer
@attribute [Authorize]
@inject LeagueService LeagueService
@inject StaffService StaffService
@inject BolDeSangManager.Services.IAuthorizationService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(EstEdition ? "Modifier la ligue" : "Créer une ligue") — BolDeSang Manager</PageTitle>

@if (_chargement)
{
    <MudProgressCircular Color="Color.Error" Indeterminate="true" />
}
else if (!_autorise)
{
    <MudAlert Severity="Severity.Error">
        Vous n'avez pas accès à cet écran.
    </MudAlert>
}
else if (_saisonLancee)
{
    @* Message affiché sur place plutôt qu'une redirection : un Snackbar émis
       depuis OnInitializedAsync est perdu par la navigation qui le suit, et
       le commissaire se retrouve renvoyé sans aucune explication. *@
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        La saison est lancée : les paramètres de cette ligue ne sont plus modifiables.
    </MudAlert>
    <MudButton Href="@($"/ligues/{Id}")" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack">
        Retour à la ligue
    </MudButton>
}
else
{

<MudText Typo="Typo.h5" Color="Color.Error" Class="mb-4">
    <MudIcon Icon="@(EstEdition ? Icons.Material.Filled.Settings : Icons.Material.Filled.Add)" Class="mr-2" />
    <b>@(EstEdition ? "Modifier la ligue" : "Créer une nouvelle ligue")</b>
</MudText>

@if (EstEdition && !_structurantsOuverts)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
        Des équipes sont déjà inscrites. Le jeu, la version des règles, le budget
        de départ et le staff ne peuvent plus changer.
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="7">
        <MudCard Elevation="2">
            <MudCardContent>

                <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Informations générales</b></MudText>

                <MudTextField @bind-Value="_nom" Label="Nom de la ligue *"
                              Variant="Variant.Outlined" Class="mb-3"
                              HelperText="Ex : Ligue de Nanterre Saison 3"
                              Error="@_nomError" ErrorText="Le nom est obligatoire" />

                <MudTextField @bind-Value="_description" Label="Description (optionnelle)"
                              Variant="Variant.Outlined" Lines="2" Class="mb-3" />

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Jeu et règles</b></MudText>

                <MudSelect T="string" Value="@_selectedGameNom" Label="Jeu"
                           Variant="Variant.Outlined" Class="mb-3"
                           Disabled="@(!_structurantsOuverts)"
                           ValueChanged="OnGameNameChanged">
                    @foreach (var game in _games)
                    {
                        <MudSelectItem T="string" Value="@game.Nom">@game.Nom</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" Value="@_selectedVersionNom" Label="Version des règles"
                           Variant="Variant.Outlined" Class="mb-3"
                           ValueChanged="OnVersionChanged"
                           Disabled="@(_versions.Count == 0 || !_structurantsOuverts)">
                    @foreach (var v in _versions)
                    {
                        <MudSelectItem T="string" Value="@v.Nom">@v.Nom</MudSelectItem>
                    }
                </MudSelect>

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Format et règlement</b></MudText>

                <MudSelect T="LeagueFormat" @bind-Value="_format" Label="Format de la ligue"
                           Variant="Variant.Outlined" Class="mb-1">
                    <MudSelectItem T="LeagueFormat" Value="@LeagueFormat.RoundRobinAvecPlayoffs">Round Robin + play-offs (recommandé)</MudSelectItem>
                    <MudSelectItem T="LeagueFormat" Value="@LeagueFormat.RoundRobin">Round Robin</MudSelectItem>
                    <MudSelectItem T="LeagueFormat" Value="@LeagueFormat.LibreAvecPlayoffs">Libre + play-offs</MudSelectItem>
                    <MudSelectItem T="LeagueFormat" Value="@LeagueFormat.Libre">Libre</MudSelectItem>
                    <MudSelectItem T="LeagueFormat" Value="@LeagueFormat.Open">Open — sans fin, sans calendrier</MudSelectItem>
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    @if (DisplayHelpers.SansCalendrier(_format))
                    {
                        <text>
                            <b>Open</b> : ligue sans fin, ni rondes ni calendrier. Les inscriptions
                            restent ouvertes en permanence — une équipe peut rejoindre à tout moment —
                            et n'importe quel participant propose une rencontre quand il le souhaite,
                            l'adversaire confirmant ensuite la feuille de match. Pas de play-offs.
                        </text>
                    }
                    else if (DisplayHelpers.EstFormatLibre(_format))
                    {
                        <text>
                            <b>Libre</b> : aucun calendrier n'est généré. Une fois les inscriptions
                            closes, vous composez vous-même les rondes et les rencontres depuis la
                            page de la ligue.
                        </text>
                    }
                    else
                    {
                        <text>
                            <b>Round Robin</b> : le calendrier est généré automatiquement au
                            lancement, chaque équipe rencontrant toutes les autres.
                        </text>
                    }
                </MudText>

                <MudNumericField T="int" @bind-Value="_budget" Label="Budget de départ (po)"
                                 Variant="Variant.Outlined" Class="mb-3"
                                 Min="500000" Max="2000000" Step="50000"
                                 Disabled="@(!_structurantsOuverts)"
                                 HelperText="Standard : 1 000 000 po" />

                @if (DisplayHelpers.AvecPlayoffs(_format))
                {
                    <MudSelect T="string" @bind-Value="_nbEquipesLabel"
                               Label="Équipes qualifiées en play-offs"
                               Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem T="string" Value="@Playoff2">@Playoff2</MudSelectItem>
                        <MudSelectItem T="string" Value="@Playoff4">@Playoff4</MudSelectItem>
                        <MudSelectItem T="string" Value="@Playoff8">@Playoff8</MudSelectItem>
                    </MudSelect>
                }

                @* Le mode brouillard n'est proposé qu'à la création : ensuite il se
                   bascule depuis la fiche de ligue, y compris en cours de saison. *@
                @if (!EstEdition)
                {
                    <MudCheckBox @bind-Value="_modeBrouillard" Color="Color.Error" Class="mb-1"
                                 Label="Mode brouillard" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block" Style="margin-left:32px">
                        Les coaches ne voient que leur prochain match et les matchs déjà joués.
                        Le reste du calendrier à venir est masqué, pour qu'on ne joue pas une
                        rencontre en anticipant les suivantes. Les commissaires voient tout.
                    </MudText>
                }

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-1"><b>Barème d'XP</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    XP gagnée par les joueurs selon leurs actions. Ces valeurs pré-remplissent
                    la feuille de match — le coach peut ensuite les ajuster.
                </MudText>
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="int" @bind-Value="_xpTd" Label="Touchdown"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="int" @bind-Value="_xpPasse" Label="Passe complétée"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="int" @bind-Value="_xpInterception" Label="Interception"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="int" @bind-Value="_xpElimination" Label="Élimination"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="int" @bind-Value="_xpMvp" Label="@($"Bonus {DisplayHelpers.LabelMvp}")"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
                    </MudItem>
                </MudGrid>

                @if (!EstEdition)
                {
                    <MudDivider Class="my-3" />

                    <MudText Typo="Typo.subtitle2" Class="mb-1"><b>Barème du classement</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                        Points gagnés au classement. Réglable ensuite en cours de saison,
                        avec recalcul automatique.
                    </MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                        <MudText Typo="Typo.body2">@ResumeBaremePoints()</MudText>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Scoreboard"
                                   OnClick="OuvrirBaremePoints">
                            Régler
                        </MudButton>
                    </MudStack>
                }

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-1"><b>Staff & Équipement</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Ce que les équipes pourront acheter dans cette ligue. Les valeurs viennent
                    des règles : ajustez-les ici pour votre format, sans modifier les règles
                    ni les autres ligues. Un staff décoché n'est pas proposé.
                </MudText>

                @if (_staff.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Aucun staff défini dans cette version de règles.
                        Ajoutez-en dans <b>Édition des données → Staff</b>.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@_staff" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                              Class="mb-3" Style="font-size:12px">
                        <HeaderContent>
                            <MudTh>Staff</MudTh>
                            <MudTh Style="text-align:right">Coût</MudTh>
                            <MudTh Style="text-align:center">Min créa.</MudTh>
                            <MudTh Style="text-align:center">Max créa.</MudTh>
                            <MudTh Style="text-align:center">Plafond ligue</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Staff">
                                <MudCheckBox T="bool" Value="@context.EstActif" Dense="true" Disabled="@(!_structurantsOuverts)"
                                             ValueChanged="@(v => context.EstActif = v)"
                                             Color="Color.Primary" Label="@context.Nom" />
                                @if (!string.IsNullOrWhiteSpace(context.Description))
                                {
                                    @* La description passe SOUS le nom, hors de la cellule étroite :
                                       en vue mobile MudBlazor empile label/valeur et la colonne
                                       de droite ne fait que quelques caractères de large. *@
                                    <div class="staff-desc">@context.Description</div>
                                }
                            </MudTd>
                            <MudTd DataLabel="Coût" Style="text-align:right">
                                @if (context.CoutDepuisTypeEquipe)
                                {
                                    <span style="font-size:11px; color:#90caf9"
                                          title="Le prix vient de la fiche de la race (Coût relance) : il diffère d'une race à l'autre.">
                                        selon la race
                                    </span>
                                }
                                else
                                {
                                    <MudNumericField T="int" @bind-Value="context.Cout" Min="0" Step="5000"
                                                     Variant="Variant.Text" Margin="Margin.Dense"
                                                     Disabled="@(!context.EstActif || !_structurantsOuverts)" Style="max-width:110px" />
                                }
                            </MudTd>
                            <MudTd DataLabel="Min à la création" Style="text-align:center">
                                <MudNumericField T="int" @bind-Value="context.MinCreation" Min="0" Max="99"
                                                 Variant="Variant.Text" Margin="Margin.Dense"
                                                 Disabled="@(!context.EstActif || !_structurantsOuverts)" Style="max-width:70px" />
                            </MudTd>
                            <MudTd DataLabel="Max à la création" Style="text-align:center">
                                <MudNumericField T="int" @bind-Value="context.MaxCreation" Min="0" Max="99"
                                                 Variant="Variant.Text" Margin="Margin.Dense"
                                                 Disabled="@(!context.EstActif || !_structurantsOuverts)" Style="max-width:70px" />
                            </MudTd>
                            <MudTd DataLabel="Plafond en cours de ligue" Style="text-align:center">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Justify="Justify.Center">
                                    <MudCheckBox T="bool" Dense="true" Color="Color.Primary"
                                                 Value="@(context.MaxLigue.HasValue)"
                                                 ValueChanged="@(v => BasculerPlafond(context, v))"
                                                 Disabled="@(!context.EstActif || !_structurantsOuverts)"
                                                 title="Décoché = aucune limite en cours de ligue" />
                                    @if (context.MaxLigue.HasValue)
                                    {
                                        <MudNumericField T="int" Min="0" Max="99"
                                                         Value="@context.MaxLigue.Value"
                                                         ValueChanged="@(v => context.MaxLigue = v)"
                                                         Variant="Variant.Text" Margin="Margin.Dense"
                                                         Disabled="@(!context.EstActif || !_structurantsOuverts)" Style="max-width:70px" />
                                    }
                                    else
                                    {
                                        <span style="font-size:11px; color:#9e9e9e">illimité</span>
                                    }
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                        Le plafond de ligue est strict : il s'applique aux achats <b>comme</b> aux
                        fans gagnés par les résultats de match.
                    </MudText>
                }

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4" Spacing="2">
                    <MudButton Href="@(EstEdition ? $"/ligues/{Id}" : "/ligues")"
                               Variant="Variant.Text" Disabled="@_saving">
                        Annuler
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="HandleSubmit"
                               Disabled="@_saving">
                        @(_saving
                            ? (EstEdition ? "Enregistrement..." : "Création...")
                            : (EstEdition ? "Enregistrer" : "Créer la ligue"))
                    </MudButton>
                </MudStack>

            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudCard Elevation="1">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">
                        <b>@(EstEdition ? "Ce qui reste modifiable" : "Guide de création")</b>
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (EstEdition)
                {
                    <MudList T="string" Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            Nom, description, format et barème d'XP : jusqu'au lancement de la saison
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Lock" IconColor="Color.Warning">
                            Jeu, version des règles, budget et staff : jusqu'à la première équipe inscrite
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Info" IconColor="Color.Info">
                            Règlement et mode brouillard se modifient depuis la fiche de la ligue
                        </MudListItem>
                    </MudList>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            Choisissez Blood Bowl ou Dungeon Bowl
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            Sélectionnez la version des règles (ex : Saison 3)
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            Le format Round Robin + Play-offs est le plus joué
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            Budget standard : 1 000 000 po par équipe
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Info" IconColor="Color.Info">
                            Après création, passez en "Inscriptions" pour que les coaches rejoignent
                        </MudListItem>
                    </MudList>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

}

@code {
    /// <summary>
    /// Id de la ligue à modifier. Null sur /ligues/creer : l'écran est alors en
    /// mode création. Un seul formulaire pour les deux, pour qu'un champ ajouté
    /// à la création n'échappe jamais à l'édition.
    /// </summary>
    [Parameter] public int? Id { get; set; }

    bool EstEdition => Id.HasValue;

    const string FormatPlayoffs   = "Round Robin + Play-offs (recommandé)";
    const string FormatRoundRobin = "Round Robin seul (classement final)";
    const string Playoff2 = "2 équipes";
    const string Playoff4 = "4 équipes (recommandé)";
    const string Playoff8 = "8 équipes";

    bool _modeBrouillard;

    // Barème d'XP (R6) — valeurs LRB par défaut, ajustées selon le jeu choisi.
    int _xpTd = 3, _xpPasse = 1, _xpInterception = 2, _xpElimination = 2, _xpMvp = 4;

    /// <summary>
    /// Barème de classement de la ligue en cours de création. Pré-rempli depuis
    /// la version de règles choisie ; les paliers, eux, partent toujours vides
    /// (ils appartiennent au format de la ligue, pas aux règles).
    /// </summary>
    BaremePoints _baremePoints = BaremePoints.ParDefaut();
    List<PalierPointsLigue> _paliersPoints = [];

    string ResumeBaremePoints()
    {
        var b = _baremePoints;
        var txt = $"V {b.Victoire} · N {b.Nul} · D {b.Defaite}";
        if (_paliersPoints.Count > 0) txt += $" — {_paliersPoints.Count} palier(s)";
        var bonus = b.ParTouchdown + b.ParElimination + b.ParInterception
                  + b.ParPasse + b.ParDeviation + b.ParAgression;
        if (bonus > 0) txt += " — avec bonus";
        return txt;
    }

    async Task OuvrirBaremePoints()
    {
        // LigueId = 0 : mode détaché, le dialogue rend le barème sans rien écrire.
        var parameters = new DialogParameters<BaremePointsDialog>
        {
            { x => x.LigueId, 0 },
            { x => x.Bareme, new BaremePoints
                {
                    Victoire        = _baremePoints.Victoire,
                    Nul             = _baremePoints.Nul,
                    Defaite         = _baremePoints.Defaite,
                    ParTouchdown    = _baremePoints.ParTouchdown,
                    ParElimination  = _baremePoints.ParElimination,
                    ParInterception = _baremePoints.ParInterception,
                    ParPasse        = _baremePoints.ParPasse,
                    ParDeviation    = _baremePoints.ParDeviation,
                    ParAgression    = _baremePoints.ParAgression,
                    Paliers         = _paliersPoints
                        .Select(p => new PalierPoints(p.APartirDuTour, p.PointsVictoire, p.PointsNul, p.PointsDefaite))
                        .ToList()
                } },
        };

        var dialog = await DialogService.ShowAsync<BaremePointsDialog>("Barème du classement", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: BaremePointsDialog.BaremeSaisi saisi })
        {
            _baremePoints  = saisi.Bareme;
            _paliersPoints = saisi.Paliers;
        }
    }

    List<Game> _games = [];
    List<RulesVersion> _versions = [];

    /// <summary>
    /// Copie de travail du staff des règles. Le commissaire l'ajuste pour SA
    /// ligue ; rien n'est écrit tant que la ligue n'est pas créée.
    /// </summary>
    List<LeagueStaffType> _staff = [];
    string _selectedGameNom = "";
    string _selectedVersionNom = "";
    string _nom = "";
    string _description = "";
    LeagueFormat _format = LeagueFormat.RoundRobinAvecPlayoffs;
    string _nbEquipesLabel = Playoff4;
    int _budget = 1_000_000;
    bool _saving;
    bool _nomError;

    bool _chargement = true;
    bool _autorise;

    /// <summary>Ligue déjà lancée : l'écran affiche un message au lieu du formulaire.</summary>
    bool _saisonLancee;

    /// <summary>
    /// Jeu, version des règles, budget et staff sont-ils encore modifiables ?
    /// Toujours vrai en création. En édition, faux dès la première équipe
    /// inscrite. Purement visuel : le service revérifie tout.
    /// </summary>
    bool _structurantsOuverts = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

            if (EstEdition)
            {
                // La route est ouverte à tout compte authentifié : c'est ICI que
                // l'autorisation se joue, pas dans l'attribut de la page.
                _autorise = await Auth.PeutGererLigueAsync(userId, Id!.Value);
                if (!_autorise) return;

                var ligue = await LeagueService.GetLigueAsync(Id.Value);
                if (ligue is null) { _autorise = false; return; }

                if (!DisplayHelpers.ParametresLigueEditables(ligue.Statut))
                {
                    _saisonLancee = true;
                    return;
                }

                await ChargerDepuisLigueAsync(ligue);
                return;
            }

            // Création : la garde de rôle retirée de l'attribut est rétablie ici.
            _autorise = await Auth.EstAdminAsync(userId) || await Auth.EstGrandCommissaireAsync(userId);
            if (!_autorise) return;

            _games = await LeagueService.GetGamesAsync();
            if (_games.Count > 0)
            {
                _selectedGameNom = _games[0].Nom;
                _versions = await LeagueService.GetVersionsAsync(_games[0].Id);
                var active = _versions.FirstOrDefault(v => v.EstActive) ?? _versions.FirstOrDefault();
                _selectedVersionNom = active?.Nom ?? "";
                AppliquerBaremeDeVersion(_games[0].Type);
                await ChargerStaffAsync();
            }
        }
        finally
        {
            _chargement = false;
        }
    }

    /// <summary>
    /// Préremplit le formulaire depuis la ligue existante.
    ///
    /// ⚠️ Tout champ ajouté à League ET au formulaire doit être repris ici,
    /// sinon il repart de son défaut C# à l'enregistrement. Faire la liste
    /// depuis Data/Models/League.cs, pas de mémoire.
    /// Exception assumée : Reglement et ModeBrouillard ne sont pas dans ce
    /// formulaire — la fiche de ligue les gère, et le service n'y touche pas.
    /// </summary>
    async Task ChargerDepuisLigueAsync(League ligue)
    {
        _structurantsOuverts =
            DisplayHelpers.ParametresStructurantsEditables(ligue.Statut, ligue.Equipes.Count);

        _nom             = ligue.Nom;
        _description     = ligue.Description;
        _format          = ligue.Format;
        _budget          = ligue.BudgetDepart;
        _nbEquipesLabel  = ligue.NombreEquipesPlayoff switch
        {
            2 => Playoff2,
            8 => Playoff8,
            _ => Playoff4
        };
        _xpTd            = ligue.XpParTouchdown;
        _xpPasse         = ligue.XpParPasse;
        _xpInterception  = ligue.XpParInterception;
        _xpElimination   = ligue.XpParElimination;
        _xpMvp           = ligue.XpBonusMvp;

        _games              = await LeagueService.GetGamesAsync();
        _selectedGameNom    = _games.FirstOrDefault(g => g.Id == ligue.GameId)?.Nom ?? "";
        _versions           = await LeagueService.GetVersionsAsync(ligue.GameId);
        _selectedVersionNom = _versions.FirstOrDefault(v => v.Id == ligue.RulesVersionId)?.Nom ?? "";

        // Le staff vient de la LIGUE, pas des règles : il a pu être ajusté à la
        // création, et le recharger depuis les règles écraserait cet ajustement.
        _staff = await StaffService.GetStaffLigueAsync(ligue.Id);
    }

    /// <summary>
    /// Reprend le staff défini sur la version de règles sélectionnée, en copie de
    /// travail. Même principe que le barème d'XP : les règles fournissent les
    /// valeurs par défaut, la ligue en garde sa propre version.
    /// </summary>
    async Task ChargerStaffAsync()
    {
        var version = _versions.FirstOrDefault(v => v.Nom == _selectedVersionNom);
        if (version is null) { _staff = []; return; }

        var source = await StaffService.GetStaffTypesAsync(version.Id);
        _staff = source.Select(s => new LeagueStaffType
        {
            StaffTypeId          = s.Id,
            Nom                  = s.Nom,
            Description          = s.Description,
            Ordre                = s.Ordre,
            EstActif             = s.EstActif,
            // Le prix des relances vient de la race : ne pas le figer dans la ligue.
            Cout                 = s.CoutDepuisTypeEquipe ? 0 : s.Cout,
            CoutDepuisTypeEquipe = s.CoutDepuisTypeEquipe,
            MinCreation          = s.MinCreation,
            MaxCreation          = s.MaxCreation,
            MaxLigue             = s.MaxLigue,
            // Sans cette ligne le drapeau repart au défaut C# (true) et les Fans
            // dévoués, hors VEA dans les règles, RÉINTÉGRAIENT la VEA de toute
            // ligue créée depuis cet écran. Copie champ par champ = tout champ
            // neuf doit être ajouté ici aussi.
            CompteDansVea        = s.CompteDansVea
        }).ToList();
    }

    /// <summary>Active ou retire le plafond de ligue d'un staff.</summary>
    void BasculerPlafond(LeagueStaffType staff, bool plafonne) =>
        staff.MaxLigue = plafonne ? Math.Max(staff.MaxCreation, 1) : null;

    /// <summary>
    /// Reprend le barème d'XP défini sur la version de règles sélectionnée (R6).
    /// Le commissaire peut ensuite l'ajuster pour cette ligue.
    /// </summary>
    void AppliquerBaremeDeVersion(GameType gameType)
    {
        var version = _versions.FirstOrDefault(v => v.Nom == _selectedVersionNom);
        var bareme  = XpBareme.DeVersion(version, gameType);
        _xpTd           = bareme.ParTouchdown;
        _xpPasse        = bareme.ParPasse;
        _xpInterception = bareme.ParInterception;
        _xpElimination  = bareme.ParElimination;
        _xpMvp          = bareme.BonusMvp;

        // Le barème de CLASSEMENT suit la même règle : défaut porté par les
        // règles, ajustable pour la ligue. En édition on n'y touche pas — la
        // ligue a déjà le sien, et il se règle depuis sa fiche.
        if (!EstEdition) _baremePoints = BaremePoints.DeVersion(version);
    }

    async Task OnVersionChanged(string nom)
    {
        _selectedVersionNom = nom;
        var game = _games.FirstOrDefault(g => g.Nom == _selectedGameNom);
        if (game is not null) AppliquerBaremeDeVersion(game.Type);
        await ChargerStaffAsync();
    }

    async Task OnGameNameChanged(string nom)
    {
        _selectedGameNom = nom;
        _versions = [];
        _selectedVersionNom = "";
        StateHasChanged();

        var game = _games.FirstOrDefault(g => g.Nom == nom);
        if (game is not null)
        {
            _versions = await LeagueService.GetVersionsAsync(game.Id);
            var active = _versions.FirstOrDefault(v => v.EstActive) ?? _versions.FirstOrDefault();
            _selectedVersionNom = active?.Nom ?? "";

            AppliquerBaremeDeVersion(game.Type);
            await ChargerStaffAsync();
        }
        StateHasChanged();
    }

    async Task HandleSubmit()
    {
        _nomError = string.IsNullOrWhiteSpace(_nom);
        if (_nomError)
        {
            Snackbar.Add("Le nom de la ligue est obligatoire.", Severity.Warning);
            return;
        }

        var game    = _games.FirstOrDefault(g => g.Nom == _selectedGameNom);
        var version = _versions.FirstOrDefault(v => v.Nom == _selectedVersionNom);

        if (game is null || version is null)
        {
            Snackbar.Add("Veuillez sélectionner un jeu et une version des règles.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

            var nbPlayoff = _nbEquipesLabel switch { Playoff2 => 2, Playoff8 => 8, _ => 4 };

            var ligue = new League
            {
                Nom                    = _nom.Trim(),
                Description            = _description.Trim(),
                GameId                 = game.Id,
                RulesVersionId         = version.Id,
                Format                 = _format,
                BudgetDepart           = _budget,
                NombreEquipesPlayoff   = nbPlayoff,
                ModeBrouillard         = _modeBrouillard,
                XpParTouchdown         = _xpTd,
                XpParPasse             = _xpPasse,
                XpParInterception      = _xpInterception,
                XpParElimination       = _xpElimination,
                XpBonusMvp             = _xpMvp,
            };

            if (EstEdition)
            {
                // Staff transmis seulement s'il est encore modifiable : le
                // service refuse tout staff dès qu'une équipe est inscrite.
                await LeagueService.ModifierLigueAsync(
                    Id!.Value, ligue, userId, _structurantsOuverts ? _staff : null);
                Snackbar.Add("Ligue modifiée.", Severity.Success);
                Nav.NavigateTo($"/ligues/{Id.Value}");
            }
            else
            {
                await LeagueService.CreerLigueAsync(ligue, userId, _staff, _baremePoints, _paliersPoints);
                Snackbar.Add("Ligue créée avec succès !", Severity.Success);
                Nav.NavigateTo("/ligues");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
