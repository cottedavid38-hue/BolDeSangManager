@page "/ligues/{Id:int}"
@rendermode InteractiveServer
@inject LeagueService LeagueService
@inject TeamService TeamService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject BolDeSangManager.Services.IAuthorizationService Auth
@inject MarkdownService Markdown
@inject PdfService PdfService
@inject IJSRuntime JS
@inject CalendrierService CalendrierService
@inject LeagueNotificationService Notifications
@implements IDisposable

<PageTitle>@(_ligue?.Nom ?? "Ligue") — BolDeSang Manager</PageTitle>

@if (_ligue is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else
{
    <!-- En-tête -->
    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Error"><b>@_ligue.Nom</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @_ligue.Game?.Nom — @_ligue.RulesVersion?.Nom
                | Commissaire : @DisplayHelpers.NomCoach(_ligue.Commissaire)
            </MudText>
        </div>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
            <MudChip T="string" Color="@LeagueColor(_ligue.Statut)">@LeagueLabel(_ligue.Statut)</MudChip>
            @* Bascule vue coach / vue commissaire. Visible DANS LES DEUX
               positions — la masquer en vue coach enfermerait l'utilisateur
               sans retour possible. Purement cosmétique : le serveur revérifie
               les droits, et les actions testent _peutGererLigue. *@
            @if (_peutGererLigue)
            {
                <MudSwitch T="bool" Value="_vueCommissaire" ValueChanged="BasculerVue"
                           Color="Color.Primary" Size="Size.Small"
                           ThumbIcon="@(_vueCommissaire ? Icons.Material.Filled.Shield : Icons.Material.Filled.Person)"
                           ThumbIconColor="Color.Surface"
                           Label="@(_vueCommissaire ? "Vue commissaire" : "Vue coach")" />
            }
            @if (_estCommissaire)
            {
                @if (_ligue.Statut == LeagueStatus.Creation)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                              OnClick="OuvrirInscriptions">
                        Ouvrir les inscriptions
                    </MudButton>
                }
                @if (_ligue.Statut == LeagueStatus.Inscription && _ligue.Equipes.Count >= 2)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                              OnClick="LancerSaison">
                        @(DisplayHelpers.SansCalendrier(_ligue.Format) ? "Ouvrir la ligue" : "Lancer la saison")
                    </MudButton>
                }
                @* Paramètres de la ligue : nom, format, barème de PSP, et — tant
                   qu'aucune équipe n'est inscrite — jeu, version des règles,
                   budget et staff. Le staff n'a plus d'écran dédié : il est
                   réglé depuis ce même formulaire. *@
                @if (_peutGererLigue && DisplayHelpers.ParametresLigueEditables(_ligue.Statut))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Settings"
                               Href="@($"/ligues/{Id}/modifier")">
                        Modifier la ligue
                    </MudButton>
                }
                @if (DisplayHelpers.CalendrierEditable(_ligue.Statut, _ligue.Format))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                              StartIcon="@Icons.Material.Filled.EditCalendar"
                              OnClick="@(() => Nav.NavigateTo($"/ligues/{Id}/calendrier"))">
                        @(_ligue.Statut < LeagueStatus.EnCours ? "Préparer le calendrier" : "Composer le calendrier")
                    </MudButton>
                }
                @* Phase de repos en cours : chaque coach concerné doit pouvoir
                   valider son après-match sans match. Ce bloc est HORS du test
                   commissaire (voir plus bas) : il s'adresse aux coaches. *@
                @* — bloc déplacé hors de @if (_estCommissaire) — *@
                @* Phase de repos : entre saison régulière et play-offs, chaque
                   équipe fait un après-match sans avoir joué (progression,
                   recrutement) et les « rate le prochain match » sont levés.
                   Le service existait sans aucun écran pour le déclencher. *@
                @if (_ligue.Statut == LeagueStatus.EnCours
                     && DisplayHelpers.AvecPlayoffs(_ligue.Format))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Bedtime"
                               OnClick="LancerPhaseDeRepos">
                        Phase de repos
                    </MudButton>
                }
                @* Le service accepte EnCours ET PhaseDeRepos : sans ce second cas,
                   une ligue passée en phase de repos n'aurait plus aucun bouton
                   pour lancer ses play-offs — impasse. *@
                @if (_ligue.Statut is LeagueStatus.EnCours or LeagueStatus.PhaseDeRepos
                     && DisplayHelpers.AvecPlayoffs(_ligue.Format))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                              OnClick="LancerPlayoffs">
                        Générer les play-offs
                    </MudButton>
                }
                @if (_ligue.Statut == LeagueStatus.PlayOffs
                     || (DisplayHelpers.SansCalendrier(_ligue.Format) && _ligue.Statut == LeagueStatus.EnCours))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Small"
                              OnClick="TerminerLigue">
                        Clôturer la ligue
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Scoreboard"
                           OnClick="OuvrirBaremePoints">
                    Barème du classement
                </MudButton>
                @* Bouton et NON interrupteur : un second MudSwitch dans cette
                   barre se confondait avec la bascule vue coach / vue commissaire
                   juste à côté, alors que les deux n'ont rien à voir — celle-là
                   ne change que MON affichage, celui-ci est un réglage de ligue
                   qui s'applique à TOUS les coaches.
                   ⚠️ title HTML et non MudTooltip : ce dernier casse le circuit
                   Blazor en InteractiveServer. *@
                @if (!DisplayHelpers.SansCalendrier(_ligue.Format))
                {
                    <MudButton Variant="@(_ligue.ModeBrouillard ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Error" Size="Size.Small"
                               StartIcon="@(_ligue.ModeBrouillard ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                               OnClick="@(() => BasculerBrouillard(!_ligue.ModeBrouillard))"
                               title="@(_ligue.ModeBrouillard
                                        ? "Actuellement ACTIF : les coaches ne voient que leur prochain match et les matchs déjà joués. Cliquez pour désactiver."
                                        : "Actuellement inactif : tout le calendrier est visible des coaches. Cliquez pour activer.")">
                        @(_ligue.ModeBrouillard ? "Brouillard actif" : "Brouillard")
                    </MudButton>
                }
            }
            @* Phase de repos : accessible aux COACHES, donc hors du bloc
               commissaire ci-dessus. Sans ce lien, l'écran de phase de repos
               serait inatteignable pour ceux à qui il s'adresse. *@
            @if (_ligue.Statut == LeagueStatus.PhaseDeRepos)
            {
                @foreach (var eq in _ligue.Equipes.Where(e => e.CoachId == _currentUserId))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Bedtime"
                               Href="@($"/ligues/{Id}/repos/{eq.Id}")">
                        Phase de repos — @eq.Nom
                    </MudButton>
                }
            }
            @if (DisplayHelpers.InscriptionOuverte(_ligue.Statut, _ligue.Format))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                          Href="@($"/equipes/rejoindre?ligueId={_ligue.Id}")">
                    @(_estInscrit ? "Inscrire une autre équipe" : "Rejoindre la ligue")
                </MudButton>
            }
        </MudStack>
    </MudStack>

    @if (_ligue is not null)
    {
        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">Commissaires de ligue</MudText>
                @if (_estCommissaire)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="OuvrirModalePromotion">
                        Promouvoir un coach
                    </MudButton>
                }
            </MudStack>
            @if (_commissaires.Any())
            {
                <MudList T="LeagueCommissioner" Dense="true" Class="mt-2">
                    @foreach (var c in _commissaires)
                    {
                        <MudListItem T="LeagueCommissioner" Value="@c">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@DisplayHelpers.NomCoach(c.User)</MudText>
                                @if (_estCommissaire)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => RetirerCommissaireAsync(c.UserId))" />
                                }
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mt-2">Aucun commissaire de ligue pour l'instant.</MudText>
            }
        </MudPaper>
    }

    @* Vue coach active alors que l'utilisateur a les droits : sans ce bandeau,
       l'écran ment — un commissaire ne comprendrait pas pourquoi ses outils ont
       disparu, ni pourquoi le calendrier est partiel (le mode brouillard
       s'applique aussi en vue coach, c'est le but de la prévisualisation). *@
    @if (_peutGererLigue && !_vueCommissaire)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            <b>Vue coach</b> — vous voyez cette ligue comme un coach.
            Activez la <b>vue commissaire</b> pour retrouver vos outils de gestion.
            @if (!_estInscrit)
            {
                <text> Vous n'avez pas d'équipe ici : il est normal que peu de matchs s'affichent.</text>
            }
        </MudAlert>
    }

    <MudTabs Elevation="1" Rounded="true" Class="tabs-compact" PanelClass="pt-4">
        <!-- Classement -->
        <MudTabPanel Text="Classement" Icon="@Icons.Material.Filled.Leaderboard">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="display:block">
                Barème : @ResumeBareme()
            </MudText>

            @if (_matchsSansTours > 0 && _peutGererLigue)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    @_matchsSansTours match(s) joué(s) sans nombre de tours : ils comptent
                    avec les points de base. Ouvrez leur feuille pour compléter, puis
                    réenregistrez le barème.
                </MudAlert>
            }

            @foreach (var division in _ligue.Divisions.OrderBy(d => d.Ordre))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@division.Nom</b></MudText>
                <MudTable Items="@GetEquipesSorted(division)"
                          Dense="true" Hover="true" Elevation="0" Class="mb-4">
                    <HeaderContent>
                        <MudTh>Équipe</MudTh>
                        <MudTh>Coach</MudTh>
                        <MudTh>Race/Collège</MudTh>
                        <MudTh Style="text-align:center">J</MudTh>
                        <MudTh Style="text-align:center">V</MudTh>
                        <MudTh Style="text-align:center">N</MudTh>
                        <MudTh Style="text-align:center">D</MudTh>
                        <MudTh Style="text-align:center">TDs +</MudTh>
                        <MudTh Style="text-align:center">TDs -</MudTh>
                        <MudTh Style="text-align:center">Pts</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="equipe">
                        <MudTd DataLabel="Équipe">
                            <MudLink Href="@($"/equipes/{equipe.Id}")">@equipe.Nom</MudLink>
                        </MudTd>
                        <MudTd DataLabel="Coach">@DisplayHelpers.NomCoach(equipe.Coach)</MudTd>
                        <MudTd DataLabel="Race/Collège">@equipe.TeamType?.Nom</MudTd>
                        <MudTd DataLabel="Joués" Style="text-align:center">@equipe.NombreMatchsJoues</MudTd>
                        <MudTd DataLabel="Victoires" Style="text-align:center">@equipe.NombreVictoires</MudTd>
                        <MudTd DataLabel="Nuls" Style="text-align:center">@equipe.NombreNuls</MudTd>
                        <MudTd DataLabel="Défaites" Style="text-align:center">@equipe.NombreDefaites</MudTd>
                        <MudTd DataLabel="TDs marqués" Style="text-align:center" Class="mud-success-text">@equipe.TouchdownsMarques</MudTd>
                        <MudTd DataLabel="TDs encaissés" Style="text-align:center" Class="mud-error-text">@equipe.TouchdownsConcedes</MudTd>
                        <MudTd DataLabel="Points" Style="text-align:center"><b>@equipe.PointsLigue</b></MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- Pool de matchs -->
        <MudTabPanel Text="Matchs" Icon="@Icons.Material.Filled.SportsSoccer">
            @if (DisplayHelpers.SansCalendrier(_ligue.Format) && _ligue.Statut == LeagueStatus.EnCours)
            {
                <MudPaper Class="pa-3 mb-3" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Proposer une rencontre</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                        Ligue Open : composez librement une rencontre. La feuille de match
                        sera confirmée par l'équipe adverse, comme d'habitude.
                    </MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        @* T="int?" et non "int" : avec un int non nullable, la valeur
                           par defaut 0 s'affiche telle quelle dans le champ (« 0 »)
                           au lieu de laisser le libelle et un champ vide.
                           ToStringFunc est indispensable : sans elle le champ affiche
                           l'identifiant brut de l'equipe (« 32 ») une fois choisie. *@
                        <MudSelect T="int?" @bind-Value="_openDomicileId" Label="Domicile"
                                   ToStringFunc="@NomEquipeOpen"
                                   Placeholder="Choisir une équipe" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="equipe-select">
                            @foreach (var e in _ligue.Equipes.OrderBy(e => e.Nom))
                            {
                                <MudSelectItem T="int?" Value="@e.Id">@e.Nom</MudSelectItem>
                            }
                        </MudSelect>
                        <MudText Typo="Typo.body2" Color="Color.Secondary"><b>vs</b></MudText>
                        <MudSelect T="int?" @bind-Value="_openExterieurId" Label="Extérieur"
                                   ToStringFunc="@NomEquipeOpen"
                                   Placeholder="Choisir une équipe" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="equipe-select">
                            @foreach (var e in _ligue.Equipes.OrderBy(e => e.Nom))
                            {
                                <MudSelectItem T="int?" Value="@e.Id">@e.Nom</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AddCircle"
                                   Disabled="@(_openDomicileId is null || _openExterieurId is null
                                               || _openDomicileId == _openExterieurId || _creationRencontre)"
                                   OnClick="ProposerRencontre">
                            Créer la rencontre
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @NbAvecDate() match(s) sur @NbMatchsVisibles() ont une date fixée
                </MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @* Abonnement : reserve a un coach engage ici, le flux ne
                       contenant que SES matchs. Il ne depend PAS d'une date deja
                       fixee : les dates a venir arrivent toutes seules.
                       UserId avec @ (parametre string, cf. le piege connu). *@
                    @if (MesEquipeIds().Count > 0)
                    {
                        <BoutonAbonnementCalendrier UserId="@_currentUserId" LigueId="Id" />
                    }
                    @* Calendrier COMPLET de la ligue, a diffuser aux participants.
                       Reserve au commissaire : c'est lui qui decide de publier.
                       Visible meme sans equipe engagee, contrairement au flux
                       personnel juste au-dessus. *@
                    @* _estCommissaire (et non _peutGererLigue) : ce bouton est un
                       OUTIL de commissaire, il doit donc disparaitre en vue coach
                       comme les autres. *@
                    @if (_estCommissaire)
                    {
                        <BoutonAbonnementCalendrier UserId="@_currentUserId" LigueId="Id"
                                                    LigueComplete="true"
                                                    BrouillardActif="_ligue.ModeBrouillard" />
                    }
                </MudStack>
            </MudStack>
            @if (_ligue.ModeBrouillard && !_estCommissaire)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <b>Mode brouillard</b> — vous ne voyez que votre prochain match et les
                    rencontres déjà jouées. Le reste du calendrier apparaîtra au fur et à mesure.
                </MudAlert>
            }
            @foreach (var division in _ligue.Divisions.OrderBy(d => d.Ordre))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-3"><b>@division.Nom</b></MudText>

                @foreach (var ronde in MatchsVisibles(division).GroupBy(m => m.Ronde).OrderBy(g => g.Key))
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">
                        @DisplayHelpers.RondeLabel(ronde.Key)
                    </MudText>
                    <MudGrid Class="mb-4">
                        @foreach (var match in ronde)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <CarteMatch Match="match"
                                            UserId="@_currentUserId"
                                            EstCommissaire="_estCommissaire"
                                            MesEquipes="MesEquipeIds()"
                                            Change="RechargerLigue" />
                            </MudItem>
                        }
                    </MudGrid>
                }
            }
        </MudTabPanel>

        <!-- Équipes inscrites -->
        <MudTabPanel Text="@($"Équipes ({_ligue.Equipes.Count})")" Icon="@Icons.Material.Filled.Group">
            <MudGrid>
                @foreach (var equipe in _ligue.Equipes)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="1" Style="cursor:pointer"
                                @onclick="@(() => Nav.NavigateTo($"/equipes/{equipe.Id}"))">
                            <MudCardContent>
                                <MudText Typo="Typo.h6"><b>@equipe.Nom</b></MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @DisplayHelpers.NomCoach(equipe.Coach)
                                </MudText>
                                <MudText Typo="Typo.body2">@equipe.TeamType?.Nom</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <!-- Calendrier mensuel (#1) -->
        <MudTabPanel Text="Calendrier" Icon="@Icons.Material.Filled.CalendarMonth">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                   title="Mois précédent" OnClick="@(() => ChangerMois(-1))" />
                    <MudText Typo="Typo.subtitle1" Style="min-width:190px;text-align:center">
                        <b>@MoisAffiche()</b>
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                   title="Mois suivant" OnClick="@(() => ChangerMois(1))" />
                    @if (_moisCourant != PremierDuMois(DateTime.Today))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RevenirAujourdhui">
                            Aujourd'hui
                        </MudButton>
                    }
                </MudStack>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @* Abonnement : reserve a un coach engage ici, le flux ne
                       contenant que SES matchs. Il ne depend PAS d'une date deja
                       fixee : les dates a venir arrivent toutes seules.
                       UserId avec @ (parametre string, cf. le piege connu). *@
                    @if (MesEquipeIds().Count > 0)
                    {
                        <BoutonAbonnementCalendrier UserId="@_currentUserId" LigueId="Id" />
                    }
                    @* Calendrier COMPLET de la ligue, a diffuser aux participants.
                       Reserve au commissaire : c'est lui qui decide de publier.
                       Visible meme sans equipe engagee, contrairement au flux
                       personnel juste au-dessus. *@
                    @* _estCommissaire (et non _peutGererLigue) : ce bouton est un
                       OUTIL de commissaire, il doit donc disparaitre en vue coach
                       comme les autres. *@
                    @if (_estCommissaire)
                    {
                        <BoutonAbonnementCalendrier UserId="@_currentUserId" LigueId="Id"
                                                    LigueComplete="true"
                                                    BrouillardActif="_ligue.ModeBrouillard" />
                    }
                </MudStack>
            </MudStack>

            @if (_ligue.ModeBrouillard && !_estCommissaire)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Mode brouillard : vous ne voyez que vos matchs joués et votre prochaine rencontre.
                </MudAlert>
            }

            @{
                var matchsDuMois = MatchsDuMois();
            }
            @if (matchsDuMois.Count == 0)
            {
                <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3">
                    Aucun match programmé en @MoisAffiche().
                </MudAlert>
            }

            <!-- grille du mois -->
            <div class="calendrier-grille">
                @foreach (var jour in new[] { "lun", "mar", "mer", "jeu", "ven", "sam", "dim" })
                {
                    <div class="calendrier-entete">@jour</div>
                }
                @foreach (var jour in JoursAffiches())
                {
                    var duJour = matchsDuMois.Where(m => DateLocaleDe(m).Date == jour.Date).ToList();
                    var horsMois = jour.Month != _moisCourant.Month;
                    var rondesDuJour = _echeances.Where(e => e.Value.Date == jour.Date)
                                                 .Select(e => e.Key).OrderBy(r => r).ToList();
                    <div class="calendrier-case @(horsMois ? "hors-mois" : "") @(jour.Date == DateTime.Today ? "aujourdhui" : "")">
                        <div class="calendrier-numero">@jour.Day</div>
                        @foreach (var r in rondesDuJour)
                        {
                            <div class="calendrier-echeance"
                                 title="@($"Fin de la ronde {r} : les matchs devraient être joués avant cette date (indicatif)")">
                                Fin ronde @r
                            </div>
                        }
                        @foreach (var m in duJour)
                        {
                            <div class="calendrier-match" @onclick="@(() => Nav.NavigateTo($"/matchs/{m.Id}/detail"))"
                                 title="@($"{m.EquipeDomicile?.Nom} vs {m.EquipeExterieur?.Nom}{(string.IsNullOrWhiteSpace(m.Lieu) ? "" : $" — {m.Lieu}")}")">
                                <b>@DateLocaleDe(m).ToString("HH'h'mm")</b>
                                @($"{Abrege(m.EquipeDomicile?.Nom)} – {Abrege(m.EquipeExterieur?.Nom)}")
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- détail sous la grille : lisible sur mobile -->
            @{
                var echeancesDuMois = _echeances
                    .Where(e => e.Value.Month == _moisCourant.Month && e.Value.Year == _moisCourant.Year)
                    .OrderBy(e => e.Value).ToList();
            }
            @if (echeancesDuMois.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2"><b>Fins de ronde du mois</b></MudText>
                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <tbody>
                        @foreach (var e in echeancesDuMois)
                        {
                            var passee = e.Value.Date < DateTime.Today;
                            <tr>
                                <td style="white-space:nowrap">
                                    <b>@e.Value.ToString("ddd d MMM")</b>
                                </td>
                                <td>
                                    Fin de la <b>ronde @e.Key</b>
                                    <br />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Date indicative — rien n'est bloqué à l'échéance.
                                    </MudText>
                                </td>
                                <td style="white-space:nowrap">
                                    @if (passee)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Échue</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">À venir</MudChip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (matchsDuMois.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2"><b>Détail du mois</b></MudText>
                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <tbody>
                        @foreach (var m in matchsDuMois.OrderBy(DateLocaleDe))
                        {
                            <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/matchs/{m.Id}/detail"))">
                                <td style="white-space:nowrap">
                                    <b>@DateLocaleDe(m).ToString("ddd d MMM")</b><br />
                                    <span style="color:#9e9e9e">@DateLocaleDe(m).ToString("HH'h'mm")</span>
                                </td>
                                <td>
                                    @m.EquipeDomicile?.Nom <span style="color:#9e9e9e">vs</span> @m.EquipeExterieur?.Nom
                                    @if (!string.IsNullOrWhiteSpace(m.Lieu))
                                    {
                                        <br />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@m.Lieu</MudText>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    <MudChip T="string" Size="Size.Small" Color="@MatchColor(m.Statut)">
                                        @MatchLabel(m.Statut)
                                    </MudChip>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (NbSansDate() > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
                    @NbSansDate() match(s) de la ligue n'ont pas encore de date fixée.
                </MudAlert>
            }
        </MudTabPanel>

        <!-- Règlement de la ligue (R5) -->
        <MudTabPanel Text="Règlement" Icon="@Icons.Material.Filled.Gavel">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.subtitle1"><b>Règlement</b></MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               OnClick="ExporterReglementPdf"
                               Disabled="@(_exportReglement || string.IsNullOrWhiteSpace(_ligue.Reglement))">
                        @(_exportReglement ? "Génération…" : "Exporter en PDF")
                    </MudButton>
                    @if (_estCommissaire)
                    {
                        @if (!_editionReglement)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="DemarrerEditionReglement">Modifier</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       OnClick="@(() => _editionReglement = false)">Annuler</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="EnregistrerReglement"
                                       Disabled="@_sauvegardeReglement">
                                @(_sauvegardeReglement ? "Enregistrement…" : "Sauvegarder")
                            </MudButton>
                        }
                    }
                </MudStack>
            </MudStack>

            @if (_editionReglement)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Mise en forme <b>markdown</b> : <code># Titre</code>, <code>## Sous-titre</code>,
                    <code>- liste</code>, <code>**gras**</code>, <code>*italique*</code>,
                    <code>&gt; citation</code>, <code>---</code> pour un séparateur.
                </MudAlert>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_reglementBrouillon" Label="Règlement (markdown)"
                                      Variant="Variant.Outlined" Lines="22" AutoGrow="false"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-4" Style="min-height:520px">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Aperçu</MudText>
                            <div class="reglement-rendu">
                                @((MarkupString)Markdown.VersHtml(_reglementBrouillon))
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
            else if (string.IsNullOrWhiteSpace(_ligue.Reglement))
            {
                <MudAlert Severity="Severity.Normal" Dense="true">
                    Aucun règlement n'a encore été rédigé pour cette ligue.
                    @if (_estCommissaire)
                    {
                        <text> Cliquez sur « Modifier » pour le rédiger.</text>
                    }
                </MudAlert>
            }
            else
            {
                <MudPaper Outlined="true" Class="pa-4">
                    <div class="reglement-rendu">
                        @((MarkupString)Markdown.VersHtml(_ligue.Reglement))
                    </div>
                </MudPaper>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public int Id { get; set; }

    League? _ligue;

    /// <summary>
    /// Droit RÉEL de gérer cette ligue (Admin, GrandCommissaire ou commissaire
    /// de la ligue). Ne dépend pas de la bascule d'affichage : toute ACTION doit
    /// tester ce champ, jamais <see cref="_estCommissaire"/>.
    /// </summary>
    bool _peutGererLigue;

    /// <summary>
    /// Position de la bascule « vue commissaire ». Défaut : false — un
    /// commissaire arrive sur sa ligue comme un coach et n'active ses droits
    /// qu'au besoin (choix produit).
    /// </summary>
    bool _vueCommissaire;

    /// <summary>
    /// Ce que l'AFFICHAGE doit considérer. Propriété calculée : les nombreux
    /// endroits qui la lisaient déjà (en-tête, brouillard, règlement, cartes de
    /// match, MatchsVisibles) suivent la bascule sans modification.
    ///
    /// ⚠️ Purement cosmétique. Le serveur revérifie les droits dans tous les
    /// cas ; masquer un bouton n'a jamais été une sécurité.
    /// </summary>
    bool _estCommissaire => _peutGererLigue && _vueCommissaire;

    bool _estInscrit;
    List<LeagueCommissioner> _commissaires = [];
    string _currentUserId = "";

    /// <summary>Clé de préférence, préfixée par l'utilisateur : deux comptes sur
    /// le même navigateur ne doivent pas hériter de la position de l'autre.</summary>
    string CleVue => $"bdsm.vueCommissaire.{_currentUserId}";

    protected override async Task OnInitializedAsync()
    {
        _ligue = await LeagueService.GetLigueAsync(Id);

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

        _peutGererLigue = _ligue is not null
            && await Auth.PeutGererLigueAsync(_currentUserId, _ligue.Id);
        _estInscrit = _ligue?.Equipes.Any(e => e.CoachId == _currentUserId) ?? false;

        // Échéances indicatives de fin de ronde (format Libre), affichées dans
        // le calendrier de la ligue. Ce sont des DATES (stockées à midi UTC) :
        // aucune conversion de fuseau, sinon la date affichée dériverait d'un jour.
        if (_ligue is not null)
            _echeances = (await LeagueService.GetEcheancesRondesAsync(_ligue.Id))
                .ToDictionary(e => e.Key, e => e.Value.Date);

        await ChargerCommissairesAsync();

        _matchsSansTours = await LeagueService.CompterMatchsSansNombreDeToursAsync(Id);

        // Temps réel : la page ne lisait la base qu'ICI, une seule fois. Un coach
        // qui laissait l'écran ouvert pendant que le commissaire lançait la
        // saison continuait de voir « Inscriptions », sans le bloc « Proposer
        // une rencontre » — et sans comprendre pourquoi.
        Notifications.LigueModifiee += SurLigueModifieeAsync;
    }

    /// <summary>
    /// Rafraîchit l'écran quand CETTE ligue change, quel que soit l'utilisateur
    /// à l'origine du changement.
    ///
    /// Les données sont relues avec les droits de l'utilisateur COURANT (rôle,
    /// mode brouillard) : on ne recopie jamais un état préparé pour quelqu'un
    /// d'autre. InvokeAsync est obligatoire — l'événement arrive depuis le
    /// circuit d'un AUTRE utilisateur, il faut repasser sur celui de ce
    /// composant avant de toucher à son rendu.
    /// </summary>
    private async Task SurLigueModifieeAsync(int ligueId)
    {
        if (ligueId != Id) return;

        await InvokeAsync(async () =>
        {
            // ignorerCache : le DbContext vit aussi longtemps que le circuit,
            // donc que l'onglet. Sans vidage, EF rend l'entité chargée à
            // l'ouverture et l'écran se « rafraîchit » sur l'ancien statut.
            _ligue = await LeagueService.GetLigueAsync(Id, ignorerCache: true);
            if (_ligue is not null)
                _echeances = (await LeagueService.GetEcheancesRondesAsync(_ligue.Id))
                    .ToDictionary(e => e.Key, e => e.Value.Date);
            await ChargerCommissairesAsync();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Désabonnement OBLIGATOIRE : le service est un singleton, il survivrait à
    /// la page et garderait en vie un composant détruit (fuite mémoire, rendu
    /// sur un circuit fermé).
    /// </summary>
    public void Dispose() => Notifications.LigueModifiee -= SurLigueModifieeAsync;

    async Task ChargerCommissairesAsync()
    {
        if (_ligue is null) return;
        _commissaires = await LeagueService.GetCommissairesDeLigueAsync(_ligue.Id);
        _peutGererLigue = await Auth.PeutGererLigueAsync(_currentUserId, _ligue.Id);
    }

    /// <summary>
    /// Matchs joués dont le nombre de tours manque, alors que la ligue a des
    /// paliers. Vaut 0 sans palier : l'information ne servirait à rien.
    /// </summary>
    int _matchsSansTours;

    string ResumeBareme()
    {
        if (_ligue is null) return "";
        var b = BaremePoints.DeLigue(_ligue);

        // On lit dans l'ordre du match : les points de base d'abord, puis les
        // paliers par seuil croissant — c'est la chronologie d'une rencontre.
        var parts = new List<string> { $"V {b.Victoire} · N {b.Nul} · D {b.Defaite}" };
        foreach (var p in b.Paliers.OrderBy(p => p.APartirDuTour))
            parts.Add($"à partir du tour {p.APartirDuTour} : V {p.Victoire} · N {p.Nul} · D {p.Defaite}");

        var bonus = new List<string>();
        if (b.ParTouchdown > 0)    bonus.Add($"TD {b.ParTouchdown}");
        if (b.ParElimination > 0)  bonus.Add($"Élim {b.ParElimination}");
        if (b.ParInterception > 0) bonus.Add($"Int {b.ParInterception}");
        if (b.ParPasse > 0)        bonus.Add($"Passe {b.ParPasse}");
        if (b.ParDeviation > 0)    bonus.Add($"Dév {b.ParDeviation}");
        if (b.ParAgression > 0)    bonus.Add($"Agr {b.ParAgression}");
        if (bonus.Count > 0) parts.Add("bonus " + string.Join(" · ", bonus));

        return string.Join(" — ", parts);
    }

    async Task OuvrirBaremePoints()
    {
        if (_ligue is null) return;

        var parameters = new DialogParameters<BaremePointsDialog>
        {
            { x => x.LigueId, _ligue.Id },
            { x => x.Bareme, BaremePoints.DeLigue(_ligue) },
        };
        var dialog = await DialogService.ShowAsync<BaremePointsDialog>("Barème du classement", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            // Relire en vidant le cache EF : le DbContext est lié au circuit, il
            // rendrait sinon les anciennes valeurs et les anciens totaux.
            _ligue = await LeagueService.GetLigueAsync(Id, ignorerCache: true);
            _matchsSansTours = await LeagueService.CompterMatchsSansNombreDeToursAsync(Id);
        }
    }

    async Task OuvrirModalePromotion()
    {
        if (_ligue is null) return;
        var coaches = await LeagueService.GetCoachesPromouvablesAsync(_ligue.Id);
        var parameters = new DialogParameters<PromotionDialog>
        {
            { x => x.LigueId, _ligue.Id },
            { x => x.Coaches, coaches },
        };
        var dialog = await DialogService.ShowAsync<PromotionDialog>("Promouvoir un coach", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await ChargerCommissairesAsync();
    }

    async Task RetirerCommissaireAsync(string userId)
    {
        if (_ligue is null) return;
        await LeagueService.RetirerCommissaireDeLigueAsync(_ligue.Id, userId);
        await ChargerCommissairesAsync();
        Snackbar.Add("Commissaire retiré", Severity.Success);
    }

    async Task OuvrirInscriptions()
    {
        await LeagueService.DemarrerInscriptionsAsync(Id);
        Snackbar.Add("Inscriptions ouvertes !", Severity.Success);
        _ligue = await LeagueService.GetLigueAsync(Id);
    }

    int? _openDomicileId, _openExterieurId;

    /// <summary>
    /// Libellé affiché dans les listes « Proposer une rencontre » : sans elle,
    /// MudBlazor affiche la valeur liée telle quelle, donc l'identifiant.
    /// </summary>
    string NomEquipeOpen(int? id) =>
        _ligue?.Equipes.FirstOrDefault(e => e.Id == id)?.Nom ?? string.Empty;
    bool _creationRencontre;

    /// <summary>
    /// Format Open : crée une rencontre à la volée. Ouvert à tous les
    /// participants — la confirmation passe par la feuille de match adverse.
    /// </summary>
    async Task ProposerRencontre()
    {
        if (_openDomicileId is not int domicile || _openExterieurId is not int exterieur) return;

        _creationRencontre = true;
        try
        {
            await LeagueService.ProposerRencontreAsync(Id, domicile, exterieur);
            _openDomicileId = _openExterieurId = null;
            _ligue = await LeagueService.GetLigueAsync(Id);
            Snackbar.Add("Rencontre créée.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Impossible de créer cette rencontre.", Severity.Error);
        }
        finally
        {
            _creationRencontre = false;
        }
    }

    async Task LancerSaison()
    {
        try
        {
            var orphelines = await LeagueService.LancerSaisonAsync(Id);
            _ligue = await LeagueService.GetLigueAsync(Id);
            Snackbar.Add(
                _ligue is not null && DisplayHelpers.EstFormatLibre(_ligue.Format)
                    ? "Saison lancée ! Composez maintenant le calendrier."
                    : "Saison lancée ! Pool de matchs généré.",
                Severity.Success);

            // Les dates préparées avant le lancement peuvent viser des rondes que
            // le calendrier final ne contient pas : on le dit plutôt que de les
            // faire disparaître en silence.
            if (orphelines.Count > 0)
            {
                Snackbar.Add(
                    $"Échéance(s) retirée(s) : la ronde {string.Join(", ", orphelines)} n'existe pas dans le calendrier généré.",
                    Severity.Warning);
            }

            _echeances = (await LeagueService.GetEcheancesRondesAsync(Id))
                .ToDictionary(e => e.Key, e => e.Value);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>
    /// Ouvre la phase de repos : chaque équipe pourra faire son après-match sans
    /// avoir joué, et les indisponibilités « rate le prochain match » sont levées.
    /// </summary>
    async Task LancerPhaseDeRepos()
    {
        try
        {
            var restants = _ligue?.Divisions
                .SelectMany(d => d.Matchs)
                .Count(m => m.Ronde < 100
                            && m.Statut is not (MatchStatus.Termine or MatchStatus.Concede))
                ?? 0;

            var message = "Chaque équipe pourra progresser et recruter sans avoir joué, "
                        + "et les joueurs qui ratent le prochain match redeviennent disponibles."
                        + (restants > 0
                            ? $" Attention : {restants} match(s) de la saison régulière ne sont pas encore joués."
                            : "");

            var ok = await DialogService.ShowMessageBox(
                "Lancer la phase de repos ?", message,
                yesText: "Lancer", cancelText: "Annuler");

            if (ok != true) return;

            await LeagueService.LancerPhaseDeReposAsync(Id);
            Snackbar.Add("Phase de repos ouverte.", Severity.Success);
            _ligue = await LeagueService.GetLigueAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task LancerPlayoffs()
    {
        try
        {
            // Garde-fou : générer les play-offs fige le classement et rend les
            // matchs de saison régulière restants sans objet. Constaté en QA :
            // on pouvait lancer les play-offs avec 5 matchs sur 6 non joués,
            // donc un tirage arbitraire entre équipes à 0 point, sans aucun
            // avertissement. On demande confirmation plutôt que de bloquer :
            // un commissaire peut légitimement écourter une saison.
            var restants = _ligue?.Divisions
                .SelectMany(d => d.Matchs)
                .Count(m => m.Ronde < 100
                            && m.Statut is not (MatchStatus.Termine or MatchStatus.Concede))
                ?? 0;

            if (restants > 0)
            {
                var ok = await DialogService.ShowMessageBox(
                    "Générer les play-offs ?",
                    $"{restants} match(s) de la saison régulière ne sont pas encore joués. "
                    + "Les play-offs seront tirés sur le classement actuel, et ces rencontres "
                    + "resteront sans effet sur la qualification.",
                    yesText: "Générer quand même", cancelText: "Annuler");

                if (ok != true) return;
            }

            await LeagueService.GenererPlayoffsAsync(Id);
            Snackbar.Add("Play-offs générés !", Severity.Success);
            _ligue = await LeagueService.GetLigueAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task TerminerLigue()
    {
        try
        {
            await LeagueService.TerminerLigueAsync(Id);
            Snackbar.Add("Ligue clôturée !", Severity.Success);
            _ligue = await LeagueService.GetLigueAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    static IEnumerable<Team> GetEquipesSorted(Division d) =>
        d.Equipes.OrderByDescending(e => e.PointsLigue)
                 .ThenByDescending(e => e.TouchdownsMarques - e.TouchdownsConcedes);

    // ── Calendrier (#1) ───────────────────────────────────────────────────────

    /// <summary>Date UTC stockée → affichage en heure locale du lecteur.</summary>
    static string DateLocale(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime()
            .ToString("ddd d MMM 'à' HH'h'mm");

    int NbMatchsVisibles() =>
        _ligue?.Divisions.SelectMany(d => MatchsVisibles(d)).Count() ?? 0;

    /// <summary>
    /// Bascule vue coach ↔ vue commissaire, et mémorise la position.
    /// Préférence d'affichage locale : pas de migration, pas de champ en base.
    /// </summary>
    async Task BasculerVue(bool actif)
    {
        _vueCommissaire = actif;
        await JS.InvokeVoidAsync("bdsmPrefEcrire", CleVue, actif ? "1" : "0");
    }

    /// <summary>
    /// Restaure la position mémorisée de la bascule.
    ///
    /// ⚠️ localStorage n'est lisible qu'en interop JS, donc PAS dans
    /// OnInitializedAsync (prérendu serveur : aucun navigateur au bout). D'où la
    /// lecture au premier rendu. Conséquence assumée : le premier affichage est
    /// toujours en vue coach — ce qui est justement le défaut voulu, donc aucun
    /// clignotement visible pour un coach ni pour un commissaire en vue coach.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_peutGererLigue) return;

        var valeur = await JS.InvokeAsync<string?>("bdsmPrefLire", CleVue);
        if (valeur == "1")
        {
            _vueCommissaire = true;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Qui peut fixer la date d'un match (#1) : ses deux coaches et les
    /// commissaires. Le service revérifie de toute façon côté serveur.
    /// Délègue à DisplayHelpers pour rester aligné sur CarteMatch.
    /// </summary>
    bool PeutProgrammer(Match match) =>
        DisplayHelpers.PeutProgrammer(match, _currentUserId, _estCommissaire);

    /// <summary>Équipes du coach dans CETTE ligue (bouton d'après-match des cartes).</summary>
    IReadOnlySet<int> MesEquipeIds() =>
        _ligue?.Equipes.Where(e => e.CoachId == _currentUserId).Select(e => e.Id).ToHashSet()
        ?? new HashSet<int>();

    /// <summary>
    /// Rechargement après une action d'une carte (programmation d'une date).
    /// ⚠️ ignorerCache: true est obligatoire — le DbContext est scopé au circuit
    /// Blazor, donc une relecture sans purge renverrait le cache EF, pas la base.
    /// </summary>
    async Task RechargerLigue()
    {
        _ligue = await LeagueService.GetLigueAsync(Id, ignorerCache: true);
        StateHasChanged();
    }

    int NbAvecDate() =>
        _ligue?.Divisions.SelectMany(d => MatchsVisibles(d)).Count(m => m.DateProgrammee.HasValue) ?? 0;

    // ⚠️ TelechargerCalendrierLigue retiré : le téléchargement d'un fichier .ics
    // puis son import manuel était trop compliqué (impossible depuis un
    // téléphone, menu Google enfoui, et l'import ne se met jamais à jour).
    // Remplacé par l'ABONNEMENT par URL — voir BoutonAbonnementCalendrier.
    // CalendrierService reste utilisé : c'est lui qui produit le flux servi.

    // ── Vue calendrier mensuelle (#1) ─────────────────────────────────────────

    DateTime _moisCourant = PremierDuMois(DateTime.Today);

    /// <summary>Échéances indicatives de fin de ronde, par numéro de ronde (heure locale).</summary>
    Dictionary<int, DateTime> _echeances = [];

    static DateTime PremierDuMois(DateTime d) => new(d.Year, d.Month, 1);

    void ChangerMois(int delta) => _moisCourant = _moisCourant.AddMonths(delta);
    void RevenirAujourdhui() => _moisCourant = PremierDuMois(DateTime.Today);

    string MoisAffiche()
    {
        var s = _moisCourant.ToString("MMMM yyyy");
        return char.ToUpper(s[0]) + s[1..];
    }

    /// <summary>Date du match convertie en heure locale (stockage UTC).</summary>
    static DateTime DateLocaleDe(Match m) =>
        DateTime.SpecifyKind(m.DateProgrammee!.Value, DateTimeKind.Utc).ToLocalTime();

    /// <summary>
    /// Matchs datés du mois affiché, filtrés par le mode brouillard (#2) :
    /// le calendrier ne doit pas révéler ce que l'onglet Matchs masque.
    /// </summary>
    List<Match> MatchsDuMois() =>
        _ligue is null ? []
        : _ligue.Divisions.SelectMany(d => MatchsVisibles(d))
            .Where(m => m.DateProgrammee.HasValue)
            .Where(m => DateLocaleDe(m).Year == _moisCourant.Year
                     && DateLocaleDe(m).Month == _moisCourant.Month)
            .ToList();

    int NbSansDate() =>
        _ligue?.Divisions.SelectMany(d => MatchsVisibles(d))
            .Count(m => !m.DateProgrammee.HasValue
                     && m.Statut is MatchStatus.Programme or MatchStatus.AJouer) ?? 0;

    /// <summary>
    /// Les 42 cases de la grille (6 semaines) : le mois affiché, complété par
    /// les jours débordant du mois précédent et du suivant pour que chaque
    /// ligne fasse une semaine pleine, lundi en premier.
    /// </summary>
    List<DateTime> JoursAffiches()
    {
        // DayOfWeek met dimanche à 0 ; on décale pour commencer le lundi
        var decalage = ((int)_moisCourant.DayOfWeek + 6) % 7;
        var debut = _moisCourant.AddDays(-decalage);
        return Enumerable.Range(0, 42).Select(i => debut.AddDays(i)).ToList();
    }

    /// <summary>Nom d'équipe raccourci pour tenir dans une case du calendrier.</summary>
    static string Abrege(string? nom)
    {
        if (string.IsNullOrWhiteSpace(nom)) return "?";
        return nom.Length <= 12 ? nom : nom[..11] + "…";
    }

    // ── Règlement de la ligue (R5) ────────────────────────────────────────────

    bool _editionReglement;
    bool _sauvegardeReglement;
    bool _exportReglement;
    string _reglementBrouillon = "";

    void DemarrerEditionReglement()
    {
        _reglementBrouillon = _ligue?.Reglement ?? "";
        _editionReglement = true;
    }

    async Task EnregistrerReglement()
    {
        // ⚠️ Droit RÉEL, pas la bascule d'affichage : si l'utilisateur repasse en
        // vue coach pendant l'édition, l'enregistrement doit aboutir. La bascule
        // masque des boutons, elle ne retire pas des droits.
        if (_ligue is null || !_peutGererLigue) return;
        _sauvegardeReglement = true;
        try
        {
            await LeagueService.DefinirReglementAsync(_ligue.Id, _reglementBrouillon, _currentUserId);
            _ligue.Reglement = _reglementBrouillon;
            _editionReglement = false;
            Snackbar.Add("Règlement enregistré.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally { _sauvegardeReglement = false; }
    }

    async Task ExporterReglementPdf()
    {
        if (_ligue is null) return;
        _exportReglement = true;
        try
        {
            var bytes = PdfService.GenererReglement(_ligue);
            var nom = $"reglement-{_ligue.Nom.ToLower().Replace(" ", "-")}.pdf";
            await JS.InvokeVoidAsync("blazorDownloadBase64File", nom, "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur PDF : {ex.Message}", Severity.Error);
        }
        finally { _exportReglement = false; }
    }

    /// <summary>Active/désactive le mode brouillard sur une ligue existante (#2).</summary>
    async Task BasculerBrouillard(bool actif)
    {
        // Droit réel : voir EnregistrerReglement.
        if (_ligue is null || !_peutGererLigue) return;
        try
        {
            await LeagueService.DefinirModeBrouillardAsync(_ligue.Id, actif, _currentUserId);
            _ligue.ModeBrouillard = actif;
            Snackbar.Add(actif
                ? "Mode brouillard activé : les coaches ne voient que leur prochain match."
                : "Mode brouillard désactivé : tout le calendrier est visible.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Matchs de la division visibles par l'utilisateur courant (#2 mode brouillard).
    /// Hors brouillard — ou pour un commissaire — la liste complète est renvoyée.
    /// </summary>
    IEnumerable<Match> MatchsVisibles(Division division)
    {
        if (_ligue is null) return division.Matchs;

        var mesEquipes = _ligue.Equipes
            .Where(e => e.CoachId == _currentUserId)
            .Select(e => e.Id)
            .ToHashSet();

        return BrouillardHelpers.FiltrerVisibles(
            division.Matchs, mesEquipes, _ligue.ModeBrouillard, _estCommissaire);
    }
}
