    /// <summary>
    /// Titre de la règle spéciale, seul, pour l'en-tête repliable : le texte
    /// est stocké sous la forme « Titre : contenu ».
    /// </summary>
    static string TitreRegleStar(string regle)
    {
        var i = regle.IndexOf(" : ", StringComparison.Ordinal);
        return i > 0 ? regle[..i] : regle;
    }

