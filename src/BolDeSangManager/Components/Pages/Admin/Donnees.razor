@page "/admin/donnees"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,GrandCommissaire")]
@using BolDeSangManager.Data
@using BolDeSangManager.Data.Models
@using BolDeSangManager.Data.Enums
@using BolDeSangManager.Services
@inject DataEditService DataEditService
@inject StaffService StaffService
@inject LeagueService LeagueService
@inject GameDataExportService GameDataExportService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Édition des données</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Édition des données</MudText>

    <MudStack Row="true" Spacing="2" Class="mb-4">
        <MudSelect T="int" Label="Jeu" Value="_selectedGameId" ValueChanged="@OnGameChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px">
            @foreach (var g in _games)
            {
                <MudSelectItem Value="@g.Id">@g.Nom</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int" Label="Version de règles" Value="_selectedVersionId" ValueChanged="@OnVersionChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px">
            @foreach (var v in _versions)
            {
                <MudSelectItem Value="@v.Id">@v.Nom @(v.EstActive ? "(active)" : "")</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

    <MudTabs Elevation="1" Rounded="true" Class="tabs-compact tabs-sticky" PanelClass="pa-4">
        <MudTabPanel Text="Réserve">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_reserve.Count poste(s) en réserve</b></MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton StartIcon="@Icons.Material.Filled.Download" Color="Color.Secondary" Variant="Variant.Outlined"
                               OnClick="ExporterReserve" Disabled="@(_reserve.Count == 0)">Exporter la Réserve</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Color="Color.Secondary" Variant="Variant.Outlined"
                               OnClick="@(() => JS.InvokeVoidAsync("clickElement", "importReserveInput"))">Importer une Réserve</MudButton>
                    <InputFile id="importReserveInput" OnChange="ImporterReserve" accept=".json" style="display:none" />
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                               OnClick="AjouterReservePoste">Ajouter un poste de réserve</MudButton>
                </MudStack>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mb-2" Style="color:#9e9e9e">
                Postes réutilisables de cette version de règles. Importez-les dans une équipe depuis l'édition de l'équipe (bouton « Importer depuis la Réserve »). L'import crée une copie indépendante.
            </MudText>
            <MudTable Items="@_reserve" Dense="true" Hover="true" Style="font-size:12px">
                <HeaderContent>
                    <MudTh>Poste</MudTh>
                    <MudTh Style="text-align:center">Q.</MudTh>
                    <MudTh Style="text-align:right">Coût</MudTh>
                    <MudTh Style="text-align:center">M / F / AG / CP / AR</MudTh>
                    <MudTh>P / S</MudTh>
                    <MudTh>Skills départ</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Poste">
                        <div style="font-weight:600">@context.Nom</div>
                        @if (!string.IsNullOrEmpty(context.MotsCles))
                        {
                            <div style="font-size:10px; color:#9e9e9e; font-style:italic">@context.MotsCles.Replace(",", ", ")</div>
                        }
                    </MudTd>
                    <MudTd DataLabel="Quantité max" Style="text-align:center">@context.QuantiteMax</MudTd>
                    <MudTd DataLabel="Coût" Style="text-align:right">@context.Cout.ToString("N0")</MudTd>
                    <MudTd DataLabel="M / F / AG / CP / AR" Style="text-align:center; font-family:monospace; font-size:11px">
                        @context.Mouvement / @context.Force / @context.Agilite / @context.CapacitePasse / @context.Armure
                    </MudTd>
                    <MudTd DataLabel="P / S">
                        <div style="font-size:11px"><span style="color:#90caf9">P:</span> @CategoryAccessHelpers.FormatAcces(context.AccesCategories.Where(a => a.EstPrincipale).Select(a => a.SkillCategoryDef))</div>
                        <div style="font-size:11px"><span style="color:#ce93d8">S:</span> @CategoryAccessHelpers.FormatAcces(context.AccesCategories.Where(a => !a.EstPrincipale).Select(a => a.SkillCategoryDef))</div>
                    </MudTd>
                    <MudTd DataLabel="Skills départ">
                        @if (context.CompetencesDepart?.Any() == true)
                        {
                            <div style="display:flex; flex-wrap:wrap; gap:2px">
                                @foreach (var c in context.CompetencesDepart)
                                {
                                    <span style="font-size:10px; padding:1px 4px; background:rgba(229,57,53,0.15); border-radius:3px; white-space:nowrap">@c.Skill?.Nom</span>
                                }
                            </div>
                        }
                        else { <span style="font-size:10px; color:#666">—</span> }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditerReservePoste(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => SupprimerReservePoste(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Staff">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_staff.Count élément(s) de staff</b></MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="AjouterStaff">Ajouter un staff</MudButton>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mb-2" Style="color:#9e9e9e">
                Éléments achetables par les équipes : fans dévoués, relances, apothicaire…
                Ces valeurs sont celles des <b>règles</b> : chaque ligue en prend une copie
                à sa création, que le commissaire peut ensuite ajuster pour son format.
                Modifier ici n'affecte donc pas les ligues déjà créées.
            </MudText>
            <MudTable Items="@_staff" Dense="true" Hover="true" Style="font-size:12px">
                <HeaderContent>
                    <MudTh>Nom</MudTh>
                    <MudTh Style="text-align:right">Coût</MudTh>
                    <MudTh Style="text-align:center">Création (min–max)</MudTh>
                    <MudTh Style="text-align:center">Plafond ligue</MudTh>
                    <MudTh Style="text-align:center">Actif</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">
                        <div style="font-weight:600">@context.Nom</div>
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            <div style="font-size:10px; color:#9e9e9e; font-style:italic">@context.Description</div>
                        }
                    </MudTd>
                    <MudTd DataLabel="Coût" Style="text-align:right">
                        @if (context.CoutDepuisTypeEquipe)
                        {
                            <span style="font-size:11px; color:#90caf9" title="Le prix vient de la fiche de la race (Coût relance)">
                                selon la race
                            </span>
                        }
                        else
                        {
                            @context.Cout.ToString("N0")
                        }
                    </MudTd>
                    <MudTd DataLabel="Création" Style="text-align:center">
                        @context.MinCreation – @context.MaxCreation
                    </MudTd>
                    <MudTd DataLabel="Plafond ligue" Style="text-align:center">
                        @(context.MaxLigue?.ToString() ?? "—")
                    </MudTd>
                    <MudTd DataLabel="Actif" Style="text-align:center">
                        @if (context.EstActif)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.DoNotDisturbOn" Size="Size.Small" Color="Color.Default" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditerStaff(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerStaff(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Équipes">
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_teamTypes.Count équipe(s)</b></MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="AjouterTeamType">Ajouter une équipe</MudButton>
            </MudStack>
            <MudTable Items="@_teamTypes" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<TeamType,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TeamType,object>(x => x.Categorie)">Catégorie</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TeamType,object>(x => x.CoutRelance)">Coût relance</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TeamType,object>(x => (object)(x.Postes?.Count ?? 0))">Nb postes</MudTableSortLabel></MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">@context.Nom</MudTd>
                    <MudTd DataLabel="Catégorie">
                        @* 0 = non renseignée. Affiché en « à renseigner » plutôt qu'un
                           « 0 » brut : la saisie est faite à la main par les commissaires,
                           l'écran doit donc se lire comme une liste de travail. *@
                        @if (context.Categorie == 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">à renseigner</MudChip>
                        }
                        else
                        {
                            @context.Categorie
                        }
                    </MudTd>
                    <MudTd DataLabel="Coût relance">@context.CoutRelance.ToString("N0") po</MudTd>
                    <MudTd DataLabel="Nb postes">@(context.Postes?.Count ?? 0)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditerTeamType(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerTeamType(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Règles spéciales">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                    Capacités propres à certaines équipes (Capitaine, Bagarreurs Brutaux…).
                    Elles s'affichent sur la feuille d'équipe. Rattachez-les depuis la fiche
                    de chaque équipe.
                </MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @* Transport du catalogue vers une autre instance (le VPS) :
                       l'import FUSIONNE dans la version choisie sans en créer
                       une nouvelle, contrairement à l'export global. *@
                    <MudButton StartIcon="@Icons.Material.Filled.Download" Color="Color.Secondary"
                               Variant="Variant.Outlined" Size="Size.Small"
                               OnClick="ExporterReglesSpeciales"
                               Disabled="@(_reglesSpeciales.Count == 0)">Exporter</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Color="Color.Secondary"
                               Variant="Variant.Outlined" Size="Size.Small"
                               OnClick="@(() => JS.InvokeVoidAsync("clickElement", "importReglesInput"))">Importer</MudButton>
                    <InputFile id="importReglesInput" OnChange="ImporterReglesSpeciales" accept=".json" style="display:none" />
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                               Size="Size.Small" OnClick="AjouterRegleSpeciale">Ajouter une règle</MudButton>
                </MudStack>
            </MudStack>

            <MudTable Items="@_reglesSpeciales" Dense="true" Hover="true">
                <HeaderContent>
                    @* Les trois colonnes de droite ne contiennent qu'un badge, un
                       nombre et deux icônes : on les serre au strict nécessaire
                       pour laisser toute la largeur restante à la description,
                       qui est le contenu réellement long de ce tableau.
                       « Effet » plutôt que « Comportement automatique » : c'est
                       le TITRE qui fixait la largeur minimale de la colonne. *@
                    <MudTh>Règle</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Effet</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Équipes</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @* Nom et effet dans la MÊME cellule : en colonne séparée, la
                       description écrasait son libellé sur mobile. *@
                    <MudTd DataLabel="Règle" Class="cellule-texte-long">
                        <MudText Typo="Typo.body2"><b>@context.Nom</b></MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                            @context.Description
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Effet" Style="white-space:nowrap">
                        @if (string.IsNullOrEmpty(context.Code))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">aucun</MudChip>
                        }
                        else
                        {
                            @* Libellé lisible plutôt que le code technique :
                               « RecrutementGratuitParMotCle » élargissait la
                               colonne au détriment de la description. *@
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                @LibelleEffet(context.Code)
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Équipes" Style="white-space:nowrap">
                        @{
                            var liens = context.TeamTypes ?? [];
                            // Une règle à comportement automatique dont le mot-clé
                            // n'est pas saisi ne fait RIEN : il faut le voir sans
                            // ouvrir chaque fiche d'équipe.
                            var sansParametre = !string.IsNullOrEmpty(context.Code)
                                ? liens.Count(l => string.IsNullOrWhiteSpace(l.OptionsChoix))
                                : 0;
                        }
                        @liens.Count
                        @if (sansParametre > 0)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning"
                                     Size="Size.Small" Class="ml-1"
                                     title="@($"{sansParametre} équipe(s) sans paramètre : la règle y est sans effet.")" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="white-space:nowrap">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditerRegleSpeciale(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerRegleSpeciale(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Ligues">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_ligues.Count ligue(s)</b></MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="AjouterLigue">Ajouter une ligue</MudButton>
            </MudStack>
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)" Class="mb-3 d-block">
                Rattachez-les aux équipes depuis leur fiche, et aux star players :
                c'est le recoupement des deux qui détermine qui peut engager qui.
            </MudText>

            <MudTable Items="@_ligues" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<ThemedLeague,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Équipes</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Stars</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">@context.Nom</MudTd>
                    <MudTd DataLabel="Équipes" Style="white-space:nowrap">@context.Equipes.Count</MudTd>
                    <MudTd DataLabel="Stars" Style="white-space:nowrap">@context.StarPlayers.Count</MudTd>
                    <MudTd DataLabel="Actions" Style="white-space:nowrap">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => ModifierLigue(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerLigue(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (_ligues.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mt-2" Color="Color.Secondary">
                    Aucune ligue. Sans ligue, tous les star players sont accessibles à toutes les équipes.
                </MudText>
            }
        </MudTabPanel>

        <MudTabPanel Text="Coups de pouce">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_coupsDePouce.Count coup(s) de pouce</b></MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="AjouterCoupDePouce">Ajouter un coup de pouce</MudButton>
            </MudStack>
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)" Class="mb-3 d-block">
                Options achetées avant un match pour compenser un écart de valeur.
                L'application les imprime sur la feuille ; les coaches s'arrangent à la table.
            </MudText>

            <MudTable Items="@_coupsDePouce" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<Inducement,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Max</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<Inducement,object>(x => x.Cout)">Coût</MudTableSortLabel></MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">
                        <MudText Typo="Typo.body2"><b>@context.Nom</b></MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.Description</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(context.Restriction))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">@context.Restriction</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Max" Style="white-space:nowrap">
                        @(context.QuantiteMax > 0 ? $"0-{context.QuantiteMax}" : "—")
                    </MudTd>
                    <MudTd DataLabel="Coût" Style="white-space:nowrap">
                        @(context.Cout > 0 ? context.Cout.ToString("N0") + " po" : "variable")
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="white-space:nowrap">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => ModifierCoupDePouce(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerCoupDePouce(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Star players">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_starPlayers.Count star player(s)</b></MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @* Transport vers une autre instance (le VPS) : l'import
                       FUSIONNE dans la version choisie sans en creer une
                       nouvelle. C'est aussi ce qui porte les textes complets,
                       qui vivent en base et non dans le depot. *@
                    <MudButton StartIcon="@Icons.Material.Filled.Download" Color="Color.Secondary"
                               Variant="Variant.Outlined" Size="Size.Small"
                               OnClick="ExporterCatalogue"
                               Disabled="@(_starPlayers.Count == 0 && _coupsDePouce.Count == 0)">Exporter</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Color="Color.Secondary"
                               Variant="Variant.Outlined" Size="Size.Small"
                               OnClick="@(() => JS.InvokeVoidAsync("clickElement", "importCatalogueInput"))">Importer</MudButton>
                    <InputFile id="importCatalogueInput" OnChange="ImporterCatalogue" accept=".json" style="display:none" />
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                               OnClick="AjouterStarPlayer">Ajouter un star player</MudButton>
                </MudStack>
            </MudStack>
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)" Class="mb-3 d-block">
                Mercenaires loués pour un match : ils ne rejoignent jamais un effectif.
                Sans ligue, un star player est proposé à toutes les équipes.
            </MudText>

            <MudTable Items="@_starPlayers" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="table-lignes-separees">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<StarPlayer,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">M</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">F</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">AG</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">CP</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">AR</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<StarPlayer,object>(x => x.Cout)">Coût</MudTableSortLabel></MudTh>
                    <MudTh>Ligues</MudTh>
                    <MudTh Style="width:1%; white-space:nowrap">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">
                        <MudText Typo="Typo.body2"><b>@context.Nom</b></MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Competences))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.Competences</MudText>
                        }
                        @* Repliable et rattachee au NOM : le texte fait jusqu'a
                           450 caracteres, l'afficher en entier noyait la ligne et
                           on ne voyait plus a quel joueur il appartenait. *@
                        @if (!string.IsNullOrWhiteSpace(context.ReglesSpeciales))
                        {
                            <div class="regle-star">
                                <details>
                                    <summary>@TitreRegleStar(context.ReglesSpeciales)</summary>
                                    <MudText Typo="Typo.caption" Class="regle-star-texte">
                                        @context.ReglesSpeciales
                                    </MudText>
                                </details>
                            </div>
                        }
                    </MudTd>
                    <MudTd DataLabel="M" Style="white-space:nowrap">@context.Mouvement</MudTd>
                    <MudTd DataLabel="F" Style="white-space:nowrap">@context.Force</MudTd>
                    <MudTd DataLabel="AG" Style="white-space:nowrap">@context.Agilite</MudTd>
                    <MudTd DataLabel="CP" Style="white-space:nowrap">@context.CapacitePasse</MudTd>
                    <MudTd DataLabel="AR" Style="white-space:nowrap">@context.Armure</MudTd>
                    <MudTd DataLabel="Coût" Style="white-space:nowrap">
                        @(context.Cout > 0 ? context.Cout.ToString("N0") + " po" : "—")
                    </MudTd>
                    <MudTd DataLabel="Ligues">
                        @* Pastilles plutot qu'une ligne de texte : c'est le critere
                           qui decide de la disponibilite, il doit se reperer vite. *@
                        @if (context.Ligues.Count == 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Toutes</MudChip>
                        }
                        else
                        {
                            @foreach (var l in context.Ligues)
                            {
                                var nom = _ligues.FirstOrDefault(x => x.Id == l.ThemedLeagueId)?.Nom;
                                if (nom is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@nom</MudChip>
                                }
                            }
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="white-space:nowrap">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => ModifierStarPlayer(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerStarPlayer(context))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Compétences">
            <MudExpansionPanels Elevation="0" Class="mb-3">
                <MudExpansionPanel Dense="true">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle2">
                                <b>Catégories</b>
                                <span style="color:var(--mud-palette-text-secondary)"> — @_categories.Count définie(s) pour cette version</span>
                            </MudText>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                                Les catégories appartiennent à la version de règles sélectionnée et sont clonées avec elle.
                                Une catégorie utilisée ne peut pas être supprimée, mais peut être renommée.
                            </MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                                       Size="Size.Small" OnClick="AjouterCategorie">Ajouter une catégorie</MudButton>
                        </MudStack>
                        <MudTable Items="@_categories" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Nom</MudTh>
                                <MudTh Style="width:10%">Code</MudTh>
                                <MudTh Style="width:20%">Compétences</MudTh>
                                <MudTh Style="width:12%">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Nom"><b>@context.Nom</b></MudTd>
                                <MudTd DataLabel="Code"><MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Code</MudChip></MudTd>
                                <MudTd DataLabel="Compétences">@NbSkills(context.Id)</MudTd>
                                <MudTd DataLabel="Actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   title="Renommer / changer le code"
                                                   OnClick="@(() => EditerCategorie(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   title="Supprimer cette catégorie"
                                                   OnClick="@(() => SupprimerCategorie(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.subtitle1"><b>@_skillsFiltres.Count compétence(s)</b></MudText>
                    <MudSelect T="int?" Label="Catégorie" Value="_categorieFiltre" ValueChanged="@OnCategorieChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:150px" Clearable="true">
                        @foreach (var c in _categories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Nom</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="AjouterSkill">Ajouter une compétence</MudButton>
            </MudStack>
            <MudTable Items="@_skillsFiltres" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<Skill,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<Skill,object>(x => x.SkillCategoryDef.Nom)">Catégorie</MudTableSortLabel></MudTh>
                    <MudTh>Trait/Élite</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">@context.Nom</MudTd>
                    <MudTd DataLabel="Catégorie">@(context.SkillCategoryDef?.Nom ?? "—")</MudTd>
                    <MudTd DataLabel="Trait/Élite">
                        @if (context.EstElite) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">Élite</MudChip> }
                        @if (context.EstTrait) { <MudChip T="string" Size="Size.Small" Color="Color.Info">Trait</MudChip> }
                    </MudTd>
                    <MudTd DataLabel="Description" Style="max-width:400px; white-space:normal">@context.Description</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditerSkill(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerSkill(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Versions">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_versions.Count version(s)</b></MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Color="Color.Secondary" Variant="Variant.Outlined"
                               OnClick="@(() => JS.InvokeVoidAsync("clickElement", "importGameDataInput"))"
                               Disabled="@_importEnCours">
                        @(_importEnCours ? "Import en cours…" : "Importer une version")
                    </MudButton>
                    <InputFile id="importGameDataInput" OnChange="ImporterVersion"
                               accept=".json" style="display:none" />
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                               OnClick="CreerVersion">Créer une nouvelle version</MudButton>
                </MudStack>
            </MudStack>
            <MudTable Items="@_versions" Dense="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<RulesVersion,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh>Active</MudTh>
                    <MudTh>Barèmes</MudTh>
                    <MudTh>Révision</MudTh>
                    <MudTh Style="width:16%; white-space:nowrap">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">@context.Nom</MudTd>
                    <MudTd DataLabel="Active">
                        @if (context.EstActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Oui</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Non</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Barèmes">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            PSP : TD @context.PspParTouchdown · Passe @context.PspParPasse ·
                            Int @context.PspParInterception · Élim @context.PspParElimination ·
                            MVP @context.PspBonusMvp
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Pts : V @context.PointsVictoire · N @context.PointsNul · D @context.PointsDefaite
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Révision">
                        @if (context.Revision > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     title="@($"Dernier export : {context.DernierExportLe?.ToLocalTime():dd/MM/yyyy à HH'h'mm}")">
                                rév. @context.Revision
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">jamais exportée</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                       Color="@(context.EstActive ? Color.Success : Color.Default)"
                                       Disabled="@context.EstActive"
                                       title="@(context.EstActive
                                           ? "Version déjà active — utilisée par défaut pour les nouvelles ligues"
                                           : "Définir comme version active (utilisée par défaut pour les nouvelles ligues)")"
                                       OnClick="@(() => ActiverVersion(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       title="Renommer cette version"
                                       OnClick="@(() => RenommerVersion(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.MilitaryTech" Size="Size.Small"
                                       title="Modifier le barème de PSP de cette version"
                                       OnClick="@(() => EditerBareme(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                       title="Exporter cette version"
                                       OnClick="@(() => ExporterVersion(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       title="Supprimer cette version"
                                       OnClick="@(() => SupprimerVersion(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    List<Game> _games = [];
    List<RulesVersion> _versions = [];
    List<StaffDefinition> _staff = [];
    List<TeamType> _teamTypes = [];
    List<PoolPosition> _reserve = [];
    List<Skill> _skills = [];
    List<SkillCategoryDef> _categories = [];
    List<SpecialRule> _reglesSpeciales = [];
    List<ThemedLeague> _ligues = [];
    List<Inducement> _coupsDePouce = [];
    List<StarPlayer> _starPlayers = [];
    int _selectedGameId;
    int _selectedVersionId;
    int? _categorieFiltre;
    bool _importEnCours;

    List<Skill> _skillsFiltres =>
        _categorieFiltre is null ? _skills : _skills.Where(s => s.SkillCategoryDefId == _categorieFiltre).ToList();

    int NbSkills(int categorieId) => _skills.Count(s => s.SkillCategoryDefId == categorieId);

    protected override async Task OnInitializedAsync()
    {
        _games = await LeagueService.GetGamesAsync();
        if (_games.Any())
        {
            _selectedGameId = _games[0].Id;
            await ChargerVersionsAsync();
        }
    }

    async Task ChargerVersionsAsync()
    {
        _versions = await DataEditService.GetVersionsAsync(_selectedGameId);
        _selectedVersionId = _versions.FirstOrDefault(v => v.EstActive)?.Id ?? _versions.FirstOrDefault()?.Id ?? 0;
        await ChargerDonneesAsync();
    }

    async Task ChargerDonneesAsync()
    {
        if (_selectedVersionId == 0)
        {
            _teamTypes = []; _skills = []; _reserve = []; _categories = [];
            _staff = []; _reglesSpeciales = []; _ligues = []; _coupsDePouce = []; _starPlayers = [];
            return;
        }
        _teamTypes = await DataEditService.GetTeamTypesAsync(_selectedVersionId);
        _categories = await DataEditService.GetCategoriesAsync(_selectedVersionId);
        _reglesSpeciales = await DataEditService.GetReglesSpecialesAsync(_selectedVersionId);
        _skills = await DataEditService.GetSkillsAsync(_selectedVersionId);
        _reserve = await DataEditService.GetReserveAsync(_selectedVersionId);
        _staff = await StaffService.GetStaffTypesAsync(_selectedVersionId);
        _ligues = await DataEditService.GetLiguesAsync(_selectedVersionId);
        _coupsDePouce = await DataEditService.GetCoupsDePouceAsync(_selectedVersionId);
        _starPlayers = await DataEditService.GetStarPlayersAsync(_selectedVersionId);
        // Le filtre pointe sur une catégorie d'une autre version : le réinitialiser
        if (_categorieFiltre is int f && !_categories.Any(c => c.Id == f)) _categorieFiltre = null;
    }

    // ─── Staff ────────────────────────────────────────────────────────────────

    async Task AjouterStaff()
    {
        if (_selectedVersionId == 0) return;

        var modele = new StaffDefinition
        {
            RulesVersionId = _selectedVersionId,
            Ordre = (_staff.LastOrDefault()?.Ordre ?? 0) + 1,
            MaxCreation = 1
        };
        await OuvrirDialogueStaffAsync("Ajouter un staff", modele, async m =>
        {
            await StaffService.AjouterStaffTypeAsync(m);
            Snackbar.Add($"« {m.Nom} » ajouté.", Severity.Success);
        });
    }

    async Task EditerStaff(StaffDefinition staff)
    {
        // Copie de travail : le dialogue ne doit pas modifier l'entité suivie
        // tant que l'utilisateur n'a pas validé.
        var copie = new StaffDefinition
        {
            Id = staff.Id, RulesVersionId = staff.RulesVersionId,
            Nom = staff.Nom, Description = staff.Description, Ordre = staff.Ordre,
            EstActif = staff.EstActif, Cout = staff.Cout,
            CoutDepuisTypeEquipe = staff.CoutDepuisTypeEquipe,
            MinCreation = staff.MinCreation, MaxCreation = staff.MaxCreation,
            MaxLigue = staff.MaxLigue,
            // À ne pas oublier : sans cette ligne, le défaut C# (true) se
            // substitue à la valeur réelle et la simple ouverture de la modale
            // suffit à remettre les fans dans la VEA.
            CompteDansVea = staff.CompteDansVea
        };

        await OuvrirDialogueStaffAsync($"Modifier « {staff.Nom} »", copie, async m =>
        {
            await StaffService.ModifierStaffTypeAsync(m);
            Snackbar.Add($"« {m.Nom} » modifié.", Severity.Success);
        });
    }

    async Task OuvrirDialogueStaffAsync(string titre, StaffDefinition modele, Func<StaffDefinition, Task> action)
    {
        var parametres = new DialogParameters<EditionStaffDialog> { { x => x.Modele, modele } };
        var dialog = await DialogService.ShowAsync<EditionStaffDialog>(titre, parametres);
        var res = await dialog.Result;
        if (res is null || res.Canceled || res.Data is not StaffDefinition valide) return;

        try
        {
            await action(valide);
            await ChargerDonneesAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Impossible d'enregistrer ce staff.", Severity.Error);
        }
    }

    async Task SupprimerStaff(StaffDefinition staff)
    {
        var ok = await DialogService.ShowMessageBox(
            "Supprimer ce staff",
            $"Supprimer « {staff.Nom} » de cette version de règles ? "
            + "Les ligues déjà créées conservent leur copie : elles ne sont pas affectées.",
            "Supprimer", "Annuler");
        if (ok != true) return;

        try
        {
            await StaffService.SupprimerStaffTypeAsync(staff.Id);
            await ChargerDonneesAsync();
            Snackbar.Add($"« {staff.Nom} » supprimé.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Impossible de supprimer ce staff.", Severity.Error);
        }
    }

    async Task OnGameChanged(int id)
    {
        _selectedGameId = id;
        await ChargerVersionsAsync();
    }

    async Task OnVersionChanged(int id)
    {
        _selectedVersionId = id;
        await ChargerDonneesAsync();
    }

    void OnCategorieChanged(int? c) => _categorieFiltre = c;

    async Task EditerBareme(RulesVersion version)
    {
        var parameters = new DialogParameters<EditionBaremeDialog> { { x => x.Version, version } };
        var dialog = await DialogService.ShowAsync<EditionBaremeDialog>(
            "Barèmes de la version", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ChargerVersionsAsync();
    }

    // ── Règles spéciales ────────────────────────────────────────────────────

    async Task AjouterRegleSpeciale()
    {
        if (_selectedVersionId == 0) return;
        var parameters = new DialogParameters<EditionRegleSpecialeDialog>
        {
            { x => x.VersionId, _selectedVersionId },
            { x => x.Existant, null }
        };
        var dialog = await DialogService.ShowAsync<EditionRegleSpecialeDialog>("Nouvelle règle spéciale", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerDonneesAsync();
    }

    async Task EditerRegleSpeciale(SpecialRule r)
    {
        var parameters = new DialogParameters<EditionRegleSpecialeDialog>
        {
            { x => x.VersionId, _selectedVersionId },
            { x => x.Existant, r }
        };
        var dialog = await DialogService.ShowAsync<EditionRegleSpecialeDialog>("Éditer la règle spéciale", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerDonneesAsync();
    }

    async Task SupprimerRegleSpeciale(SpecialRule r)
    {
        var ok = await DialogService.ShowMessageBox(
            "Confirmer", $"Supprimer la règle spéciale « {r.Nom} » ?", "Supprimer", "Annuler");
        if (ok != true) return;
        try
        {
            await DataEditService.SupprimerRegleSpecialeAsync(r.Id);
            Snackbar.Add("Règle spéciale supprimée", Severity.Success);
            await ChargerDonneesAsync();
        }
        catch (InvalidOperationException ex)
        {
            // Cas normal : la règle est encore rattachée à des équipes.
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    async Task AjouterCategorie()
    {
        if (_selectedVersionId == 0) return;
        var parameters = new DialogParameters<EditionCategorieDialog>
        {
            { x => x.VersionId, _selectedVersionId },
            { x => x.Existant, null }
        };
        var dialog = await DialogService.ShowAsync<EditionCategorieDialog>("Nouvelle catégorie", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerDonneesAsync();
    }

    async Task EditerCategorie(SkillCategoryDef c)
    {
        var parameters = new DialogParameters<EditionCategorieDialog>
        {
            { x => x.VersionId, _selectedVersionId },
            { x => x.Existant, c }
        };
        var dialog = await DialogService.ShowAsync<EditionCategorieDialog>("Éditer la catégorie", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerDonneesAsync();
    }

    async Task SupprimerCategorie(SkillCategoryDef c)
    {
        var ok = await DialogService.ShowMessageBox("Confirmer", $"Supprimer la catégorie « {c.Nom} » ?", "Supprimer", "Annuler");
        if (ok != true) return;
        try
        {
            await DataEditService.SupprimerCategorieAsync(c.Id);
            Snackbar.Add("Catégorie supprimée", Severity.Success);
            await ChargerDonneesAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    void AjouterTeamType()
    {
        Nav.NavigateTo($"/admin/donnees/equipes/new?versionId={_selectedVersionId}");
    }

    void EditerTeamType(int id)
    {
        Nav.NavigateTo($"/admin/donnees/equipes/{id}");
    }

    async Task SupprimerTeamType(TeamType t)
    {
        var ok = await DialogService.ShowMessageBox("Confirmer", $"Supprimer définitivement « {t.Nom} » ?", "Supprimer", "Annuler");
        if (ok != true) return;
        try
        {
            await DataEditService.SupprimerTeamTypeAsync(t.Id);
            Snackbar.Add("Équipe supprimée", Severity.Success);
            await ChargerDonneesAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task AjouterSkill()
    {
        var parameters = new DialogParameters<EditionSkillDialog> { { x => x.VersionId, _selectedVersionId } };
        var dialog = await DialogService.ShowAsync<EditionSkillDialog>("Nouvelle compétence", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerDonneesAsync();
    }

    async Task EditerSkill(Skill s)
    {
        var parameters = new DialogParameters<EditionSkillDialog>
        {
            { x => x.VersionId, _selectedVersionId },
            { x => x.Existant, s }
        };
        var dialog = await DialogService.ShowAsync<EditionSkillDialog>("Éditer compétence", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerDonneesAsync();
    }

    async Task SupprimerSkill(Skill s)
    {
        var ok = await DialogService.ShowMessageBox("Confirmer", $"Supprimer la compétence « {s.Nom} » ?", "Supprimer", "Annuler");
        if (ok != true) return;
        try
        {
            await DataEditService.SupprimerSkillAsync(s.Id);
            Snackbar.Add("Compétence supprimée", Severity.Success);
            await ChargerDonneesAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task AjouterReservePoste()
    {
        var parameters = new DialogParameters<EditionPosteDialog>
        {
            { x => x.ModeReserve, true },
            { x => x.VersionId, _selectedVersionId },
            { x => x.TeamTypeId, 0 },
            { x => x.ExistantReserve, null }
        };
        var dialog = await DialogService.ShowAsync<EditionPosteDialog>("Nouveau poste de réserve", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerDonneesAsync();
    }

    async Task EditerReservePoste(PoolPosition p)
    {
        var parameters = new DialogParameters<EditionPosteDialog>
        {
            { x => x.ModeReserve, true },
            { x => x.VersionId, _selectedVersionId },
            { x => x.TeamTypeId, 0 },
            { x => x.ExistantReserve, p }
        };
        var dialog = await DialogService.ShowAsync<EditionPosteDialog>("Éditer poste de réserve", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerDonneesAsync();
    }

    async Task SupprimerReservePoste(PoolPosition p)
    {
        var ok = await DialogService.ShowMessageBox("Confirmer", $"Supprimer le poste de réserve « {p.Nom} » ?", "Supprimer", "Annuler");
        if (ok != true) return;
        try
        {
