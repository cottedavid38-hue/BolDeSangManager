@page "/equipes/ma-feuille"
@rendermode InteractiveServer
@attribute [Authorize]
@inject TeamService TeamService
@inject BolDeSangManager.Services.IAuthorizationService Auth
@inject MatchService MatchService
@inject PdfService PdfService
@inject SettingsService SettingsService
@inject DataEditService DataEditService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Feuille d'équipe — BolDeSang Manager</PageTitle>

<MudText Typo="Typo.h5" Color="Color.Error" Class="mb-4"><b>Feuille d'équipe</b></MudText>

@if (_equipesSelect is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else if (!_equipesSelect.Any())
{
    <MudAlert Severity="Severity.Info">
        Aucune équipe disponible.
        <MudLink Href="/ligues">Rejoignez une ligue</MudLink> pour créer votre équipe.
    </MudAlert>
}
else
{
    <MudSelect T="string" Value="@_selectedTeamNom" Label="Équipe"
               Variant="Variant.Outlined" Class="mb-4" Style="max-width:480px"
               ValueChanged="OnTeamNameChanged">
        @foreach (var eq in _equipesSelect)
        {
            <MudSelectItem T="string" Value="@NomSelect(eq)">@NomSelect(eq)</MudSelectItem>
        }
    </MudSelect>

    @if (_equipeDetail is not null)
    {
        <!-- Barre sticky trésorerie / VEA -->
        <MudPaper Elevation="2" Class="pa-2 mb-3 d-flex align-center gap-3" Outlined="false"
                  Style="position:sticky; top:0; z-index:100; background:var(--mud-palette-background-grey)">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Success" />
            <MudText Typo="Typo.body2">
                Trésorerie : <b style="color:var(--mud-palette-success)">@_equipeDetail.Tresorerie.ToString("N0") po</b>
            </MudText>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudText Typo="Typo.body2">
                VEA : <b>@TeamService.CalculerVEA(_equipeDetail).ToString("N0") po</b>
            </MudText>
            @* Catégorie LRB (informative), masquée tant qu'elle n'est pas saisie. *@
            @if (!string.IsNullOrEmpty(DisplayHelpers.CategorieLabel(_equipeDetail.TeamType?.Categorie ?? 0)))
            {
                <MudDivider Vertical="true" FlexItem="true" />
                <span title="@DisplayHelpers.CategorieDescription(_equipeDetail.TeamType!.Categorie)">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@DisplayHelpers.CategorieColor(_equipeDetail.TeamType!.Categorie)">
                        @DisplayHelpers.CategorieLabel(_equipeDetail.TeamType!.Categorie)
                    </MudChip>
                </span>
            }
        </MudPaper>

        @* Règles spéciales : repliées, on touche une règle pour lire son effet. *@
        @if (_equipeDetail.TeamType?.ReglesSpecialesListe.Any() == true)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">Règles spéciales</MudText>
            <MudExpansionPanels Class="mb-4" Elevation="0" Dense="true"
                                Style="border:1px solid var(--mud-palette-lines-default); border-radius:4px">
                @foreach (var l in _equipeDetail.TeamType.ReglesSpecialesListe.OrderBy(x => x.SpecialRule.Ordre))
                {
                    <MudExpansionPanel Dense="true">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.body2"><b>@l.SpecialRule.Nom</b></MudText>
                                @if (l.SpecialRule.Code == SpecialRuleCodes.FavoriDe
                                     && !string.IsNullOrEmpty(_equipeDetail.DiviniteChoisie))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                        @_equipeDetail.DiviniteChoisie
                                    </MudChip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                                @l.SpecialRule.Description
                            </MudText>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    }

    @if (_equipeDetail is null)
    {
        <MudProgressLinear Color="Color.Error" Indeterminate="true" />
    }
    else
    {
        <!-- Export PDF : un seul bouton + des options a cocher. Avant, chaque
             nouvelle option doublait le nombre de boutons (« Exporter » /
             « avec descriptions ») et le format vivait a part dans un
             selecteur. -->
        <MudPaper Outlined="true" Class="pa-3 mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Export PDF</MudText>

            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4" Class="mb-2">
                <MudCheckBox @bind-Value="_pdfDescriptions" Color="Color.Error" Dense="true"
                             Label="Descriptions des compétences" />
                <MudCheckBox @bind-Value="_pdfCoupsDePouce" Color="Color.Error" Dense="true"
                             Label="Coups de pouce" />
                <MudCheckBox @bind-Value="_pdfStarPlayers" Color="Color.Error" Dense="true"
                             Label="Star players disponibles" />
                <MudCheckBox @bind-Value="_pdfPaysage" Color="Color.Error" Dense="true"
                             Label="Format paysage" />
            </MudStack>

            <MudButton Variant="Variant.Filled" Color="Color.Error"
                      StartIcon="@Icons.Material.Filled.PictureAsPdf"
                      OnClick="ExporterPdf"
                      Disabled="@_exporting">
                @(_exporting ? "Génération..." : "Exporter la feuille")
            </MudButton>
        </MudPaper>

        @if (_matchProchain is not null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.QrCode">
                Le PDF inclura un QR code pour saisir la feuille du prochain match
                (@DisplayHelpers.RondeLabelCourt(_matchProchain.Ronde)).
                @if (string.IsNullOrWhiteSpace(_urlExterne))
                {
                    <MudLink Href="/admin" Class="ml-1">Configurez l'URL externe dans l'admin.</MudLink>
                }
            </MudAlert>
        }

        <!-- En-tête équipe -->
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <div>
                    <MudText Typo="Typo.h5"><b>@_equipeDetail.Nom</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @_equipeDetail.TeamType?.Nom — @_equipeDetail.TeamType?.Game?.Nom
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Coach : <b>@DisplayHelpers.NomCoach(_equipeDetail.Coach)</b>
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Ligue : <b>@_equipeDetail.League?.Nom</b>
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.body2">
                        Trésorerie : <b>@_equipeDetail.Tresorerie.ToString("N0") po</b>
                    </MudText>
                    <MudText Typo="Typo.body2">
                        VEA : <b>@TeamService.CalculerVEA(_equipeDetail).ToString("N0") po</b>
                    </MudText>
                    <MudText Typo="Typo.body2">Relances : <b>@_equipeDetail.NombreRelances</b></MudText>
                    <MudText Typo="Typo.body2">Fans dévoués : <b>@_equipeDetail.FansDevoues</b></MudText>
                    @if (_equipeDetail.Apothicaire)
                    {
                        <MudText Typo="Typo.body2">Apothicaire : <b>Oui</b></MudText>
                    }
                    @if (_equipeDetail.NombreCoachsAssistants > 0)
                    {
                        <MudText Typo="Typo.body2">Coachs assistants : <b>@_equipeDetail.NombreCoachsAssistants</b></MudText>
                    }
                    @if (_equipeDetail.NombreCheerleaders > 0)
                    {
                        <MudText Typo="Typo.body2">Cheerleaders : <b>@_equipeDetail.NombreCheerleaders</b></MudText>
                    }
                </div>
            </MudStack>
        </MudPaper>

        <!-- Tableau des joueurs -->
        <div style="overflow-x:auto">
            <MudTable Items="@_equipeDetail.Joueurs.Where(j => !j.EstMort && !j.EstRetraite).OrderBy(j => j.Numero)" Dense="true" Hover="true" Elevation="2">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Nom</MudTh>
                    <MudTh>Poste</MudTh>
                    <MudTh Style="text-align:center">M</MudTh>
                    <MudTh Style="text-align:center">F</MudTh>
                    <MudTh Style="text-align:center">AG</MudTh>
                    <MudTh Style="text-align:center">CP</MudTh>
                    <MudTh Style="text-align:center">AV</MudTh>
                    <MudTh>Compétences</MudTh>
                    <MudTh Style="text-align:center">PSP</MudTh>
                    <MudTh Style="text-align:center">Valeur</MudTh>
                </HeaderContent>
                <RowTemplate Context="j">
                    <MudTd DataLabel="N°">@j.Numero</MudTd>
                    <MudTd DataLabel="Nom">
                        <b>@j.Nom</b>
                        @if (j.ManqueSuivantMatch)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning"
                                    Size="Size.Small" title="Rate le prochain match" Class="ml-1" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Poste">
                        <div>@j.PlayerPosition?.Nom</div>
                        @if (!string.IsNullOrEmpty(j.PlayerPosition?.MotsCles))
                        {
                            <div style="font-size:10px; color:#9e9e9e; font-style:italic">
                                @j.PlayerPosition.MotsCles.Replace(",", ", ")
                            </div>
                        }
                    </MudTd>
                    <MudTd DataLabel="Mouvement" Style="text-align:center">@((j.PlayerPosition?.Mouvement ?? 0) + j.ModMouvement)</MudTd>
                    <MudTd DataLabel="Force" Style="text-align:center">@((j.PlayerPosition?.Force ?? 0) + j.ModForce)</MudTd>
                    <MudTd DataLabel="Agilité" Style="text-align:center">@j.PlayerPosition?.Agilite</MudTd>
                    <MudTd DataLabel="Passe" Style="text-align:center">@j.PlayerPosition?.CapacitePasse</MudTd>
                    <MudTd DataLabel="Armure" Style="text-align:center">@j.PlayerPosition?.Armure</MudTd>
                    <MudTd DataLabel="Compétences">
                        <MudText Typo="Typo.caption">@CompetencesJoueur(j)</MudText>
                        @if (j.PlayerPosition?.AccesCategories.Any() == true)
                        {
                            <div style="font-size:10px; margin-top:2px">
                                <span style="color:#90caf9">P:</span> @CategoryAccessHelpers.FormatAcces(j.PlayerPosition.AccesCategories.Where(a => a.EstPrincipale).Select(a => a.SkillCategoryDef))
                                @if (j.PlayerPosition.AccesCategories.Any(a => !a.EstPrincipale))
                                {
                                    <span style="color:#ce93d8; margin-left:8px">S:</span> @CategoryAccessHelpers.FormatAcces(j.PlayerPosition.AccesCategories.Where(a => !a.EstPrincipale).Select(a => a.SkillCategoryDef))
                                }
                            </div>
                        }
                    </MudTd>
                    <MudTd DataLabel="PSP" Style="text-align:center">@j.PointsStarPlayer</MudTd>
                    <MudTd DataLabel="Valeur" Style="text-align:center">@ValeurJoueurCalculator.Calculer(j, ValeurJoueurCalculator.BaremeDe(_equipeDetail)).ToString("N0")</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }

    @* Fiche d'une compétence, ouverte au clic sur son nom. *@
    @if (_competenceAffichee is { } comp)
    {
        <div class="skill-overlay-backdrop" @onclick="FermerCompetence">
            <div @onclick:stopPropagation="true">
                <MudPaper Class="skill-overlay-card" Elevation="8">
                    <div class="skill-overlay-head">
                        <MudText Typo="Typo.h6"><b>@comp.Nom</b></MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="FermerCompetence" aria-label="Fermer" />
                    </div>
                    @if (comp.EstTrait || comp.EstElite)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                            @(comp.EstTrait ? "Trait" : null)@(comp.EstTrait && comp.EstElite ? " · " : null)@(comp.EstElite ? "Élite" : null)
                        </MudText>
                    }
                    <MudText Typo="Typo.body2" Class="skill-overlay-desc">@comp.Description</MudText>
                    <MudText Typo="Typo.caption" Class="skill-overlay-hint">Touchez à côté pour fermer</MudText>
                </MudPaper>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "teamId")]
    public int? TeamId { get; set; }

    List<Team>? _equipesSelect;
    string _selectedTeamNom = "";
    Team? _equipeDetail;
    Match? _matchProchain;

    /// <summary>Coach connecté — sert au filtrage brouillard du bandeau QR code.</summary>
    string _userId = "";

    /// <summary>Un commissaire voit toujours l'intégralité du calendrier.</summary>
    bool _estCommissaire;
    string? _urlExterne;
    bool _exporting;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";
        _userId = userId;

        _urlExterne = await SettingsService.GetAsync(SettingsService.CleUrlExterne);

        Team? equipeDepart = null;
        if (TeamId.HasValue)
            equipeDepart = await TeamService.GetEquipeAsync(TeamId.Value);

        if (equipeDepart is null)
        {
            var mesEquipes = await TeamService.GetEquipesCoachAsync(userId);
            equipeDepart = mesEquipes.FirstOrDefault();
        }

        if (equipeDepart is null)
        {
            _equipesSelect = [];
            return;
        }

        if (equipeDepart.LeagueId > 0)
            _equipesSelect = await TeamService.GetEquipesLigueAsync(equipeDepart.LeagueId);
        else
        {
            var mesEquipes = await TeamService.GetEquipesCoachAsync(userId);
            _equipesSelect = mesEquipes;
        }

        _selectedTeamNom = NomSelect(equipeDepart);
        _equipeDetail = await TeamService.GetEquipeAsync(equipeDepart.Id);

        if (equipeDepart.LeagueId > 0)
            _estCommissaire = await Auth.PeutGererLigueAsync(userId, equipeDepart.LeagueId);

        await ChargerMatchProchain();
    }

    async Task OnTeamNameChanged(string nom)
    {
        _selectedTeamNom = nom;
        var eq = _equipesSelect?.FirstOrDefault(e => NomSelect(e) == nom);
        if (eq is not null)
        {
            _equipeDetail = null;
            _matchProchain = null;
            StateHasChanged();
            _equipeDetail = await TeamService.GetEquipeAsync(eq.Id);
            await ChargerMatchProchain();
        }
    }

    async Task ChargerMatchProchain()
    {
        if (_equipeDetail is null) return;
        var matchs = await MatchService.GetMatchsEquipeAsync(_equipeDetail.Id);
        var prochain = matchs
            .Where(m => m.Statut == MatchStatus.Programme || m.Statut == MatchStatus.AJouer)
            .OrderBy(m => m.Ronde)
            .FirstOrDefault();

        // Mode brouillard : cet écran affiche les fiches de TOUTES les équipes de
        // la ligue (choix produit). Annoncer « prochain match : Ronde 2 » pour une
        // équipe adverse dévoilerait le calendrier que la fiche de ligue masque.
        // Le QR code n'a de sens que pour SES propres équipes de toute façon.
        if (prochain is not null
            && _equipeDetail.League is { ModeBrouillard: true }
            && _equipeDetail.CoachId != _userId
            && !_estCommissaire)
        {
            prochain = null;
        }

        _matchProchain = prochain;
    }

    /// <summary>Orientation choisie pour l'export PDF (#4).</summary>
    // Options d'export, cochees a l'ecran plutot que multipliees en boutons.
    bool _pdfPaysage;
    bool _pdfDescriptions;
    bool _pdfCoupsDePouce;
    bool _pdfStarPlayers;

    // Catalogues charges seulement si l'option est cochee : inutile de lire
    // 66 star players pour une feuille qui n'en veut pas.
    List<Inducement> _coupsDePouce = [];
    List<StarPlayer> _starPlayers = [];

    async Task ExporterPdf()
    {
        if (_equipeDetail is null) return;
        _exporting = true;
        try
        {
            // Chargement a la demande : les catalogues ne servent que si
            // l'option correspondante est cochee.
            if (_pdfCoupsDePouce && _coupsDePouce.Count == 0)
                _coupsDePouce = await DataEditService.GetCoupsDePouceAsync(
                    _equipeDetail.TeamType!.RulesVersionId);

            if (_pdfStarPlayers && _starPlayers.Count == 0)
                _starPlayers = await DataEditService.GetStarPlayersAccessiblesAsync(
                    _equipeDetail.TeamTypeId);

            var bytes = PdfService.GenererFeuilleEquipe(
                _equipeDetail, _pdfDescriptions,
                _matchProchain, _urlExterne, _pdfPaysage,
                _pdfCoupsDePouce ? _coupsDePouce : null,
                _pdfStarPlayers ? _starPlayers : null);
            var suffixe = _pdfPaysage ? "-paysage" : "";
            var nom = $"feuille-{_equipeDetail.Nom.ToLower().Replace(" ", "-")}{suffixe}.pdf";
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("blazorDownloadBase64File", nom, "application/pdf", base64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur PDF : {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    static string NomSelect(Team eq) =>
        $"{eq.Nom} ({DisplayHelpers.NomCoach(eq.Coach)})";

    /// <summary>
    /// Noms de compétences cliquables — voir <c>Detail.razor</c> : l'attribut
    /// `title` ne répond qu'au survol souris, donc muet au doigt.
    /// </summary>
    RenderFragment CompetencesJoueur(TeamPlayer j) => builder =>
    {
        var skills = (j.PlayerPosition?.CompetencesDepart.Select(c => c.Skill) ?? [])
            .Concat(j.Competences.Where(c => !c.EstCompetenceDepart).Select(c => c.Skill))
            .Where(s => s is not null)
            .Cast<Skill>()
            .ToList();
        for (int i = 0; i < skills.Count; i++)
        {
            var sk = skills[i];
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "skill-link");
            builder.AddAttribute(2, "onclick",
                EventCallback.Factory.Create<MouseEventArgs>(this, () => OuvrirCompetence(sk)));
            builder.AddContent(3, sk.Nom);
            builder.CloseElement();
            if (i < skills.Count - 1)
                builder.AddMarkupContent(4, ", ");
        }

        // Compétence accordée par le titre de capitaine : calculée, jamais
        // stockée — elle suit donc le titre sans nettoyage.
        var offerte = CapitaineHelper.CompetenceOfferte(j, _equipeDetail?.TeamType);
        if (offerte is not null)
        {
            if (skills.Count > 0) builder.AddMarkupContent(5, ", ");
            builder.OpenElement(6, "span");
            builder.AddAttribute(7, "style", "color:var(--mud-palette-warning)");
            builder.AddAttribute(8, "title", "Accordée par le titre de capitaine");
            builder.AddContent(9, offerte + " (capitaine)");
            builder.CloseElement();
        }
    };

    Skill? _competenceAffichee;
    void OuvrirCompetence(Skill s) => _competenceAffichee = s;
    void FermerCompetence() => _competenceAffichee = null;
}