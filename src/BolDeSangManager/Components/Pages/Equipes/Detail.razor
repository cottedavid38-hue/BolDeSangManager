@page "/equipes/{Id:int}"
@rendermode InteractiveServer
@using BolDeSangManager.Helpers
@inject TeamService TeamService
@inject MatchService MatchService
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_equipe?.Nom ?? "Équipe") — BolDeSang Manager</PageTitle>

@if (_equipe is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else if (_masqueeParBrouillard)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-8" Elevation="2" Style="text-align:center">
            <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Large" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="mt-2">Fiche masquée — mode brouillard</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-4">
                <b>@_equipe.Nom</b> est votre prochain adversaire : son effectif reste caché
                jusqu'à ce que la rencontre soit jouée. C'est le principe du mode brouillard —
                on ne prépare pas un match en étudiant l'équipe d'en face.
            </MudText>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo($"/ligues/{_equipe.LeagueId}"))">
                Retour à la ligue
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Error"><b>@_equipe.Nom</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @_equipe.TeamType?.Nom — @_equipe.TeamType?.Game?.Nom
                | Coach : @DisplayHelpers.NomCoach(_equipe.Coach)
                | Ligue : @_equipe.League?.Nom
            </MudText>
        </div>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @if (_peutEditer)
            {
                <MudButton Href="@($"/equipes/rejoindre?teamId={_equipe.Id}")" Variant="Variant.Outlined" Color="Color.Primary"
                          StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small">
                    Modifier
                </MudButton>
                <MudButton OnClick="ConfirmerSuppression" Variant="Variant.Outlined" Color="Color.Error"
                          StartIcon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small">
                    Supprimer
                </MudButton>
            }
            <MudButton Href="@($"/equipes/ma-feuille?teamId={_equipe.Id}")" Variant="Variant.Outlined" Color="Color.Error"
                      StartIcon="@Icons.Material.Filled.TableChart" Size="Size.Small">
                Feuille PDF
            </MudButton>
        </MudStack>
    </MudStack>

    @* ── Règles spéciales de l'équipe ─────────────────────────────────────
       Toutes les règles de la race, repliées : on touche une règle pour lire
       son effet. « Favori de… » porte en plus la divinité, que seul le
       COMMISSAIRE peut choisir (le livre rend le choix définitif). *@
    @if (_reglesSpeciales.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">Règles spéciales</MudText>
        <MudExpansionPanels Class="mb-4" Elevation="0" Dense="true"
                            Style="border:1px solid var(--mud-palette-lines-default); border-radius:4px">
            @foreach (var lien in _reglesSpeciales)
            {
                var estFavoriDe = lien.SpecialRule.Code == SpecialRuleCodes.FavoriDe;
                <MudExpansionPanel Dense="true">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2"><b>@lien.SpecialRule.Nom</b></MudText>
                            @if (estFavoriDe && !string.IsNullOrEmpty(_equipe.DiviniteChoisie))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                    @_equipe.DiviniteChoisie
                                </MudChip>
                            }
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                            @lien.SpecialRule.Description
                        </MudText>

                        @* Choix de la divinité : réservé au commissaire. *@
                        @if (estFavoriDe && _optionsDivinite.Count > 0)
                        {
                            @if (_estCommissaire && _optionsDivinite.Count > 1)
                            {
                                <MudSelect T="string" Value="@(_equipe.DiviniteChoisie)"
                                           ValueChanged="DefinirDivinite"
                                           Label="Dieu du Chaos" Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Class="mt-3">
                                    <MudSelectItem Value="@("")">— non choisi —</MudSelectItem>
                                    @foreach (var d in _optionsDivinite)
                                    {
                                        <MudSelectItem Value="@d">@d</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (_optionsDivinite.Count == 1 && !string.IsNullOrEmpty(_equipe.DiviniteChoisie))
                            {
                                <MudText Typo="Typo.caption" Class="mt-2 d-block" Color="Color.Secondary">
                                    Imposé par la race.
                                </MudText>
                            }
                            else if (string.IsNullOrEmpty(_equipe.DiviniteChoisie))
                            {
                                <MudText Typo="Typo.caption" Class="mt-2 d-block" Color="Color.Secondary">
                                    Divinité pas encore choisie — le commissaire de la ligue peut la définir.
                                </MudText>
                            }
                        }

                        @* Capitaine : c'est le COACH qui désigne, contrairement
                           au dieu réservé au commissaire. *@
                        @if (lien.SpecialRule.Code == SpecialRuleCodes.CompetenceAuCapitaine)
                        {
                            @if (_estCoach || _estCommissaire)
                            {
                                @* T="string" comme le sélecteur de divinité qui
                                   fonctionne : avec T="int" ou "int?", MudBlazor
                                   ne rendait AUCUN item (popover vide, constaté
                                   à l'écran). "" = aucun capitaine. *@
                                <MudSelect T="string" Value="@(CapitaineActuelId()?.ToString() ?? "")"
                                           ValueChanged="DefinirCapitaine"
                                           Label="Capitaine" Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Class="mt-3"
                                           HelperText="@HelperCapitaine()">
                                    <MudSelectItem Value="@("")">— aucun —</MudSelectItem>
                                    @foreach (var j in JoueursEligiblesCapitaine())
                                    {
                                        <MudSelectItem Value="@j.Id.ToString()">@j.Numero. @j.Nom</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                var cap = _equipe.Joueurs.FirstOrDefault(p => p.EstCapitaine);
                                <MudText Typo="Typo.caption" Class="mt-2 d-block" Color="Color.Secondary">
                                    @(cap is null ? "Aucun capitaine désigné." : $"Capitaine : {cap.Nom}")
                                </MudText>
                            }
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }

    <!-- Statistiques d'équipe -->
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Trésorerie</MudText>
                <MudText Typo="Typo.h6" Color="Color.Success"><b>@_equipe.Tresorerie.ToString("N0") po</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">VEA</MudText>
                <MudText Typo="Typo.h6"><b>@_vea.ToString("N0") po</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Bilan</MudText>
                <MudText Typo="Typo.h6"><b>@_equipe.NombreVictoires V / @_equipe.NombreNuls N / @_equipe.NombreDefaites D</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Points ligue</MudText>
                <MudText Typo="Typo.h6" Color="Color.Error"><b>@_equipe.PointsLigue</b></MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudTabs Elevation="1" Rounded="true" Class="tabs-compact" PanelClass="pt-4">
        <!-- Effectif -->
        <MudTabPanel Text="@($"Effectif ({_equipe.Joueurs.Count(j => !j.EstMort && !j.EstRetraite)})")" Icon="@Icons.Material.Filled.Group">
            <div style="overflow-x:auto">
                <MudTable Items="@_equipe.Joueurs.Where(j => !j.EstMort && !j.EstRetraite).OrderBy(j => j.Numero)" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Nom</MudTh>
                        <MudTh>Poste</MudTh>
                        <MudTh Style="text-align:center">M</MudTh>
                        <MudTh Style="text-align:center">F</MudTh>
                        <MudTh Style="text-align:center">AG</MudTh>
                        <MudTh Style="text-align:center">CP</MudTh>
                        <MudTh Style="text-align:center">AV</MudTh>
                        <MudTh>Compétences</MudTh>
                        <MudTh Style="text-align:center">PSP</MudTh>
                        <MudTh Style="text-align:center">Amél.</MudTh>
                        <MudTh Style="text-align:center">Valeur</MudTh>
                        <MudTh>Statut</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="j">
                        <MudTd DataLabel="N°">@j.Numero</MudTd>
                        <MudTd DataLabel="Nom">
                            @if (_renommageJoueurId == j.Id)
                            {
                                @* Édition en place (#16) : le nom n'entre dans aucun calcul,
                                   donc pas de passage par l'écran de composition — qui, lui,
                                   recrée tout le roster et détruirait PSP et compétences. *@
                                <MudTextField T="string" Value="@_renommageValeur"
                                              ValueChanged="@(v => _renommageValeur = v)"
                                              Immediate="true" AutoFocus="true"
                                              Variant="Variant.Text" Margin="Margin.Dense"
                                              MaxLength="100" Style="min-width:150px"
                                              OnKeyDown="@(e => OnToucheRenommage(e, j.Id))"
                                              OnBlur="@(() => ValiderRenommage(j.Id))" />
                            }
                            else
                            {
                                <b>@j.Nom</b>
                                @if (_estCoach)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Class="ml-1" title="Renommer ce joueur"
                                                   OnClick="@(() => DemarrerRenommage(j))" />
                                }
                            }
                        </MudTd>
                        <MudTd DataLabel="Poste">
                            <div>@j.PlayerPosition?.Nom</div>
                            @if (!string.IsNullOrEmpty(j.PlayerPosition?.MotsCles))
                            {
                                <div style="font-size:10px; color:#9e9e9e; font-style:italic">
                                    @j.PlayerPosition.MotsCles.Replace(",", ", ")
                                </div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Mouvement" Style="@InjuryCellStyle(j.ModMouvement)">@StatInt(j.PlayerPosition?.Mouvement ?? 0, j.ModMouvement)</MudTd>
                        <MudTd DataLabel="Force" Style="@InjuryCellStyle(j.ModForce)">@StatInt(j.PlayerPosition?.Force ?? 0, j.ModForce)</MudTd>
                        <MudTd DataLabel="Agilité" Style="@InjuryCellStyle(j.ModAgilite)">@StatStr(j.PlayerPosition?.Agilite ?? "-", j.ModAgilite, false)</MudTd>
                        <MudTd DataLabel="Passe" Style="@InjuryCellStyle(j.ModCapacitePasse)">@StatStr(j.PlayerPosition?.CapacitePasse ?? "-", j.ModCapacitePasse, false)</MudTd>
                        <MudTd DataLabel="Armure" Style="@InjuryCellStyle(j.ModArmure)">@StatStr(j.PlayerPosition?.Armure ?? "-", j.ModArmure, true)</MudTd>
                        <MudTd DataLabel="Compétences">
                            <MudText Typo="Typo.caption">@CompetencesJoueur(j)</MudText>
                            @if (j.PlayerPosition?.AccesCategories.Any() == true)
                            {
                                <div style="font-size:10px; margin-top:2px">
                                    <span style="color:#90caf9">P:</span> @CategoryAccessHelpers.FormatAcces(j.PlayerPosition.AccesCategories.Where(a => a.EstPrincipale).Select(a => a.SkillCategoryDef))
                                    @if (j.PlayerPosition.AccesCategories.Any(a => !a.EstPrincipale))
                                    {
                                        <span style="color:#ce93d8; margin-left:8px">S:</span> @CategoryAccessHelpers.FormatAcces(j.PlayerPosition.AccesCategories.Where(a => !a.EstPrincipale).Select(a => a.SkillCategoryDef))
                                    }
                                </div>
                            }
                        </MudTd>
                        <MudTd DataLabel="PSP" Style="text-align:center">@j.PointsStarPlayer</MudTd>
                        <MudTd DataLabel="Améliorations" Style="text-align:center">@j.Improvements.Count</MudTd>
                        <MudTd DataLabel="Valeur" Style="text-align:center">@ValeurJoueurCalculator.Calculer(j, ValeurJoueurCalculator.BaremeDe(_equipe)).ToString("N0")</MudTd>
                        <MudTd DataLabel="Statut">
                            @if (j.ManqueSuivantMatch)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">Rate prochain</MudChip>
                            }
                            @if (j.Blessures.Any(b => b.Type == InjuryType.BlessurePersistante))
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">
                                    Séquelles @SeqquellesSummary(j)
                                </MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

            @{
                var absents = _equipe.Joueurs.Where(j => j.EstMort || j.EstRetraite).OrderBy(j => j.Numero).ToList();
            }
            @if (absents.Any())
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-4 mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" Class="mr-1" />
                    Morts &amp; Retraités (@absents.Count)
                </MudText>
                <div style="overflow-x:auto">
                    <MudTable Items="@absents" Dense="true" Elevation="0"
                              Style="opacity:0.55">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Nom</MudTh>
                            <MudTh>Poste</MudTh>
                            <MudTh>Statut</MudTh>
                            <MudTh>Compétences</MudTh>
                            <MudTh Style="text-align:center">Amél.</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="j">
                            <MudTd DataLabel="N°">@j.Numero</MudTd>
                            <MudTd DataLabel="Nom">
                                @if (_renommageJoueurId == j.Id)
                                {
                                    @* Un joueur mort ou retraité reste renommable : c'est de
                                       l'historique (corriger une faute de frappe), pas du jeu. *@
                                    <MudTextField T="string" Value="@_renommageValeur"
                                                  ValueChanged="@(v => _renommageValeur = v)"
                                                  Immediate="true" AutoFocus="true"
                                                  Variant="Variant.Text" Margin="Margin.Dense"
                                                  MaxLength="100" Style="min-width:150px"
                                                  OnKeyDown="@(e => OnToucheRenommage(e, j.Id))"
                                                  OnBlur="@(() => ValiderRenommage(j.Id))" />
                                }
                                else
                                {
                                    <span style="text-decoration:line-through">@j.Nom</span>
                                    @if (j.EstMort)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Dangerous" Color="Color.Error"
                                                 Size="Size.Small" Class="ml-1" title="Mort" />
                                    }
                                    @if (_estCoach)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       Class="ml-1" title="Renommer ce joueur"
                                                       OnClick="@(() => DemarrerRenommage(j))" />
                                    }
                                }
                            </MudTd>
                            <MudTd DataLabel="Poste">@j.PlayerPosition?.Nom</MudTd>
                            <MudTd DataLabel="Statut">
                                @if (j.EstMort)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Mort</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Retraité</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Compétences"><MudText Typo="Typo.caption">@CompetencesJoueur(j)</MudText></MudTd>
                            <MudTd DataLabel="Améliorations" Style="text-align:center">@j.Improvements.Count</MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </MudTabPanel>

        <!-- Staff -->
        <MudTabPanel Text="Staff" Icon="@Icons.Material.Filled.ManageAccounts">
            <MudGrid>
                @foreach (var (label, valeur) in StaffItems())
                {
                    <MudItem xs="6" sm="4" md="2">
                        <MudPaper Elevation="1" Class="pa-3 text-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@label</MudText>
                            <MudText Typo="Typo.h5"><b>@valeur</b></MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <!-- Statistiques -->
        <MudTabPanel Text="Stats" Icon="@Icons.Material.Filled.QueryStats">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-3"><b>Performances d'équipe</b></MudText>
                        @foreach (var (label, valeur, color) in TeamStats())
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                <MudText>@label</MudText>
                                <MudText Color="@color"><b>@valeur</b></MudText>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTable Items="@_equipe.Joueurs.OrderByDescending(j => j.PointsStarPlayer)"
                             Dense="true" Elevation="1">
                        <ToolBarContent>
                            <MudText Typo="Typo.subtitle2"><b>PSP par joueur</b></MudText>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Joueur</MudTh>
                            <MudTh Style="text-align:center">PSP</MudTh>
                            <MudTh Style="text-align:center">Amél.</MudTh>
                            @if (_estCommissaire)
                            {
                                <MudTh Style="text-align:center"></MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate Context="j">
                            <MudTd DataLabel="N°">@j.Numero</MudTd>
                            <MudTd DataLabel="Joueur">@j.Nom</MudTd>
                            <MudTd DataLabel="PSP" Style="text-align:center"><b>@j.PointsStarPlayer</b></MudTd>
                            <MudTd DataLabel="Améliorations" Style="text-align:center">@j.Improvements.Count</MudTd>
                            @if (_estCommissaire)
                            {
                                <MudTd DataLabel="Action" Style="text-align:center">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Small"
                                                   title="Corriger les PSP de ce joueur"
                                                   OnClick="@(() => CorrigerXp(j))" />
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>

    @* Fiche d'une compétence, ouverte au clic sur son nom. Un attribut `title`
       ne répondrait qu'au survol souris : inaccessible au doigt. *@
    @if (_competenceAffichee is { } comp)
    {
        <div class="skill-overlay-backdrop" @onclick="FermerCompetence">
            <div @onclick:stopPropagation="true">
                <MudPaper Class="skill-overlay-card" Elevation="8">
                    <div class="skill-overlay-head">
                        <MudText Typo="Typo.h6"><b>@comp.Nom</b></MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="FermerCompetence" aria-label="Fermer" />
                    </div>
                    @if (comp.EstTrait || comp.EstElite)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                            @(comp.EstTrait ? "Trait" : null)@(comp.EstTrait && comp.EstElite ? " · " : null)@(comp.EstElite ? "Élite" : null)
                        </MudText>
                    }
                    <MudText Typo="Typo.body2" Class="skill-overlay-desc">@comp.Description</MudText>
                    <MudText Typo="Typo.caption" Class="skill-overlay-hint">Touchez à côté pour fermer</MudText>
                </MudPaper>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    Team? _equipe;
    int _vea;
    string _userId = "";
    bool _estCommissaire;

    /// <summary>
    /// Mode brouillard : la fiche du prochain adversaire est masquée, pour que
    /// le coach ne prépare pas sa rencontre en étudiant l'effectif d'en face.
    /// Le contrôle est fait au chargement (serveur), pas seulement à l'affichage.
    /// </summary>
    bool _masqueeParBrouillard;

    /// <summary>Divinités que la race autorise (« Favori de… »). Vide = non concernée.</summary>
    List<string> _optionsDivinite = [];

    // ── Capitaine ───────────────────────────────────────────────────────────

    /// <summary>Vrai si l'utilisateur courant est le coach de cette équipe.</summary>
    bool _estCoach;

    int? CapitaineActuelId() =>
        _equipe?.Joueurs.FirstOrDefault(p => p.EstCapitaine)?.Id;

    /// <summary>Compétence que le titre accorde, telle que paramétrée par race.</summary>
    string? CompetenceDuCapitaine()
    {
        var lien = _equipe?.TeamType?.ReglesSpecialesListe
            .FirstOrDefault(l => l.SpecialRule?.Code == SpecialRuleCodes.CompetenceAuCapitaine);
        var valeurs = SpecialRuleCodes.DecouperOptions(lien?.OptionsChoix);
        return valeurs.Length > 0 ? valeurs[0] : null;
    }

    /// <summary>
    /// Morts et retraités exclus : proposer un joueur absent de l'effectif
    /// n'aurait pas de sens.
    /// </summary>
    IEnumerable<TeamPlayer> JoueursEligiblesCapitaine() =>
        (_equipe?.Joueurs ?? [])
            .Where(p => !p.EstMort && !p.EstRetraite)
            .OrderBy(p => p.Numero);

    async Task DefinirCapitaine(string joueurIdTexte)
    {
        if (_equipe is null) return;
        try
        {
            // Chaîne vide = « aucun » côté écran, null côté service.
            int? joueurId = string.IsNullOrEmpty(joueurIdTexte) ? null : int.Parse(joueurIdTexte);
            await TeamService.DefinirCapitaineAsync(_equipe.Id, joueurId);
            _equipe = await TeamService.GetEquipeAsync(Id);   // relit l'état réel
            var nom = _equipe?.Joueurs.FirstOrDefault(p => p.EstCapitaine)?.Nom;
            Snackbar.Add(nom is null ? "Capitaine retiré" : $"Capitaine : {nom}", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    /// <summary>Aide du sélecteur : rappelle la compétence effectivement offerte.</summary>
    string HelperCapitaine()
    {
        var c = CompetenceDuCapitaine();
        return c is null
            ? "Aucune compétence paramétrée par le commissaire."
            : $"Le joueur désigné gagne « {c} ».";
    }

    /// <summary>Règles spéciales de la race, dans l'ordre d'affichage.</summary>
    List<TeamTypeSpecialRule> _reglesSpeciales =>
        _equipe?.TeamType?.ReglesSpecialesListe
            .Where(l => l.SpecialRule is not null)
            .OrderBy(l => l.SpecialRule.Ordre).ThenBy(l => l.SpecialRule.Nom)
            .ToList() ?? [];

    bool _peutEditer =>
        _equipe is not null
        && _equipe.CoachId == _userId
        && _equipe.League is not null
        && DisplayHelpers.InscriptionOuverte(_equipe.League.Statut, _equipe.League.Format);

    // ── Renommer un joueur (#16) ─────────────────────────────────────────────
    //
    // Volontairement DÉCORRÉLÉ de _peutEditer : celui-ci ouvre l'écran de
    // composition, qui supprime et recrée tout le roster — d'où son verrou en
    // phase Inscription. Un nom n'entre dans aucun calcul, donc il se corrige à
    // tout moment, y compris saison lancée et sur un joueur mort ou retraité.

    /// <summary>Joueur en cours d'édition de nom ; null = aucun.</summary>
    int? _renommageJoueurId;
    string _renommageValeur = "";

    void DemarrerRenommage(TeamPlayer joueur)
    {
        _renommageJoueurId = joueur.Id;
        _renommageValeur   = joueur.Nom;
    }

    /// <summary>Entrée valide, Échap annule — l'attendu sur un champ en place.</summary>
    async Task OnToucheRenommage(KeyboardEventArgs e, int joueurId)
    {
        if (e.Key == "Enter")      await ValiderRenommage(joueurId);
        else if (e.Key == "Escape") _renommageJoueurId = null;
    }

    /// <summary>
    /// Enregistre le nouveau nom. Le service revalide le droit et la longueur :
    /// l'écran propose, il ne fait pas autorité.
    /// </summary>
    async Task ValiderRenommage(int joueurId)
    {
        // OnBlur se déclenche aussi après une validation par Entrée : sans cette
        // garde, le service serait appelé deux fois pour la même saisie.
        if (_renommageJoueurId != joueurId) return;

        var joueur = _equipe?.Joueurs.FirstOrDefault(p => p.Id == joueurId);
        var saisi  = (_renommageValeur ?? "").Trim();
        _renommageJoueurId = null;

        if (joueur is null || saisi == joueur.Nom) return;   // rien à enregistrer

        try
        {
            await TeamService.RenommerJoueurAsync(joueurId, _userId, saisi);

            // Relire l'état réel, comme DefinirCapitaine : le service a pu
            // substituer le numéro de maillot à un nom laissé vide, et c'est
            // cette valeur-là qui doit s'afficher, pas la saisie.
            _equipe = await TeamService.GetEquipeAsync(Id);
            Snackbar.Add("Joueur renommé.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    /// <summary>
    /// Choix du Dieu du Chaos par le commissaire. Le service revalide contre les
    /// options de la race : l'écran ne fait pas autorité.
    /// </summary>
    async Task DefinirDivinite(string divinite)
    {
        if (_equipe is null) return;
        try
        {
            await TeamService.DefinirDiviniteAsync(_equipe.Id, divinite);
            _equipe = await TeamService.GetEquipeAsync(Id);   // relit l'état réel
            Snackbar.Add(
                string.IsNullOrEmpty(divinite) ? "Divinité effacée" : $"Divinité : {divinite}",
                Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

        _equipe = await TeamService.GetEquipeAsync(Id);
        if (_equipe is not null)
        {
            _vea = TeamService.CalculerVEA(_equipe);
            _optionsDivinite = await TeamService.GetOptionsDiviniteAsync(_equipe.TeamTypeId);
        }

        // Correction d'PSP (R4) : réservée au commissaire de la ligue et aux grands commissaires.
        _estCommissaire = authState.User.IsInRole("Commissaire")
                       || authState.User.IsInRole("GrandCommissaire")
                       || authState.User.IsInRole("Admin")
                       || (_equipe?.League?.CommissaireId is { } cid && cid == _userId);

        // Le capitaine est désigné par le COACH de l'équipe (choix produit),
        // contrairement au Dieu du Chaos réservé au commissaire.
        _estCoach = _equipe?.CoachId == _userId;

        // Mode brouillard : masquer la fiche du prochain adversaire.
        if (_equipe?.League is { ModeBrouillard: true } ligue && !_estCommissaire)
        {
            var mesEquipes = (await TeamService.GetEquipesLigueAsync(ligue.Id))
                .Where(e => e.CoachId == _userId)
                .Select(e => e.Id)
                .ToHashSet();

            if (mesEquipes.Count > 0)
            {
                var matchs = await MatchService.GetMatchsLigueAsync(ligue.Id);
                _masqueeParBrouillard = !BrouillardHelpers.PeutVoirFicheEquipe(
                    Id, matchs, mesEquipes, ligue.ModeBrouillard, _estCommissaire);
            }
        }
    }

    async Task CorrigerXp(TeamPlayer joueur)
    {
        var parameters = new DialogParameters<CorrectionPspDialog>
        {
            { x => x.Joueur, joueur },
            { x => x.CommissaireId, _userId }
        };
        var dialog = await DialogService.ShowAsync<CorrectionPspDialog>(
            "Corriger les PSP", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            _equipe = await TeamService.GetEquipeAsync(Id);
            if (_equipe is not null)
                _vea = TeamService.CalculerVEA(_equipe);
            StateHasChanged();
        }
    }

    async Task ConfirmerSuppression()
    {
        if (_equipe is null) return;
        var result = await DialogService.ShowMessageBox(
            "Supprimer l'équipe",
            $"Êtes-vous sûr de vouloir supprimer « {_equipe.Nom} » ? Cette action est irréversible.",
            yesText: "Supprimer", cancelText: "Annuler");
        if (result != true) return;

        try
        {
            await TeamService.SupprimerEquipeAsync(_equipe.Id, _userId);
            Snackbar.Add("Équipe supprimée.", Severity.Success);
            Nav.NavigateTo("/profil");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    static string InjuryCellStyle(int mod) =>
        mod < 0 ? "text-align:center; background-color:rgba(229,57,53,0.18); border-radius:4px" : "text-align:center";

    static string StatInt(int baseVal, int mod) =>
        mod == 0 ? baseVal.ToString() : $"{baseVal + mod} ({(mod > 0 ? "+" : "")}{mod})";

    static string StatStr(string baseVal, int mod, bool plusEstMieux)
    {
        if (baseVal == "-" || mod == 0) return baseVal;
        if (!int.TryParse(baseVal.TrimEnd('+'), out var n)) return baseVal;
        var effective = plusEstMieux ? n + mod : n - mod;
        var sign = (plusEstMieux ? mod : -mod) > 0 ? "+" : "";
        var delta = plusEstMieux ? mod : -mod;
        return $"{effective}+ ({sign}{delta})";
    }

    static string SeqquellesSummary(TeamPlayer j)
    {
        var parts = new List<string>();
        if (j.ModMouvement < 0)     parts.Add($"MA{j.ModMouvement}");
        if (j.ModForce < 0)         parts.Add($"F{j.ModForce}");
        if (j.ModAgilite < 0)       parts.Add($"AG{j.ModAgilite}");
        if (j.ModCapacitePasse < 0) parts.Add($"CP{j.ModCapacitePasse}");
        if (j.ModArmure < 0)        parts.Add($"AV{j.ModArmure}");
        return parts.Count > 0 ? $"({string.Join(", ", parts)})" : "";
    }

    /// <summary>
    /// Noms de compétences cliquables. On n'utilise PAS l'attribut `title` :
    /// il ne répond qu'au survol souris, donc l'explication était inaccessible
    /// sur téléphone — or c'est là que les coaches consultent leur feuille
    /// pendant un tournoi. Un clic ouvre la fiche, comme sur l'écran de choix
    /// de race qui règle déjà le problème de cette façon.
    /// </summary>
    RenderFragment CompetencesJoueur(TeamPlayer j) => builder =>
    {
        var skills = (j.PlayerPosition?.CompetencesDepart.Select(c => c.Skill) ?? [])
            .Concat(j.Competences.Where(c => !c.EstCompetenceDepart).Select(c => c.Skill))
            .Where(s => s is not null)
            .Cast<Skill>()
            .ToList();
        for (int i = 0; i < skills.Count; i++)
        {
            var sk = skills[i];
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "skill-link");
            builder.AddAttribute(2, "onclick",
                EventCallback.Factory.Create<MouseEventArgs>(this, () => OuvrirCompetence(sk)));
            builder.AddContent(3, sk.Nom);
            builder.CloseElement();
            if (i < skills.Count - 1)
                builder.AddMarkupContent(4, ", ");
        }

        // Compétence du capitaine : calculée, jamais stockée — elle suit donc le
        // titre sans nettoyage. Signalée comme telle pour que le coach sache
        // qu'elle disparaîtra s'il change de capitaine.
        var offerte = CapitaineHelper.CompetenceOfferte(j, _equipe?.TeamType);
        if (offerte is not null)
        {
            if (skills.Count > 0) builder.AddMarkupContent(5, ", ");
            builder.OpenElement(6, "span");
            builder.AddAttribute(7, "style", "color:var(--mud-palette-warning)");
            builder.AddAttribute(8, "title", "Accordée par le titre de capitaine");
            builder.AddContent(9, offerte + " (capitaine)");
            builder.CloseElement();
        }
    };

    Skill? _competenceAffichee;
    void OuvrirCompetence(Skill s) => _competenceAffichee = s;
    void FermerCompetence() => _competenceAffichee = null;

    IEnumerable<(string, string)> StaffItems()
    {
        if (_equipe is null) yield break;

        // Boucle sur le staff réellement détenu : un staff créé par l'association
        // (« Chef de bande »…) doit apparaître ici sans modification de code.
        // Repli sur les colonnes historiques pour une équipe pas encore migrée.
        var staff = _equipe.Staff
            .Where(s => s.LeagueStaffType is not null)
            .OrderBy(s => s.LeagueStaffType.Ordre)
            .ThenBy(s => s.LeagueStaffType.Nom)
            .ToList();

        if (staff.Count == 0)
        {
            yield return ("Relances", _equipe.NombreRelances.ToString());
            yield return ("Fans dévoués", _equipe.FansDevoues.ToString());
            yield return ("Coachs ass.", _equipe.NombreCoachsAssistants.ToString());
            yield return ("Cheerleaders", _equipe.NombreCheerleaders.ToString());
            yield return ("Apothicaire", _equipe.Apothicaire ? "Oui" : "Non");
            yield break;
        }

        foreach (var s in staff)
        {
            // Un staff plafonné à 1 est un oui/non, pas un compteur.
            var valeur = s.LeagueStaffType.MaxCreation == 1 && s.LeagueStaffType.MaxLigue == 1
                ? (s.Quantite > 0 ? "Oui" : "Non")
                : s.Quantite.ToString();
            yield return (s.LeagueStaffType.Nom, valeur);
        }
    }

    IEnumerable<(string, string, Color)> TeamStats()
    {
        if (_equipe is null) yield break;
        yield return ("Matchs joués", _equipe.NombreMatchsJoues.ToString(), Color.Default);
        yield return ("Touchdowns marqués", _equipe.TouchdownsMarques.ToString(), Color.Success);
        yield return ("Touchdowns concédés", _equipe.TouchdownsConcedes.ToString(), Color.Error);
        yield return ("Éliminations infligées", _equipe.EliminationsInfligees.ToString(), Color.Warning);
        yield return ("Points de ligue", _equipe.PointsLigue.ToString(), Color.Primary);
    }
