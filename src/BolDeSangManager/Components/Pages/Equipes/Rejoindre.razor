@page "/equipes/rejoindre"
@rendermode InteractiveServer
@attribute [Authorize]
@inject TeamService TeamService
@inject StaffService StaffService
@inject LeagueService LeagueService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@using BolDeSangManager.Helpers

<PageTitle>@(_modeEdition ? "Modifier mon équipe" : "Rejoindre la ligue") — BolDeSang Manager</PageTitle>

<MudText Typo="Typo.h5" Color="Color.Error" Class="mb-4"><b>@(_modeEdition ? "Modifier mon équipe" : "Rejoindre la ligue")</b></MudText>

@if (_chargement)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else if (_ligue is null)
{
    <MudAlert Severity="Severity.Error">
        Ligue introuvable. <MudLink Href="/ligues">Retour aux ligues</MudLink>
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Ligue : <b>@_ligue.Nom</b> | Jeu : <b>@_ligue.Game?.Nom</b> | Budget de départ : <b>@_ligue.BudgetDepart.ToString("N0") po</b>
    </MudText>

    @if (_selectedType is null)
    {
        <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Choisissez votre race / collège</b></MudText>
        @if (!_teamTypes.Any())
        {
            <MudAlert Severity="Severity.Warning">Aucune race disponible pour ce jeu.</MudAlert>
        }
        <MudGrid>
            @foreach (var tt in _teamTypes)
            {
                <MudItem xs="12" sm="6" md="4" Class="d-flex">
                    <MudCard Elevation="1" Style="cursor:pointer; border:1px solid rgba(255,255,255,0.07); transition:border-color .2s; width:100%"
                             @onclick="@(() => SelectionnerType(tt))"
                             @onmouseenter="@(e => { })" @onmouseleave="@(e => { })">
                        <MudCardContent>
                            <MudText Typo="Typo.h6"><b>@tt.Nom</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Relance : @tt.CoutRelance.ToString("N0") po
                            </MudText>
                            @* Catégorie LRB : aide au choix pour un nouveau coach.
                               Masquée tant qu'elle n'est pas renseignée — inutile
                               d'afficher un « à renseigner » côté coach, c'est une
                               tâche d'admin. Infobulle en title HTML : MudTooltip
                               casse le circuit en InteractiveServer. *@
                            @if (!string.IsNullOrEmpty(DisplayHelpers.CategorieLabel(tt.Categorie)))
                            {
                                <div class="mt-1" title="@DisplayHelpers.CategorieDescription(tt.Categorie)">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@DisplayHelpers.CategorieColor(tt.Categorie)">
                                        @DisplayHelpers.CategorieLabel(tt.Categorie)
                                    </MudChip>
                                </div>
                            }
                            @* Règles spéciales du LRB. Le catalogue fait foi ;
                               le texte libre historique n'est montré que si la
                               race n'a encore aucune règle rattachée. *@
                            @if (tt.ReglesSpecialesListe.Any())
                            {
                                <div class="mt-1">
                                    @foreach (var l in tt.ReglesSpecialesListe.OrderBy(x => x.SpecialRule.Ordre))
                                    {
                                        @* Clic plutôt que `title` : au doigt, un survol
                                           n'existe pas. Réutilise le panneau de la page. *@
                                        var regle = l.SpecialRule;
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Class="ma-0 mr-1 skill-link"
                                                 OnClick="@(() => OuvrirRegle(regle))">@regle.Nom</MudChip>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(tt.ReglesSpeciales))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@tt.ReglesSpeciales</MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
            <MudText Typo="Typo.subtitle1"><b>@_selectedType.Nom</b></MudText>
            @if (!_modeEdition)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                          OnClick="@(() => { _selectedType = null; _slots.Clear(); })">
                    ← Changer de race
                </MudButton>
            }
        </MudStack>

        <div class="budget-sticky" style="@_budgetGauge">
            <span class="budget-sticky-label">Budget restant</span>
            <span class="budget-sticky-value@(_budgetNegatif ? " budget-neg" : "")">
                @_budgetRestant.ToString("N0") po
                <span class="budget-sticky-total">/ @_ligue.BudgetDepart.ToString("N0")</span>
            </span>
        </div>

        <MudGrid>
            <!-- Formulaire principal -->
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_nomEquipe" Label="Nom de l'équipe"
                             Variant="Variant.Outlined" Required="true" Class="mb-4"
                             HelperText="Ex: Les Crocs de Nuln" />

                <!-- Effectif -->
                <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Effectif — @_slots.Count joueur(s)</b></MudText>

                @foreach (var slot in _slots.ToList())
                {
                    var idx = _slots.IndexOf(slot) + 1;
                    <MudPaper Elevation="0" Class="pa-2 mb-2" Style="border:1px solid #e0e0e0; border-radius:4px">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.caption" Style="width:20px; color:#999">@idx</MudText>
                            <MudText Typo="Typo.body2" Style="min-width:120px"><b>@slot.PositionNom</b></MudText>
                            <MudTextField @bind-Value="slot.Nom" Placeholder="Nom du joueur"
                                         Variant="Variant.Text" Margin="Margin.Dense" Style="min-width:140px; flex:1" />
                            <MudNumericField @bind-Value="slot.Numero" Min="1" Max="99"
                                           Label="#" Variant="Variant.Text" Margin="Margin.Dense" Style="width:60px" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:70px; text-align:right">
                                @slot.Cout.ToString("N0") po
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                         Color="Color.Error" OnClick="@(() => _slots.Remove(slot))" />
                        </MudStack>
                    </MudPaper>
                }

                @if (!_slots.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Cliquez sur ✚ à droite pour ajouter des joueurs.
                    </MudText>
                }

                <MudDivider Class="my-4" />

                <!-- Staff -->
                <MudText Typo="Typo.subtitle2" Class="mb-3"><b>Staff & Équipement</b></MudText>
                @if (_staffLigue.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Aucun staff n'est proposé dans cette ligue.
                    </MudText>
                }
                <MudGrid Spacing="2">
                    @foreach (var st in _staffLigue)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="int"
                                             Value="@QuantiteStaff(st.Id)"
                                             ValueChanged="@(v => DefinirStaff(st, v))"
                                             Label="@st.Nom"
                                             Min="@st.MinCreation" Max="@st.MaxCreation"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HelperText="@LibelleCoutStaff(st)" />
                            @if (!string.IsNullOrWhiteSpace(st.Description))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Class="d-block mt-1" Style="line-height:1.35">
                                    @st.Description
                                </MudText>
                            }
                        </MudItem>
                    }
                </MudGrid>

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6" Spacing="2">
                    <MudButton Href="@(_modeEdition ? $"/equipes/{TeamId}" : $"/ligues/{_ligue.Id}")" Variant="Variant.Text">Annuler</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                              StartIcon="@Icons.Material.Filled.Save"
                              Disabled="@(_saving || _budgetRestant < 0 || string.IsNullOrWhiteSpace(_nomEquipe) || _slots.Count == 0)"
                              OnClick="Soumettre">
                        @(_saving ? (_modeEdition ? "Enregistrement..." : "Création...") : (_modeEdition ? "Enregistrer" : "Créer l'équipe"))
                    </MudButton>
                </MudStack>
            </MudItem>

            <!-- Panel postes disponibles -->
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Postes disponibles</b></MudText>
                @{
                    var (_cadres, _classiques) = RosterDisplayHelpers.GroupePostesParMotCleLimite(
                        _selectedType.Postes, _selectedType.LimitesMotsCles);
                }
                @foreach (var cadre in _cadres)
                {
                    var countCadre = _slots.Count(s =>
                    {
                        var p = _selectedType.Postes.FirstOrDefault(pp => pp.Id == s.PositionId);
                        return p is not null && RosterDisplayHelpers.PositionAMotCle(p, cadre.MotCle);
                    });
                    <div class="poste-keyword-frame" style="@($"border-color:{cadre.Couleur}; background:{cadre.Couleur}14")">
                        <div class="poste-keyword-header" style="@($"color:{cadre.Couleur}")">
                            <span><b>@cadre.MotCle</b></span>
                            <span>@countCadre/@cadre.Max</span>
                        </div>
                        @foreach (var pos in cadre.Postes)
                        {
                            @PosteCard(pos)
                        }
                    </div>
                }
                @foreach (var pos in _classiques)
                {
                    @PosteCard(pos)
                }
            </MudItem>
        </MudGrid>

        @if (_competenceAffichee is { } comp)
        {
            <div class="skill-overlay-backdrop" @onclick="FermerCompetence">
                <div class="skill-overlay-stop" @onclick="StopProp" @onclick:stopPropagation="true">
                    <MudPaper Class="skill-overlay-card" Elevation="8">
                        <div class="skill-overlay-head">
                            <MudText Typo="Typo.h6"><b>@comp.Nom</b></MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="FermerCompetence" />
                        </div>
                        @if (comp.EstTrait || comp.EstElite)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                @(comp.EstTrait ? "Trait" : null)@(comp.EstTrait && comp.EstElite ? " · " : null)@(comp.EstElite ? "Élite" : null)
                            </MudText>
                        }
                        <MudText Typo="Typo.body2" Class="skill-overlay-desc">@comp.Description</MudText>
                        <MudText Typo="Typo.caption" Class="skill-overlay-hint">Touchez à côté pour fermer</MudText>
                    </MudPaper>
                </div>
            </div>
        }

        @* Même panneau pour une règle spéciale de la race. *@
        @if (_regleAffichee is { } regleAff)
        {
            <div class="skill-overlay-backdrop" @onclick="FermerCompetence">
                <div class="skill-overlay-stop" @onclick="StopProp" @onclick:stopPropagation="true">
                    <MudPaper Class="skill-overlay-card" Elevation="8">
                        <div class="skill-overlay-head">
                            <MudText Typo="Typo.h6"><b>@regleAff.Nom</b></MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           OnClick="FermerCompetence" aria-label="Fermer" />
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                            Règle spéciale d'équipe
                        </MudText>
                        <MudText Typo="Typo.body2" Class="skill-overlay-desc">@regleAff.Description</MudText>
                        <MudText Typo="Typo.caption" Class="skill-overlay-hint">Touchez à côté pour fermer</MudText>
                    </MudPaper>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int LigueId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public int TeamId { get; set; }

    League? _ligue;
    List<TeamType> _teamTypes = [];
    TeamType? _selectedType;
    string _nomEquipe = "";
    readonly List<PlayerSlot> _slots = [];

    /// <summary>Staff proposé par la ligue (copie des règles, ajustée par le commissaire).</summary>
    List<LeagueStaffType> _staffLigue = [];

    /// <summary>Quantités saisies à l'écran, par identifiant de staff de ligue.</summary>
    readonly Dictionary<int, int> _staffQuantites = [];

    bool _saving;
    bool _chargement = true;
    bool _modeEdition;
    string _userId = "";

    bool _estDB => _ligue?.Game?.Type == GameType.DungeonBowl;

    int QuantiteStaff(int staffId) => _staffQuantites.TryGetValue(staffId, out var q) ? q : 0;

    void DefinirStaff(LeagueStaffType staff, int valeur)
    {
        // Les bornes sont déjà posées sur le champ, mais une saisie clavier peut
        // les contourner : on reste dans l'intervalle autorisé à la création.
        _staffQuantites[staff.Id] = Math.Clamp(valeur, staff.MinCreation, staff.MaxCreation);
    }

    /// <summary>
    /// Coût unitaire affiché sous le champ. Le prix des relances vient de la race.
    /// Un minimum inclus est signalé comme offert : il n'entame pas le budget.
    /// </summary>
    string LibelleCoutStaff(LeagueStaffType staff) =>
        $"{StaffService.CoutUnitaire(staff, _selectedType):N0} po"
        + (staff.CoutDepuisTypeEquipe ? " (selon la race)" : "")
        + (staff.MinCreation > 0 ? $" — {staff.MinCreation} inclus, offert" : "");

    // Seul le supplément au-delà du minimum est décompté : le minimum est
    // compris de base dans l'équipe (il compte en revanche dans la VEA).
    int _coutStaff => _staffLigue.Sum(st =>
        StaffService.CoutFactureCreation(st, _selectedType, QuantiteStaff(st.Id)));


    int _budgetRestant => _ligue is null ? 0 :
        _ligue.BudgetDepart
        - _slots.Sum(s => s.Cout)
        - _coutStaff;

    bool _budgetNegatif => _budgetRestant < 0;

    int _budgetPct => _budgetNegatif
        ? 100
        : (_ligue is { BudgetDepart: > 0 }
            ? (int)Math.Round(Math.Clamp((double)_budgetRestant / _ligue.BudgetDepart, 0, 1) * 100)
            : 0);

    string _budgetGauge
    {
        get
        {
            var c = _budgetNegatif ? "var(--mud-palette-error)" : "var(--mud-palette-success)";
            return $"background:linear-gradient(to right,{c} 0%,{c} {_budgetPct}%,rgba(255,255,255,0.06) {_budgetPct}%,rgba(255,255,255,0.06) 100%)";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

        if (TeamId > 0)
        {
            _modeEdition = true;
            var equipe = await TeamService.GetEquipeAsync(TeamId);
            if (equipe is null || equipe.CoachId != _userId
                || equipe.League is null
                || !DisplayHelpers.InscriptionOuverte(equipe.League.Statut, equipe.League.Format))
            {
                Snackbar.Add("Édition impossible : équipe inaccessible ou phase verrouillée.", Severity.Error);
                Nav.NavigateTo(equipe is null ? "/" : $"/equipes/{TeamId}");
                _chargement = false;
                return;
            }

            _ligue = equipe.League;
            LigueId = _ligue!.Id;
            _selectedType = await TeamService.GetTeamTypeAvecPostesAsync(equipe.TeamTypeId);
            _nomEquipe = equipe.Nom;

            // Staff déjà détenu : on repart des quantités réelles.
            _staffLigue = await StaffService.GetStaffLigueAsync(_ligue.Id, actifsSeulement: true);
            foreach (var s in equipe.Staff)
                _staffQuantites[s.LeagueStaffTypeId] = s.Quantite;

            foreach (var j in equipe.Joueurs.Where(j => !j.EstMort && !j.EstRetraite).OrderBy(j => j.Numero))
            {
                _slots.Add(new PlayerSlot
                {
                    PositionId = j.PlayerPositionId,
                    PositionNom = j.PlayerPosition?.Nom ?? "",
                    // Coût d'EMBAUCHE du poste, pas la valeur du joueur : cet
                    // écran refond le roster à partir du budget de départ.
                    Cout = j.PlayerPosition?.Cout
                           ?? ValeurJoueurCalculator.Calculer(j, ValeurJoueurCalculator.BaremeDe(equipe)),
                    Nom = j.Nom,
                    Numero = j.Numero
                });
            }
        }
        else if (LigueId > 0)
        {
            _ligue = await LeagueService.GetLigueAsync(LigueId);
            if (_ligue is not null && _ligue.RulesVersionId != 0)
                _teamTypes = await TeamService.GetTypesEquipesParVersionAsync(_ligue.RulesVersionId);

            if (_ligue is not null)
            {
                _staffLigue = await StaffService.GetStaffLigueAsync(_ligue.Id, actifsSeulement: true);
                // Les minimums imposés par les règles sont pré-remplis : sinon le
                // coach part sur une équipe invalide sans savoir pourquoi.
                foreach (var st in _staffLigue)
                    _staffQuantites[st.Id] = st.MinCreation;
            }
        }

        _chargement = false;
    }

    async Task SelectionnerType(TeamType type)
    {
        _selectedType = await TeamService.GetTeamTypeAvecPostesAsync(type.Id);
        _slots.Clear();
    }

    void AjouterJoueur(PlayerPosition pos)
    {
        var countPoste = _slots.Count(s => s.PositionId == pos.Id);
        if (countPoste >= pos.QuantiteMax)
        {
            Snackbar.Add($"Limite atteinte : maximum {pos.QuantiteMax} {pos.Nom} par équipe.", Severity.Warning);
            return;
        }
        if (DepasseLimiteMotCle(pos))
        {
            var limiteDepassee = _selectedType?.LimitesMotsCles.FirstOrDefault(l =>
                pos.MotsCles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Any(k => k.Trim().Equals(l.MotCle, StringComparison.OrdinalIgnoreCase)));
            Snackbar.Add($"Limite « {limiteDepassee?.MotCle} » atteinte : maximum {limiteDepassee?.Max} joueurs.", Severity.Warning);
            return;
        }
        var nextNum = _slots.Count == 0 ? 1 : Math.Min(_slots.Max(s => s.Numero) + 1, 99);
        _slots.Add(new PlayerSlot
        {
            PositionId = pos.Id,
            PositionNom = pos.Nom,
            Cout = pos.Cout,
            Nom = "",
            Numero = nextNum
        });
    }

    bool DepasseLimiteMotCle(PlayerPosition pos)
    {
        if (_selectedType?.LimitesMotsCles is null || _selectedType.LimitesMotsCles.Count == 0)
            return false;

        var posKeywords = pos.MotsCles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var limite in _selectedType.LimitesMotsCles)
        {
            if (!posKeywords.Contains(limite.MotCle)) continue;
            var count = _slots.Count(s =>
            {
                var p = _selectedType.Postes.FirstOrDefault(pp => pp.Id == s.PositionId);
                if (p is null) return false;
                return p.MotsCles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Any(k => k.Trim().Equals(limite.MotCle, StringComparison.OrdinalIgnoreCase));
            });
            if (count >= limite.Max) return true;
        }
        return false;
    }

    async Task Soumettre()
    {
        if (string.IsNullOrWhiteSpace(_nomEquipe) || _ligue is null || _selectedType is null) return;

        _saving = true;
        try
        {
            var joueurs = _slots.Select(s => (s.PositionId, s.Nom, s.Numero)).ToList();
            Team equipe;

            if (_modeEdition)
            {
                equipe = await TeamService.ModifierEquipeAsync(
                    TeamId, _userId, _nomEquipe, _budgetRestant, _staffQuantites, joueurs);
                Snackbar.Add("Équipe modifiée avec succès !", Severity.Success);
            }
            else
            {
                equipe = await TeamService.CreerEquipeAsync(new Team
                {
                    Nom = _nomEquipe,
                    CoachId = _userId,
                    LeagueId = LigueId,
                    TeamTypeId = _selectedType.Id,
                    Tresorerie = _budgetRestant
                }, joueurs, _staffQuantites);
                Snackbar.Add("Équipe créée avec succès !", Severity.Success);
            }

            Nav.NavigateTo($"/equipes/{equipe.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    Skill? _competenceAffichee;
    void OuvrirCompetence(Skill s) => _competenceAffichee = s;
    void FermerCompetence() { _competenceAffichee = null; _regleAffichee = null; }
    void StopProp() { }

    /// <summary>
    /// Règle spéciale affichée dans le même panneau que les compétences : même
    /// besoin (lire un texte long au doigt), donc même présentation.
    /// </summary>
    SpecialRule? _regleAffichee;
    void OuvrirRegle(SpecialRule r) => _regleAffichee = r;

    // Carte d'un poste (réutilisée dans les cadres de mots-clés et la liste classique).
    RenderFragment<PlayerPosition> PosteCard => pos =>
    @<text>
        @{
            var count = _slots.Count(s => s.PositionId == pos.Id);
            var complet = count >= pos.QuantiteMax || DepasseLimiteMotCle(pos);
            var sansFonds = _budgetRestant < pos.Cout;
        }
        <MudPaper Elevation="0" Class="pa-2 mb-2"
                  Style="@($"border:1px solid {(complet ? "rgba(255,255,255,0.06)" : "rgba(229,57,53,0.35)")}; border-radius:4px; opacity:{(complet ? "0.45" : "1")}")">
            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="1">
                <div style="flex:1; min-width:0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2"><b>@pos.Nom</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @count/@pos.QuantiteMax &nbsp;·&nbsp; @pos.Cout.ToString("N0") po
                        </MudText>
                    </MudStack>
                    @if (!string.IsNullOrEmpty(pos.MotsCles))
                    {
                        <MudText Typo="Typo.caption" Style="font-style:italic; color:#9e9e9e; font-size:10px; display:block; line-height:1.2; margin-bottom:2px">
                            @string.Join(", ", pos.MotsCles.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(k => k.Trim()))
                        </MudText>
                    }
                    <div style="display:grid; grid-template-columns:repeat(5,1fr); text-align:center; margin:4px 0 2px">
                        <span style="font-size:10px; color:#9e9e9e">MOV</span>
                        <span style="font-size:10px; color:#9e9e9e">FOR</span>
                        <span style="font-size:10px; color:#9e9e9e">AGI</span>
                        <span style="font-size:10px; color:#9e9e9e">CP</span>
                        <span style="font-size:10px; color:#9e9e9e">ARM</span>
                        <span style="font-size:12px; font-weight:600">@pos.Mouvement</span>
                        <span style="font-size:12px; font-weight:600">@pos.Force</span>
                        <span style="font-size:12px; font-weight:600">@pos.Agilite</span>
                        <span style="font-size:12px; font-weight:600">@pos.CapacitePasse</span>
                        <span style="font-size:12px; font-weight:600">@pos.Armure</span>
                    </div>
                    @if (pos.CompetencesDepart.Any())
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary">@SkillSpans(pos)</MudText>
                    }
                    <MudStack Row="true" Spacing="1" Class="mt-1" Style="font-size:10px">
                        @if (pos.AccesCategories.Any(a => a.EstPrincipale))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                     Style="height:18px; font-size:10px">P: @CategoryAccessHelpers.FormatAcces(pos.AccesCategories.Where(a => a.EstPrincipale).Select(a => a.SkillCategoryDef))</MudChip>
                        }
                        @if (pos.AccesCategories.Any(a => !a.EstPrincipale))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                     Style="height:18px; font-size:10px">S: @CategoryAccessHelpers.FormatAcces(pos.AccesCategories.Where(a => !a.EstPrincipale).Select(a => a.SkillCategoryDef))</MudChip>
                        }
                    </MudStack>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                               Size="Size.Small"
                               Color="@(!complet && !sansFonds ? Color.Warning : Color.Default)"
                               Disabled="@(complet || sansFonds)"
                               OnClick="@(() => AjouterJoueur(pos))" />
            </MudStack>
        </MudPaper>
    </text>;

    // Compétences de départ cliquables : ouvre l'overlay de détail (tactile, pas de hover).
    RenderFragment<PlayerPosition> SkillSpans => pos =>
    @<text>
        @{
            var skills = pos.CompetencesDepart.Select(c => c.Skill).Where(s => s is not null).Cast<Skill>().ToList();
        }
        @for (int i = 0; i < skills.Count; i++)
        {
            var sk = skills[i];
            <span class="skill-link" @onclick="@(() => OuvrirCompetence(sk))">@sk.Nom</span>@(i < skills.Count - 1 ? ", " : "")
        }
    </text>;

    sealed class PlayerSlot
    {
        public int PositionId { get; set; }
        public string PositionNom { get; set; } = "";
        public int Cout { get; set; }
        public string Nom { get; set; } = "";
        public int Numero { get; set; }
    }
}
